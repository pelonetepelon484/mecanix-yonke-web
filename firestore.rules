rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    function esDuenoDelYonke(yonkeId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId == yonkeId;
    }
    // ---------- Yonke ligero (rol 'yonkeLigero') ----------
    // Registro mínimo que SOLO contesta búsquedas activas de clientes de su estado. Su rol es otro a
    // propósito: todo lo que pide rol 'yonke' (inventario, ventas, ficha, Demanda, talleres, Storage)
    // le queda cerrado sin más, y solo se le abre lo que aparece con este nombre en estas reglas.
    function esYonkeLigero(yonkeId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonkeLigero' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId == yonkeId;
    }
    function yonkesLigerosHabilitados() {
      return exists(/databases/$(database)/documents/config/yonkesLigeros)
        && get(/databases/$(database)/documents/config/yonkesLigeros).data.get('habilitado', false) == true;
    }
    function ligeroActivoDeEseEstado(estado) {
      let usuario = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return request.auth != null
        && exists(usuario)
        && get(usuario).data.rol == 'yonkeLigero'
        && get(/databases/$(database)/documents/yonkes/$(get(usuario).data.yonkeId)).data.activo == true
        && get(/databases/$(database)/documents/yonkes/$(get(usuario).data.yonkeId)).data.estado == estado;
    }
    // ---------- Evidencia de "Sugerir yonke" (evidenciasSugerir) ----------
    // Autorización del yonke, guardada en el mismo lote que la respuesta. Vive aparte del pedido porque
    // este se borra a los 5 días y la evidencia dura 30 (expiraAt, política TTL). Solo el admin la lee.
    function evidenciaDeEstaRespuesta(evidenciaId, coleccion, pedidoId, yonkeId) {
      let e = getAfter(/databases/$(database)/documents/evidenciasSugerir/$(evidenciaId)).data;
      return evidenciaId is string
        && e.coleccion == coleccion
        && e.pedidoId == pedidoId
        && e.yonkeId == yonkeId;
    }
    match /evidenciasSugerir/{evidenciaId} {
      function evidenciaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['coleccion', 'pedidoId', 'busqueda', 'yonkeId', 'yonkeNombre', 'yonkeWhatsapp', 'medio', 'mensaje', 'recibidoAt', 'autorizacionConfirmada', 'adminUid', 'adminEmail', 'creadoAt', 'expiraAt'])
          && d.keys().hasAll(['coleccion', 'pedidoId', 'busqueda', 'yonkeId', 'yonkeNombre', 'yonkeWhatsapp', 'medio', 'mensaje', 'recibidoAt', 'autorizacionConfirmada', 'adminUid', 'adminEmail', 'creadoAt', 'expiraAt'])
          && d.coleccion in ['pedidosClientes', 'solicitudesPiezas']
          && d.pedidoId is string && d.pedidoId.size() >= 1
          && d.yonkeId is string && d.yonkeId.size() >= 1
          && d.busqueda is string && d.busqueda.size() >= 1 && d.busqueda.size() <= 300
          && d.medio in ['whatsapp', 'sms', 'correo', 'otro']
          && d.mensaje is string && d.mensaje.size() >= 1 && d.mensaje.size() <= 2000
          && d.recibidoAt is timestamp && d.recibidoAt <= request.time
          && d.autorizacionConfirmada == true
          && d.adminUid == request.auth.uid
          && d.adminEmail == request.auth.token.get('email', '')
          && d.creadoAt == request.time
          && d.expiraAt is timestamp
          && d.expiraAt >= request.time + duration.value(30, 'd') - duration.value(5, 'm')
          && d.expiraAt <= request.time + duration.value(30, 'd') + duration.value(5, 'm');
      }
      function respuestaDeEstaEvidencia() {
        let d = request.resource.data;
        let r = getAfter(/databases/$(database)/documents/$(d.coleccion)/$(d.pedidoId)/respuestas/$(d.yonkeId)).data;
        return r.evidenciaId == evidenciaId
          && r.creadoPorAdmin == true
          && r.creadoPorAdminUid == request.auth.uid
          && r.yonkeNombre == d.yonkeNombre
          && r.whatsapp == d.yonkeWhatsapp;
      }
      // Reclamación dentro del plazo: quita expiraAt (el borrado automático ya no aplica) y deja motivo.
      function conservacionValida() {
        let d = request.resource.data;
        return resource.data.expiraAt > request.time
          && d.diff(resource.data).affectedKeys().hasOnly(['expiraAt', 'conservadaAt', 'conservadaPorUid', 'motivoConservacion'])
          && !('expiraAt' in d)
          && d.conservadaAt == request.time
          && d.conservadaPorUid == request.auth.uid
          && d.motivoConservacion is string && d.motivoConservacion.size() >= 1 && d.motivoConservacion.size() <= 500;
      }
      allow read: if esAdmin();
      allow create: if esAdmin() && evidenciaValida() && respuestaDeEstaEvidencia();
      allow update: if esAdmin() && conservacionValida();
      // Solo las conservadas por reclamación, ya atendida. Las demás las borra la política TTL.
      allow delete: if esAdmin() && !('expiraAt' in resource.data);
    }
    // ---------- Respuestas retiradas por el admin (retirosRespuestas) ----------
    // Quién quitó qué respuesta, cuándo y por qué, en el mismo lote que el borrado. Vive aparte del
    // pedido, que se borra antes; dura 30 días (expiraAt, política TTL). Nadie la cambia. El servidor
    // la lee para el aviso en el enlace del cliente.
    match /retirosRespuestas/{retiroId} {
      function retiroValido() {
        let d = request.resource.data;
        let respuesta = /databases/$(database)/documents/$(d.coleccion)/$(d.pedidoId)/respuestas/$(d.yonkeId);
        return d.keys().hasOnly(['coleccion', 'pedidoId', 'yonkeId', 'yonkeNombre', 'motivo', 'adminUid', 'adminEmail', 'fecha', 'expiraAt'])
          && d.keys().hasAll(['coleccion', 'pedidoId', 'yonkeId', 'yonkeNombre', 'motivo', 'adminUid', 'adminEmail', 'fecha', 'expiraAt'])
          && d.coleccion in ['pedidosClientes', 'solicitudesPiezas']
          && d.pedidoId is string && d.pedidoId.size() >= 1
          && d.yonkeId is string && d.yonkeId.size() >= 1
          && d.yonkeNombre is string && d.yonkeNombre.size() >= 1 && d.yonkeNombre.size() <= 100
          && d.motivo in ['pidioYonke', 'sinPieza', 'numeroAjeno', 'errorMecanix', 'otro']
          && d.adminUid == request.auth.uid
          && d.adminEmail == request.auth.token.get('email', '')
          && d.fecha == request.time
          && d.expiraAt is timestamp
          && d.expiraAt >= request.time + duration.value(30, 'd') - duration.value(5, 'm')
          && d.expiraAt <= request.time + duration.value(30, 'd') + duration.value(5, 'm')
          && exists(respuesta)
          && !existsAfter(respuesta);
      }
      allow read: if esAdmin() || esServicio();
      allow create: if esAdmin() && retiroValido();
      allow update, delete: if false;
    }
    // ---------- Términos vigentes de yonkes (config/terminosYonkes) ----------
    // Si config/terminosYonkes NO existe, no se exige nada (así se apaga la exigencia). Si existe,
    // la versión aceptada del yonke (aceptacionLegal.version) debe ser su campo version. Un yonke
    // sin aceptacionLegal cuenta como "no aceptado".
    function terminosYonkesRef() {
      return /databases/$(database)/documents/config/terminosYonkes;
    }
    function terminosYonkesVigentes(datosYonke) {
      return !exists(terminosYonkesRef())
        || datosYonke.get('aceptacionLegal', {}).get('version', null) == get(terminosYonkesRef()).data.version;
    }
    function yonkeConTerminosVigentes(yonkeId) {
      return terminosYonkesVigentes(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data);
    }
    // ---------- Límites del plan Básico / Premium (config/planes) ----------
    // Interruptor: solo si config/planes.limitesActivos es exactamente true. Si el documento no
    // existe o vale otra cosa, todo sigue como antes (no se exige Premium en nada).
    // "Premium vigente" = plan 'premium' y (premiumHasta vacío o futuro): misma definición que
    // esPremiumVigente() en src/lib/planes.js (tests/rules/planes.rules.mjs compara ambas).
    function planesRef() {
      return /databases/$(database)/documents/config/planes;
    }
    function limitesPlanesActivos() {
      return exists(planesRef()) && get(planesRef()).data.get('limitesActivos', false) == true;
    }
    function premiumVigente(datosYonke) {
      return datosYonke.get('plan', null) == 'premium'
        && (datosYonke.get('premiumHasta', null) == null
            || datosYonke.premiumHasta == ''
            || datosYonke.premiumHasta > request.time);
    }
    function premiumSiHaceFalta(datosYonke) {
      return !limitesPlanesActivos() || premiumVigente(datosYonke);
    }
    function yonkeConPremiumSiHaceFalta(yonkeId) {
      return !limitesPlanesActivos() || premiumVigente(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data);
    }
    // ---------- NUEVO: pedido de piezas de talleres a yonkes ----------
    // Un yonke "activo de ese estado" para ver/responder solicitudes: mismo campo yonkes/{id}.estado
    // que usa estadoDeYonke() en el cliente (src/lib/estados.js) -- NO el mapeo de 3 letras que usa
    // esYonkeDeEseEstado()/busquedasResumen, que es para otra cosa.
    function yonkeActivoDeEseEstado(estado) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId != null &&
        exists(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)) &&
        get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data.activo == true &&
        get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data.estado == estado;
    }
    // ---------- NUEVO: demanda por estado para el panel del yonke ----------
    // Traduce el slug en español de yonkes/{id}.estado al código de 3 letras que usa
    // busquedasResumen.estadoGeografico -- debe mantenerse sincronizado a mano con
    // src/lib/estadoGeoMapping.ts si se agregan o cambian estados.
    function estadoGeoDe(estado) {
      return {
        'aguascalientes': 'agu', 'baja-california': 'bcn', 'baja-california-sur': 'bcs',
        'campeche': 'cam', 'cdmx': 'cmx', 'chiapas': 'chp', 'chihuahua': 'chh',
        'coahuila': 'coa', 'colima': 'col', 'durango': 'dur', 'estado-de-mexico': 'mex',
        'guanajuato': 'gua', 'guerrero': 'gro', 'hidalgo': 'hid', 'jalisco': 'jal',
        'michoacan': 'mic', 'morelos': 'mor', 'nayarit': 'nay', 'nuevo-leon': 'nle',
        'oaxaca': 'oax', 'puebla': 'pue', 'queretaro': 'que', 'quintana-roo': 'roo',
        'san-luis-potosi': 'slp', 'sinaloa': 'sin', 'sonora': 'son', 'tabasco': 'tab',
        'tamaulipas': 'tam', 'tlaxcala': 'tla', 'veracruz': 'ver', 'yucatan': 'yuc',
        'zacatecas': 'zac',
      }.get(estado, null);
    }
    // Un yonke solo puede leer busquedasResumen de SU propio estado -- nunca de otro, ni aunque
    // arme la query a mano: yonkeId sale de usuarios/{uid} (nunca del cliente) y estado sale de
    // yonkes/{id}, ambos leídos server-side por la propia regla, no por lo que mande el request.
    function esYonkeDeEseEstado(estadoGeografico) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId != null &&
        exists(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)) &&
        estadoGeoDe(get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data.estado) == estadoGeografico;
    }
    // ---------- NUEVO: validación de promociones ----------
    function promoOk(x, yonkeId) {
      return x is map
        && x.keys().hasOnly(['url', 'titulo'])
        && x.url is string
        && x.url.matches('https://firebasestorage\\.googleapis\\.com/.*')
        && x.url.matches('.*branding%2F' + yonkeId + '%2Fpromos%2F.*')
        && x.titulo is string
        && x.titulo.size() <= 60
        && x.titulo.matches('.*\\S.*');
    }
    function promosValidas(p, yonkeId) {
      return p is list
        && p.size() <= 3
        && (p.size() < 1 || promoOk(p[0], yonkeId))
        && (p.size() < 2 || promoOk(p[1], yonkeId))
        && (p.size() < 3 || promoOk(p[2], yonkeId));
    }
    // ---------- NUEVO: validación de "Sobre nosotros" ----------
    function sobreNosotrosValido(s, yonkeId) {
      return s is map
        && s.keys().hasOnly(['texto', 'aniosExperiencia', 'direccion', 'horario', 'fotoUrl'])
        && s.texto is string && s.texto.size() <= 800
        && (!('aniosExperiencia' in s) || s.aniosExperiencia == null || s.aniosExperiencia is int)
        && (!('direccion' in s) || s.direccion is string)
        && (!('horario' in s) || s.horario is string)
        && (!('fotoUrl' in s) || s.fotoUrl == null ||
            (s.fotoUrl is string
             && s.fotoUrl.matches('https://firebasestorage\\.googleapis\\.com/.*')
             && s.fotoUrl.matches('.*branding%2F' + yonkeId + '%2Fsobre-nosotros%2F.*')));
    }
    function sitioValido(x, yonkeId) {
      return x is map
        && x.keys().hasOnly(['sobreNosotros'])
        && sobreNosotrosValido(x.sobreNosotros, yonkeId);
    }
    // ---------- NUEVO: validación de branding (fondo de la página) ----------
    function brandingValido(b, yonkeId) {
      return b == null
        || (b is map
            && (!('fondoUrl' in b) || b.fondoUrl == null
                || (b.fondoUrl is string
                    && b.fondoUrl.matches('https://firebasestorage\\.googleapis\\.com/.*')
                    && b.fondoUrl.matches('.*branding%2F' + yonkeId + '%2Ffondo%2F.*'))));
    }
    // ---------- Logs de búsqueda ----------
    match /busquedas/{docId} {
      allow create: if request.resource.data.keys().hasAll([
                         'textoOriginal', 'estado', 'numResultados', 'origen', 'fecha'
                       ])
                    && request.resource.data.textoOriginal is string
                    && request.resource.data.textoOriginal.size() > 0
                    && request.resource.data.textoOriginal.size() < 300
                    && request.resource.data.estado in [
                         'ok', 'sin_inventario', 'fuera_de_catalogo',
                         'parseo_parcial', 'no_interpretada', 'fuera_de_giro',
                         'numero_de_parte', 'marca_muy_general',
                         'pieza_sin_vehiculo'
                       ]
                    && request.resource.data.numResultados is int
                    && request.resource.data.numResultados >= 0
                    && request.resource.data.origen in ['web', 'whatsapp'];
      allow read, update, delete: if esAdmin();
    }
    // ---------- NUEVO: copia reducida de busquedas para el panel "Demanda" del yonke ----------
    // Solo campos sin datos de clientes ni de competencia (sin textoOriginal, sin yonkeIds) --
    // ver registrarBusqueda.js. El yonke lee esta colección directo desde el navegador; busquedas
    // (la completa) sigue siendo solo-admin arriba.
    match /busquedasResumen/{docId} {
      // alcanceResultado: opcional (registros de antes y versiones viejas de la app no lo mandan).
      allow create: if request.resource.data.keys().hasOnly([
                         'estadoGeografico', 'pieza', 'marca', 'modelo', 'anio',
                         'estado', 'conResultado', 'sinVehiculo', 'fecha', 'alcanceResultado'
                       ])
                    && request.resource.data.estadoGeografico is string
                    && request.resource.data.conResultado is bool
                    && request.resource.data.sinVehiculo is bool
                    && (!('alcanceResultado' in request.resource.data)
                        || request.resource.data.alcanceResultado in ['con_resultado', 'solo_otros_estados', 'sin_resultado']);
      allow read: if esAdmin()
                  || (esYonkeDeEseEstado(resource.data.estadoGeografico)
                      // Demanda es del plan Premium cuando config/planes.limitesActivos es true
                      && yonkeConPremiumSiHaceFalta(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId));
      allow update, delete: if esAdmin();
    }
    // Colecciones viejas: escritura pública (código legado), lectura solo admin
    match /busquedas_no_interpretadas/{docId} {
      allow read: if esAdmin();
      allow write: if true;
    }
    match /modelos_no_reconocidos/{docId} {
      allow read: if esAdmin();
      allow write: if true;
    }
    // Contactos que deja un cliente en una búsqueda sin resultado útil. Los crea /api/buscar
    // (persistirContactoSiExiste), que usa el SDK de cliente SIN sesión: por eso crear queda
    // abierto, pero solo con la forma exacta que manda esa ruta. Nadie más que el admin lee,
    // marca como atendido o borra (antes "allow write: if true" dejaba editar y borrar a cualquiera).
    match /busquedas_pendientes/{docId} {
      function pendienteValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['pieza', 'marca', 'modelo', 'anio', 'textoOriginal', 'estado', 'fecha', 'contacto', 'atendido'])
          && d.keys().hasAll(['textoOriginal', 'estado', 'fecha', 'contacto', 'atendido'])
          && d.textoOriginal is string && d.textoOriginal.size() <= 2000
          && d.estado in [
               'sin_inventario', 'fuera_de_catalogo', 'parseo_parcial', 'no_interpretada', 'fuera_de_giro',
               'numero_de_parte', 'marca_muy_general', 'pieza_sin_vehiculo'
             ]
          && d.fecha is timestamp
          && d.fecha > request.time - duration.value(1, 'h')
          && d.fecha < request.time + duration.value(1, 'h')
          && d.contacto is string && d.contacto.size() >= 1 && d.contacto.size() <= 200
          && d.atendido == false
          && (d.get('pieza', null) == null || (d.pieza is string && d.pieza.size() <= 200))
          && (d.get('marca', null) == null || (d.marca is string && d.marca.size() <= 100))
          && (d.get('modelo', null) == null || (d.modelo is string && d.modelo.size() <= 100))
          && (d.get('anio', null) == null || d.anio is int);
      }
      allow read, update, delete: if esAdmin();
      allow create: if pendienteValido();
    }
    // Contadores del límite de búsquedas por IP (src/app/lib/busqueda/rateLimit.js, también sin
    // sesión). Solo se puede crear un contador nuevo en 1 o sumarle exactamente 1: ya no se puede
    // reiniciar, inflar, borrar ni escribir otros campos. La lectura sigue cerrada como estaba.
    // OJO: con la lectura cerrada, la transacción de rateLimit.js falla (permission-denied) y
    // /api/buscar deja pasar la búsqueda, o sea que el límite NO se aplica. Abrir "get" aquí lo
    // encendería; es una decisión aparte (ver nota en la rama fix/reglas-privacidad).
    match /busqueda_rate_limit/{docId} {
      function contadorValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['count', 'actualizado', 'expiraEn'])
          && d.count is int
          && d.actualizado is timestamp
          && (!('expiraEn' in d) || d.expiraEn is timestamp);
      }
      allow read: if false;
      allow create: if docId.matches('^[0-9a-f]{32}_[0-9]+$')
                    && contadorValido()
                    && request.resource.data.count == 1;
      allow update: if contadorValido()
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
    // ---------- Config ----------
    match /config/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // ---------- Estados (expansión por estado) ----------
    match /estados/{estadoId} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // ---------- Usuarios ----------
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || esAdmin());
      // Alta propia de yonke: solo rol 'yonke', con los 4 campos del registro, y solo si el
      // yonke al que apunta tiene como dueño a este mismo uid (ownerUid lo pone el registro).
      allow create: if esAdmin()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && request.resource.data.rol == 'yonke'
                        && request.resource.data.keys().hasOnly(['rol', 'yonkeId', 'email', 'fechaRegistro'])
                        && get(/databases/$(database)/documents/yonkes/$(request.resource.data.yonkeId)).data.ownerUid == request.auth.uid)
                    // Alta propia de taller: solo rol 'taller', con 4 campos, apuntando a un taller cuyo dueño es este uid
                    || (request.auth != null
                        && request.auth.uid == userId
                        && request.resource.data.rol == 'taller'
                        && request.resource.data.keys().hasOnly(['rol', 'tallerId', 'email', 'fechaRegistro'])
                        && request.resource.data.tallerId is string
                        && get(/databases/$(database)/documents/talleres/$(request.resource.data.tallerId)).data.ownerUid == request.auth.uid)
                    // Alta propia de refaccionaria: solo rol 'refaccionaria', con 4 campos, apuntando a una
                    // refaccionaria cuyo dueño es este uid, y solo con config/refaccionarias.habilitado.
                    || (request.auth != null
                        && request.auth.uid == userId
                        && refaccionariasHabilitadas()
                        && request.resource.data.rol == 'refaccionaria'
                        && request.resource.data.keys().hasOnly(['rol', 'refaccionariaId', 'email', 'fechaRegistro'])
                        && request.resource.data.refaccionariaId is string
                        && get(/databases/$(database)/documents/refaccionarias/$(request.resource.data.refaccionariaId)).data.ownerUid == request.auth.uid);
      // Yonke ligero: solo el servidor lo da de alta, en el mismo guardado que su ficha.
      allow create: if esServicio()
                    && request.resource.data.keys().hasOnly(['rol', 'yonkeId', 'email', 'fechaRegistro'])
                    && request.resource.data.keys().hasAll(['rol', 'yonkeId', 'email', 'fechaRegistro'])
                    && request.resource.data.rol == 'yonkeLigero'
                    && request.resource.data.yonkeId is string
                    && request.resource.data.email is string
                    && request.resource.data.fechaRegistro == request.time
                    && getAfter(/databases/$(database)/documents/yonkes/$(request.resource.data.yonkeId)).data.ownerUid == userId
                    && getAfter(/databases/$(database)/documents/yonkes/$(request.resource.data.yonkeId)).data.tipoRegistro == 'ligero';
      // "Completar mi registro": solo el servidor pasa de ligero a yonke, junto con su ficha ya completa.
      allow update: if esServicio()
                    && resource.data.rol == 'yonkeLigero'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol'])
                    && request.resource.data.rol == 'yonke'
                    && getAfter(/databases/$(database)/documents/yonkes/$(resource.data.yonkeId)).data.ownerUid == userId
                    && getAfter(/databases/$(database)/documents/yonkes/$(resource.data.yonkeId)).data.tipoRegistro == 'completo';
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }
    // ---------- Refaccionarias (cuenta de refaccionaria, separada de yonkes y talleres) ----------
    // Bandera config/refaccionarias.habilitado: sin el documento, sin el campo o con otro valor que
    // no sea true, nadie crea cuentas de refaccionaria. La versión de sus términos y su resumen de
    // cambios también viven ahí (terminosVersion, resumenCambios), separados de yonkes y talleres.
    function configRefaccionariasRef() {
      return /databases/$(database)/documents/config/refaccionarias;
    }
    function refaccionariasHabilitadas() {
      return exists(configRefaccionariasRef()) && get(configRefaccionariasRef()).data.get('habilitado', false) == true;
    }
    function versionRefaccionarias() {
      return get(configRefaccionariasRef()).data.get('terminosVersion', '');
    }
    // Datos públicos del negocio. verificado, pruebaHasta, plan y premiumHasta solo los escribe el
    // admin (sin plan Básico: prueba de 3 meses y después pago); el dueño no los manda al crear ni
    // los cambia al editar. Datos privados en privado/datos.
    match /refaccionarias/{refaccionariaId} {
      // Horario (mismo formato que el de los yonkes): cada día que venga, {abierto, apertura, cierre} en HH:MM.
      function diaHorarioValido(h, dia) {
        return !(dia in h)
          || (h[dia] is map
              && h[dia].keys().hasOnly(['abierto', 'apertura', 'cierre'])
              && h[dia].abierto is bool
              && h[dia].apertura is string && h[dia].apertura.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
              && h[dia].cierre is string && h[dia].cierre.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
      }
      function horarioValido(h) {
        return h is map
          && h.keys().hasOnly(['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo'])
          && diaHorarioValido(h, 'lunes') && diaHorarioValido(h, 'martes') && diaHorarioValido(h, 'miercoles')
          && diaHorarioValido(h, 'jueves') && diaHorarioValido(h, 'viernes') && diaHorarioValido(h, 'sabado')
          && diaHorarioValido(h, 'domingo');
      }
      function refaccionariaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'whatsapp', 'estado', 'ciudad', 'logoUrl', 'zonaEntrega', 'horario', 'slug', 'ownerUid', 'activo', 'verificado', 'pruebaHasta', 'plan', 'premiumHasta', 'creadoAt', 'aceptacionVersion', 'totalPiezas', 'numBloques', 'inventarioActualizadoAt', 'esPrueba'])
          && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 100
          && d.whatsapp is string && d.whatsapp.matches('^[0-9]{10}$')
          && d.estado is string && d.estado.matches('^[a-z0-9-]{2,40}$')
          && d.ciudad is string && d.ciudad.size() >= 2 && d.ciudad.size() <= 100
          && d.logoUrl is string && d.logoUrl.size() <= 500
          && d.slug is string && d.slug.size() >= 3 && d.slug.size() <= 80 && d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && d.aceptacionVersion is string && d.aceptacionVersion.size() <= 40
          && (!('horario' in d) || horarioValido(d.horario))
          && (!('zonaEntrega' in d) || (
            d.zonaEntrega is map
            && d.zonaEntrega.keys().hasOnly(['descripcion', 'municipios'])
            && d.zonaEntrega.get('descripcion', '') is string && d.zonaEntrega.get('descripcion', '').size() <= 300
            && d.zonaEntrega.get('municipios', []) is list && d.zonaEntrega.get('municipios', []).size() <= 30));
      }
      allow read: if true;
      // El admin crea la refaccionaria de prueba (botón en admin/refaccionarias, esPrueba: true).
      allow create: if esAdmin() && request.resource.data.get('esPrueba', false) == true;
      allow create: if request.auth != null
                    && refaccionariasHabilitadas()
                    && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.activo == true
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.aceptacionVersion == ''
                    // Nace sin Verificado, sin prueba y sin plan: la prueba la inicia el admin al activarla.
                    && !('verificado' in request.resource.data)
                    && !('pruebaHasta' in request.resource.data)
                    && !('plan' in request.resource.data)
                    && !('premiumHasta' in request.resource.data)
                    // Ni inventario (lo escribe la carga de la etapa 2) ni la marca de prueba.
                    && !('totalPiezas' in request.resource.data)
                    && !('numBloques' in request.resource.data)
                    && !('inventarioActualizadoAt' in request.resource.data)
                    && !('esPrueba' in request.resource.data)
                    && refaccionariaValida();
      allow update: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.activo == resource.data.activo
                        && request.resource.data.creadoAt == resource.data.creadoAt
                        && request.resource.data.slug == resource.data.slug
                        // Ni su insignia, ni su prueba, ni su plan (solo el admin)
                        && request.resource.data.get('verificado', null) == resource.data.get('verificado', null)
                        && request.resource.data.get('pruebaHasta', null) == resource.data.get('pruebaHasta', null)
                        && request.resource.data.get('plan', null) == resource.data.get('plan', null)
                        && request.resource.data.get('premiumHasta', null) == resource.data.get('premiumHasta', null)
                        // Inventario y marca de prueba: por ahora solo el admin (la etapa 2 abre el inventario al dueño)
                        && request.resource.data.get('totalPiezas', null) == resource.data.get('totalPiezas', null)
                        && request.resource.data.get('numBloques', null) == resource.data.get('numBloques', null)
                        && request.resource.data.get('inventarioActualizadoAt', null) == resource.data.get('inventarioActualizadoAt', null)
                        && request.resource.data.get('esPrueba', null) == resource.data.get('esPrueba', null)
                        && refaccionariaValida()
                        && (
                          request.resource.data.aceptacionVersion == resource.data.aceptacionVersion
                          // O aceptar la versión vigente, con su entrada en el historial en el mismo lote
                          || (request.resource.data.aceptacionVersion == versionRefaccionarias()
                              && request.resource.data.aceptacionVersion != ''
                              && existsAfter(/databases/$(database)/documents/refaccionarias/$(refaccionariaId)/aceptaciones/$(request.resource.data.aceptacionVersion)))
                        ));
      // Dueño: solo borra mientras su usuario no exista (rollback del registro). Admin siempre.
      allow delete: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)));

      function esDuenoRefaccionaria() {
        return request.auth != null
          && getAfter(/databases/$(database)/documents/refaccionarias/$(refaccionariaId)).data.ownerUid == request.auth.uid;
      }
      // Datos privados (por ahora solo el correo): solo el dueño y el admin.
      match /privado/{docId} {
        allow read: if request.auth != null
                    && (esAdmin() || get(/databases/$(database)/documents/refaccionarias/$(refaccionariaId)).data.ownerUid == request.auth.uid);
        allow create, update: if docId == 'datos'
                              && (esAdmin() || esDuenoRefaccionaria())
                              && request.resource.data.keys().hasOnly(['email'])
                              && request.resource.data.email is string
                              && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 200;
        allow delete: if esAdmin()
                      || (request.auth != null
                          && get(/databases/$(database)/documents/refaccionarias/$(refaccionariaId)).data.ownerUid == request.auth.uid
                          && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)));
      }
      // Historial de aceptaciones: una entrada por versión. Nadie la modifica; solo el admin la borra.
      match /aceptaciones/{version} {
        allow read: if request.auth != null
                    && (esAdmin() || get(/databases/$(database)/documents/refaccionarias/$(refaccionariaId)).data.ownerUid == request.auth.uid);
        allow create: if request.auth != null
                      && get(/databases/$(database)/documents/refaccionarias/$(refaccionariaId)).data.ownerUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['version', 'fecha'])
                      && request.resource.data.version == version
                      && version != ''
                      && version == versionRefaccionarias()
                      && request.resource.data.fecha == request.time;
        allow update: if false;
        allow delete: if esAdmin();
      }
      // Inventario por bloques (hasta 1,000 piezas cada uno, numerados desde 0). Lectura pública:
      // la página /refaccionarias/[slug] lo lee sin sesión. Por ahora solo escribe el admin (la
      // refaccionaria de prueba); la carga del dueño llega en la etapa 2.
      match /bloques/{numero} {
        allow read: if true;
        allow create, update: if esAdmin()
                              && numero.matches('^[0-9]{1,3}$')
                              && request.resource.data.keys().hasOnly(['piezas'])
                              && request.resource.data.piezas is list
                              && request.resource.data.piezas.size() <= 1000;
        allow delete: if esAdmin();
      }
      // Índice del buscador "Piezas nuevas" (etapa 4): hasta 5,000 piezas por documento en un solo
      // texto `entradas` (número normalizado, palabras, precio y posición). Lectura pública, como los
      // bloques (lo lee el servidor sin sesión). Por ahora solo escribe el admin (la refaccionaria de
      // prueba); la carga del dueño (etapa 2) lo escribirá junto con sus bloques.
      match /busqueda/{numero} {
        allow read: if true;
        allow create, update: if esAdmin()
                              && numero.matches('^[0-9]{1,3}$')
                              && request.resource.data.keys().hasOnly(['entradas'])
                              && request.resource.data.entradas is string
                              && request.resource.data.entradas.size() <= 950000;
        allow delete: if esAdmin();
      }
      // Contador de toques al botón de WhatsApp, uno por mes (AAAA-MM). Mismo patrón que
      // contactosVehiculo: crear con clics 1 y sumar exactamente 1; lo leen el dueño y el admin.
      match /contactos/{mes} {
        allow read: if request.auth != null
                    && (esAdmin() || get(/databases/$(database)/documents/refaccionarias/$(refaccionariaId)).data.ownerUid == request.auth.uid);
        allow create: if mes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                      && exists(/databases/$(database)/documents/refaccionarias/$(refaccionariaId))
                      && request.resource.data.keys().hasOnly(['clics'])
                      && request.resource.data.clics == 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clics'])
                      && request.resource.data.clics == resource.data.clics + 1;
        allow delete: if esAdmin();
      }
    }

    // ---------- Asistencia vial (etapa 1: directorio, solo el admin da de alta) ----------
    // El público solo lee proveedores activos (la página consulta con where activo == true). Lo
    // privado (notas, documentos revisados, contacto del dueño) va aparte en privado/datos, solo
    // admin. Ver src/lib/asistenciaVial.js.
    match /asistenciaVial/{proveedorId} {
      function proveedorValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'servicios', 'tiposGrua', 'ciudades', 'atiende24h', 'horario', 'telefono', 'whatsapp', 'descripcion', 'logoUrl', 'activo', 'documentosEnRegla', 'fechaRevisionDocumentos', 'creadoAt', 'actualizadoAt'])
          && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 100
          && d.servicios is list && d.servicios.size() >= 1 && d.servicios.size() <= 7
          && d.servicios.hasOnly(['grua', 'llantera', 'paso_de_corriente', 'cambio_de_llanta', 'gasolina', 'cerrajeria_automotriz', 'otro'])
          && d.get('tiposGrua', []) is list && d.get('tiposGrua', []).size() <= 10
          && d.ciudades is list && d.ciudades.size() >= 1 && d.ciudades.size() <= 30
          && d.atiende24h is bool
          && d.get('horario', '') is string && d.get('horario', '').size() <= 150
          && d.telefono is string && d.telefono.matches('^[0-9]{10}$')
          && d.get('whatsapp', '') is string && (d.get('whatsapp', '') == '' || d.get('whatsapp', '').matches('^[0-9]{10}$'))
          && d.get('descripcion', '') is string && d.get('descripcion', '').size() <= 300
          && d.get('logoUrl', '') is string && d.get('logoUrl', '').size() <= 500
          && d.activo is bool
          && d.documentosEnRegla is bool
          && (d.get('fechaRevisionDocumentos', null) == null || d.get('fechaRevisionDocumentos', null) is timestamp);
      }
      allow get, list: if resource.data.activo == true || esAdmin();
      allow create, update: if esAdmin() && proveedorValido();
      allow delete: if esAdmin();

      match /privado/{docId} {
        allow read: if esAdmin();
        allow create, update: if esAdmin()
                              && docId == 'datos'
                              && request.resource.data.keys().hasOnly(['notasInternas', 'documentosRevisados', 'contactoDueno'])
                              && request.resource.data.get('notasInternas', '') is string && request.resource.data.get('notasInternas', '').size() <= 2000
                              && request.resource.data.get('documentosRevisados', '') is string && request.resource.data.get('documentosRevisados', '').size() <= 2000
                              && request.resource.data.get('contactoDueno', '') is string && request.resource.data.get('contactoDueno', '').size() <= 300;
        allow delete: if esAdmin();
      }

      // Toques en "Llamar" y "WhatsApp", uno por mes (AAAA-MM). Mismo patrón que el de
      // refaccionarias: cada toque suma exactamente 1 a UNO de los dos; solo de proveedores activos;
      // no guarda nada de quien toca. Lo lee solo el admin.
      match /contactos/{mes} {
        function proveedorActivo() {
          return get(/databases/$(database)/documents/asistenciaVial/$(proveedorId)).data.get('activo', false) == true;
        }
        allow read: if esAdmin();
        allow create: if mes.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
                      && exists(/databases/$(database)/documents/asistenciaVial/$(proveedorId))
                      && proveedorActivo()
                      && ((request.resource.data.keys().hasOnly(['llamadas']) && request.resource.data.llamadas == 1)
                          || (request.resource.data.keys().hasOnly(['whatsapp']) && request.resource.data.whatsapp == 1));
        allow update: if proveedorActivo()
                      && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['llamadas'])
                           && request.resource.data.llamadas == resource.data.get('llamadas', 0) + 1)
                          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsapp'])
                           && request.resource.data.whatsapp == resource.data.get('whatsapp', 0) + 1));
        allow delete: if esAdmin();
      }
    }

    // ---------- Asistencia vial, etapa 2: "Estoy aquí" y mapa ----------
    // checkinsAsistencia/{huella}: enlace privado de cada proveedor. huella = SHA-256 (hex) del
    // secreto del enlace; el secreto no se guarda en ningún lado. Solo el admin crea, ve y borra
    // (para desactivar un enlace). Nunca se edita: un enlace nuevo = otro documento.
    match /checkinsAsistencia/{huella} {
      // El usuario de servicio del servidor (esServicio) solo lo lee uno por uno (con la huella
      // del enlace que recibió) y solo con la bandera del mapa: nunca lista.
      allow read: if esAdmin();
      allow get: if esServicio() && mapaAsistenciaEncendido();
      allow create: if esAdmin()
                    && huella.matches('^[0-9a-f]{64}$')
                    && request.resource.data.keys().hasOnly(['proveedorId', 'creadoAt'])
                    && request.resource.data.keys().hasAll(['proveedorId', 'creadoAt'])
                    && request.resource.data.proveedorId is string
                    && exists(/databases/$(database)/documents/asistenciaVial/$(request.resource.data.proveedorId))
                    && request.resource.data.creadoAt == request.time;
      allow delete: if esAdmin();
    }

    // ubicacionesAsistencia/{proveedorId}: ubicación REDONDEADA (~300 m) y la hora hasta la que
    // el proveedor dijo que estará ahí. La escribe SOLO el usuario de servicio del servidor
    // (api/asistencia-vial/aqui, después de revisar el enlace): desde la app nadie más la crea ni
    // la edita. Se lee solo con config/portada.asistenciaVialMapa == true (apagada, nadie la ve
    // salvo el admin). El admin y el servidor ("Ya me fui") pueden borrarla.
    function mapaAsistenciaEncendido() {
      return get(/databases/$(database)/documents/config/portada).data.get('asistenciaVialMapa', false) == true;
    }
    match /ubicacionesAsistencia/{proveedorId} {
      function ubicacionValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['lat', 'lng', 'hastaAt', 'actualizadoAt'])
          && d.keys().hasAll(['lat', 'lng', 'hastaAt', 'actualizadoAt'])
          && d.lat is number && d.lat >= 28.0 && d.lat <= 32.8
          && d.lng is number && d.lng >= -117.3 && d.lng <= -112.5
          && d.actualizadoAt == request.time
          && d.hastaAt is timestamp
          && d.hastaAt > request.time
          && d.hastaAt <= request.time + duration.value(181, 'm');
      }
      allow read: if esAdmin() || mapaAsistenciaEncendido();
      allow create, update: if esServicio()
                            && mapaAsistenciaEncendido()
                            && get(/databases/$(database)/documents/asistenciaVial/$(proveedorId)).data.get('activo', false) == true
                            && ubicacionValida();
      allow delete: if esAdmin() || esServicio();
    }

    // ---------- Talleres (cuenta de taller, separada de yonkes) ----------
    // Un taller nace SIN aceptar (aceptacionVersion vacía). Su primera aceptación se registra
    // justo después, en un lote con su entrada del historial.
    match /talleres/{tallerId} {
      // plan / premiumHasta: Premium del taller (mismo esquema que los yonkes, ver premiumVigente).
      // premiumOrigen: de dónde vino el Premium ('promo' = promoción de registro, 'admin' = asignado
      // a mano). Los escribe el ADMIN, o el usuario de servicio SOLO para la promoción (ver
      // promoPremiumGratisOk): el dueño no los manda al crear ni los cambia al editar.
      function tallerValido() {
        return request.resource.data.keys().hasOnly(['nombre', 'whatsapp', 'ciudad', 'logoUrl', 'ownerUid', 'activo', 'creadoAt', 'aceptacionVersion', 'avisoPrivacidad', 'plan', 'premiumHasta', 'premiumOrigen'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 100
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.matches('^[0-9]{10}$')
          && request.resource.data.ciudad is string
          && request.resource.data.ciudad.size() >= 2 && request.resource.data.ciudad.size() <= 100
          && request.resource.data.logoUrl is string
          && request.resource.data.aceptacionVersion is string
          && request.resource.data.aceptacionVersion.size() <= 40
          && request.resource.data.avisoPrivacidad is map
          && request.resource.data.avisoPrivacidad.keys().hasOnly(['modo', 'versionPlantilla', 'fecha'])
          && request.resource.data.avisoPrivacidad.modo == 'generado'
          && request.resource.data.avisoPrivacidad.versionPlantilla is string
          && request.resource.data.avisoPrivacidad.versionPlantilla.size() <= 40
          && request.resource.data.avisoPrivacidad.fecha is timestamp;
      }
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || esAdmin());
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.activo == true
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.aceptacionVersion == ''
                    && request.resource.data.avisoPrivacidad.versionPlantilla == get(/databases/$(database)/documents/config/cotizaciones).data.avisoTallerVersion
                    && request.resource.data.avisoPrivacidad.fecha == request.time
                    // Un taller nuevo nace sin plan (= Básico).
                    && !('plan' in request.resource.data)
                    && !('premiumHasta' in request.resource.data)
                    && !('premiumOrigen' in request.resource.data)
                    && tallerValido();
      // Promoción "Premium gratis al registrarte" (config/talleres): SOLO el usuario de servicio
      // (ruta /api/talleres/premium-gratis), con la bandera encendida, a un taller que todavía no
      // tiene plan, dentro de la primera hora desde su creadoAt (hora del servidor), cambiando
      // únicamente plan, premiumHasta y premiumOrigen. premiumHasta SIEMPRE es una fecha (nunca
      // vacía = "sin vencimiento"), futura y a más tardar creadoAt + meses x 31 días. Sin
      // config/talleres, get() falla y se niega (falla cerrada).
      function promoPremiumGratisOk() {
        let c = get(/databases/$(database)/documents/config/talleres).data;
        let meses = c.get('mesesPremiumGratis', 3);
        let d = request.resource.data;
        return esServicio()
          && c.get('premiumGratisHabilitado', false) == true
          && meses is int && meses >= 1 && meses <= 12
          && !('plan' in resource.data)
          && !('premiumHasta' in resource.data)
          && !('premiumOrigen' in resource.data)
          && resource.data.creadoAt is timestamp
          && request.time < resource.data.creadoAt + duration.value(1, 'h')
          && d.diff(resource.data).affectedKeys().hasOnly(['plan', 'premiumHasta', 'premiumOrigen'])
          && d.plan == 'premium'
          && d.premiumOrigen == 'promo'
          && d.premiumHasta is timestamp
          && d.premiumHasta > request.time
          && d.premiumHasta <= resource.data.creadoAt + duration.value(meses * 31, 'd');
      }
      // La promoción va al final: el dueño y el admin no pagan la lectura de config/talleres.
      allow update: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.activo == resource.data.activo
                        && request.resource.data.creadoAt == resource.data.creadoAt
                        // El dueño NO puede cambiar su aviso de privacidad
                        && request.resource.data.avisoPrivacidad == resource.data.avisoPrivacidad
                        // Ni su plan (solo el admin)
                        && request.resource.data.get('plan', null) == resource.data.get('plan', null)
                        && request.resource.data.get('premiumHasta', null) == resource.data.get('premiumHasta', null)
                        && request.resource.data.get('premiumOrigen', null) == resource.data.get('premiumOrigen', null)
                        && tallerValido()
                        && (
                          // Sin cambio de versión aceptada
                          request.resource.data.aceptacionVersion == resource.data.aceptacionVersion
                          // O aceptar la versión vigente, con su entrada en el historial en el mismo lote
                          || (request.resource.data.aceptacionVersion == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
                              && existsAfter(/databases/$(database)/documents/talleres/$(tallerId)/aceptaciones/$(request.resource.data.aceptacionVersion)))
                        ))
                    || promoPremiumGratisOk();
      // Dueño: solo borra mientras su usuario no exista (rollback). Admin siempre.
      allow delete: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)));

      // Historial de aceptaciones: una entrada por versión. Nadie la modifica ni la borra desde las reglas.
      match /aceptaciones/{version} {
        allow read: if request.auth != null
                    && (esAdmin() || get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid);
        allow create: if request.auth != null
                      && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['version', 'fecha'])
                      && request.resource.data.version == version
                      && version == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
                      && request.resource.data.fecha == request.time;
        allow update: if false;
        allow delete: if esAdmin();
      }
    }

    // ---------- Cotizaciones del taller (subcolección de cada taller) ----------
    // Cotización = datos y total en centavos. Renglones = subcolección 0..19.
    // Retención: expiraAt = creadoAt + 88 días (fijado por el sistema, no cambia).
    // Config: config/cotizaciones (versión de términos y bandera de datos del cliente).
    // Si ese documento no existe, get() falla y la regla DENIEGA crear y editar.
    match /talleres/{tallerId}/cotizaciones/{cotizacionId} {
      function esDuenoDelTaller() {
        return request.auth != null
          && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid;
      }
      function tallerActivoDeDueno() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        return request.auth != null && t.ownerUid == request.auth.uid && t.activo == true;
      }
      function versionVigente() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        let c = get(/databases/$(database)/documents/config/cotizaciones).data;
        return t.aceptacionVersion == c.terminosVersion;
      }
      // Datos del cliente solo si la bandera está encendida; si no, cliente vacío y sin placas
      function datosClienteOk() {
        let c = get(/databases/$(database)/documents/config/cotizaciones).data;
        let d = request.resource.data;
        return c.datosClienteHabilitados == true
          || (d.cliente == {} && !('placas' in d.vehiculo));
      }
      function cotizacionValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tallerId', 'estado', 'archivada', 'cliente', 'vehiculo', 'observaciones', 'vigenciaDias', 'totalCentavos', 'numRenglones', 'creadoAt', 'actualizadoAt', 'expiraAt', 'avisoVersion'])
          && d.tallerId == tallerId
          && d.estado in ['borrador', 'enviada', 'cerrada']
          && d.archivada is bool
          && d.cliente is map
          && d.cliente.keys().hasOnly(['nombre', 'telefono'])
          && (!('nombre' in d.cliente) || (d.cliente.nombre is string && d.cliente.nombre.size() <= 100))
          && (!('telefono' in d.cliente) || (d.cliente.telefono is string && d.cliente.telefono.matches('^[0-9 +()-]{0,20}$')))
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'placas', 'kilometraje'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && (!('placas' in d.vehiculo) || (d.vehiculo.placas is string && d.vehiculo.placas.size() <= 12))
          && (!('kilometraje' in d.vehiculo) || (d.vehiculo.kilometraje is int && d.vehiculo.kilometraje >= 0 && d.vehiculo.kilometraje <= 2000000))
          && d.numRenglones is int && d.numRenglones >= 1 && d.numRenglones <= 20
          && d.totalCentavos is int && d.totalCentavos >= 0 && d.totalCentavos <= 2000000000
          && d.observaciones is string && d.observaciones.size() <= 1000
          && d.vigenciaDias is int && d.vigenciaDias >= 1 && d.vigenciaDias <= 60
          && d.expiraAt is timestamp
          && d.avisoVersion is string && d.avisoVersion.size() <= 40
          && datosClienteOk();
      }

      allow read: if esAdmin() || esDuenoDelTaller();

      allow create: if tallerActivoDeDueno()
                    && versionVigente()
                    && cotizacionId.matches('^[A-Z0-9-]{8,20}$')
                    && cotizacionValida()
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.actualizadoAt == request.time
                    && request.resource.data.expiraAt - request.time >= duration.value(88, 'd') - duration.value(5, 'm')
                    && request.resource.data.expiraAt - request.time <= duration.value(88, 'd') + duration.value(5, 'm')
                    && request.resource.data.avisoVersion == get(/databases/$(database)/documents/talleres/$(tallerId)).data.avisoPrivacidad.versionPlantilla;

      allow update: if (
                        // A) "Quitar datos del cliente": dueño ACTIVO y con términos VIGENTES (decisión del
                        //    abogado: sin términos vigentes solo se ve, reimprime y descarga). SOLO vaciar
                        //    cliente y quitar placas; aunque la cotización esté vencida.
                        (tallerActivoDeDueno()
                         && versionVigente()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente', 'vehiculo', 'actualizadoAt'])
                         && request.resource.data.cliente == {}
                         && request.resource.data.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'kilometraje'])
                         && request.resource.data.vehiculo.marca == resource.data.vehiculo.marca
                         && request.resource.data.vehiculo.modelo == resource.data.vehiculo.modelo
                         && request.resource.data.vehiculo.anio == resource.data.vehiculo.anio
                         && request.resource.data.vehiculo.get('kilometraje', null) == resource.data.vehiculo.get('kilometraje', null)
                         && request.resource.data.tallerId == resource.data.tallerId
                         && request.resource.data.estado == resource.data.estado
                         && request.resource.data.archivada == resource.data.archivada
                         && request.resource.data.totalCentavos == resource.data.totalCentavos
                         && request.resource.data.numRenglones == resource.data.numRenglones
                         && request.resource.data.creadoAt == resource.data.creadoAt
                         && request.resource.data.expiraAt == resource.data.expiraAt
                         && request.resource.data.avisoVersion == resource.data.avisoVersion
                         && request.resource.data.actualizadoAt == request.time)
                        // B) EDICIÓN NORMAL: taller activo, versión vigente, cotización no vencida
                        || (tallerActivoDeDueno()
                            && versionVigente()
                            && cotizacionValida()
                            && resource.data.expiraAt > request.time
                            && request.resource.data.creadoAt == resource.data.creadoAt
                            && request.resource.data.expiraAt == resource.data.expiraAt
                            && request.resource.data.avisoVersion == resource.data.avisoVersion
                            && request.resource.data.actualizadoAt == request.time)
                      );

      // Borrar la cotización completa (primero sus renglones): admin, o el dueño con taller activo y
      // términos vigentes (sin términos vigentes solo se ve, reimprime y descarga).
      allow delete: if esAdmin()
                    || (tallerActivoDeDueno() && versionVigente());

      match /renglones/{numero} {
        // Cotización padre tal como quedará después del lote (getAfter)
        function padre() {
          return getAfter(/databases/$(database)/documents/talleres/$(tallerId)/cotizaciones/$(cotizacionId)).data;
        }
        function renglonValido() {
          let r = request.resource.data;
          return r.keys().hasOnly(['tipo', 'descripcion', 'cantidad', 'precioUnitario', 'expiraAt'])
            && r.tipo in ['pieza', 'manoObra']
            && r.descripcion is string && r.descripcion.size() >= 1 && r.descripcion.size() <= 200
            && r.cantidad is int && r.cantidad >= 1 && r.cantidad <= 999
            && (r.precioUnitario is int || r.precioUnitario is float)
            && r.precioUnitario >= 0 && r.precioUnitario <= 1000000
            && r.expiraAt is timestamp;
        }

        allow read: if esAdmin() || esDuenoDelTaller();

        allow create: if tallerActivoDeDueno()
                      && versionVigente()
                      && numero.matches('^([0-9]|1[0-9])$')
                      && renglonValido()
                      && padre().expiraAt > request.time
                      && request.resource.data.expiraAt == padre().expiraAt;

        allow update: if tallerActivoDeDueno()
                      && versionVigente()
                      && numero.matches('^([0-9]|1[0-9])$')
                      && renglonValido()
                      && resource.data.expiraAt > request.time
                      && request.resource.data.expiraAt == resource.data.expiraAt
                      && request.resource.data.expiraAt == padre().expiraAt;

        // Quitar renglones (al editar o al eliminar la cotización) exige taller activo y términos
        // vigentes; el admin siempre puede
        allow delete: if esAdmin()
                      || (tallerActivoDeDueno() && versionVigente());
      }
    }

    // ---------- Seguimiento público de órdenes: funciones compartidas ----------
    // Versiones del aviso de la orden que SÍ informan al cliente del enlace de seguimiento. Solo las
    // órdenes creadas con una de estas versiones pueden tener enlace (y llevan primeraEntregaAt).
    // Debe coincidir con las versiones marcadas "seguimiento": true en textosLegalesTalleres.json
    // (lo revisa una prueba). Al publicar una versión nueva del aviso, agregarla aquí.
    function avisosConSeguimiento() {
      return ['aviso-orden-3'];
    }
    // seguimientos/{huella}: huella = SHA-256 (hex, minúsculas) del token que vive en la orden.
    function refSeguimiento(token) {
      return /databases/$(database)/documents/seguimientos/$(hashing.sha256(token).toHexString().lower());
    }

    // ---------- Órdenes de servicio del taller (etapa 1) ----------
    // talleres/{tallerId}/ordenes/{folio}: trabajos y piezas DENTRO de la orden (máximo 20 de cada uno).
    // Bandera: config/ordenes { habilitado, datosClienteHabilitados, avisoOrdenVersion }. Sin ese
    // documento, get() falla y la regla DENIEGA crear y editar (falla cerrada).
    // Términos vigentes: la misma versión de siempre (config/cotizaciones.terminosVersion).
    // Borrado (TTL sobre expiraAt), con margen de 5 min por el reloj del celular:
    //  - sin entregar: expiraAt = hora del guardado + 88 días (se recalcula en cada guardado);
    //  - al entregar: fechaEntrega = hora del servidor y expiraAt = fechaEntrega + garantiaDias + 8 días;
    //  - ya entregada: fechaEntrega no cambia; expiraAt tampoco, salvo que cambie garantiaDias.
    match /talleres/{tallerId}/ordenes/{ordenId} {
      function esDuenoDelTaller() {
        return request.auth != null
          && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid;
      }
      function tallerActivoDeDueno() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        return request.auth != null && t.ownerUid == request.auth.uid && t.activo == true;
      }
      function versionVigente() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        let c = get(/databases/$(database)/documents/config/cotizaciones).data;
        return t.aceptacionVersion == c.terminosVersion;
      }
      function ordenesHabilitadas() {
        return get(/databases/$(database)/documents/config/ordenes).data.habilitado == true;
      }
      // Candado Premium: solo con config/ordenes.requierePremium == true se exige Premium vigente
      // para CREAR y EDITAR. Sin el campo (o con otro valor), como siempre. Ver, quitar datos del
      // cliente y borrar NO lo piden. Mismos documentos que ya se leen (sin lecturas extra).
      function premiumOrdenesOk() {
        return get(/databases/$(database)/documents/config/ordenes).data.get('requierePremium', false) != true
          || premiumVigente(get(/databases/$(database)/documents/talleres/$(tallerId)).data);
      }
      // Datos del cliente solo si la bandera está encendida Y la orden tiene la versión de aviso
      // vigente (config/ordenes.avisoOrdenVersion) o, si ya existía, una versión anterior con aviso
      // (avisosOrdenAnteriores). Las órdenes sin aviso entregado (p. ej. aviso-orden-0) nunca pueden
      // llevar nombre, teléfono ni placas. Si no, cliente vacío y sin placas.
      // Versiones ANTERIORES del aviso de la orden que sí tenían aviso entregado al cliente (su texto
      // sigue en textosLegalesTalleres.json -> avisosOrden). Una orden que ya existe con una de estas
      // versiones CONSERVA el permiso de datos del cliente aunque config/ordenes.avisoOrdenVersion ya
      // sea otra (se puede seguir editando y entregando). aviso-orden-0 (sin aviso) nunca está aquí.
      // Al publicar una versión nueva, agregar aquí la que deja de ser vigente.
      function avisosOrdenAnteriores() {
        return ['aviso-orden-1', 'aviso-orden-2'];
      }
      function datosClienteOk() {
        let c = get(/databases/$(database)/documents/config/ordenes).data;
        let d = request.resource.data;
        return (c.datosClienteHabilitados == true
                && (d.avisoVersion == c.avisoOrdenVersion
                    // Solo al EDITAR una orden existente que ya traía esa misma versión (crear siempre
                    // exige la versión vigente, y editar no deja cambiar avisoVersion).
                    || (request.method == 'update'
                        && d.avisoVersion == resource.data.avisoVersion
                        && d.avisoVersion in avisosOrdenAnteriores())))
          || (d.cliente == {} && !('placas' in d.vehiculo));
      }
      function textoOk(v, max) {
        return v is string && v.size() <= max;
      }
      // IMPORTANTE: trabajos y piezas se revisan aquí SOLO como listas de máximo 20, NO renglón por
      // renglón. Firestore corta cada evaluación de reglas a 1,000 revisiones ("maximum of 1000
      // expressions"): revisar los campos de 40 renglones (20 + 20) lo rebasa y Firestore RECHAZA la
      // orden, incluso una entregada con pocos renglones queda al borde (confirmado en el emulador).
      // La revisión de cada renglón (descripción 1-200, cantidad 1-999, precio 0-1,000,000) la hace
      // la app antes de guardar (src/lib/ordenes.ts, validarOrden), y la pantalla y el PDF los tratan
      // como texto plano y toleran renglones mal formados. Lo peor que puede pasar es que un taller
      // que manipule su propia app guarde un renglón raro en SU orden, que solo ve él (y Firestore
      // limita cada documento a 1 MB). NO agregar aquí revisión por renglón sin medir el límite.
      function listaOk(l) {
        return l is list && l.size() <= 20;
      }
      function ordenValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tallerId', 'estado', 'cliente', 'vehiculo', 'fallaReportada', 'observaciones', 'estadoRecepcion', 'pertenencias', 'trabajos', 'piezas', 'totalCentavos', 'creadoAt', 'actualizadoAt', 'expiraAt', 'avisoVersion', 'garantiaDias', 'fechaEntrega', 'seguimientoToken', 'notaSeguimiento', 'primeraEntregaAt'])
          && d.keys().hasAll(['tallerId', 'estado', 'cliente', 'vehiculo', 'fallaReportada', 'observaciones', 'estadoRecepcion', 'pertenencias', 'trabajos', 'piezas', 'totalCentavos', 'creadoAt', 'actualizadoAt', 'expiraAt', 'avisoVersion'])
          && d.tallerId == tallerId
          && d.estado in ['recibido', 'diagnostico', 'esperandoPiezas', 'reparacion', 'listo', 'entregado']
          && d.cliente is map
          && d.cliente.keys().hasOnly(['nombre', 'telefono'])
          && (!('nombre' in d.cliente) || (d.cliente.nombre is string && d.cliente.nombre.size() <= 100))
          && (!('telefono' in d.cliente) || (d.cliente.telefono is string && d.cliente.telefono.matches('^[0-9 +()-]{0,20}$')))
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'placas', 'kilometraje'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && (!('placas' in d.vehiculo) || (d.vehiculo.placas is string && d.vehiculo.placas.size() <= 12))
          && (!('kilometraje' in d.vehiculo) || (d.vehiculo.kilometraje is int && d.vehiculo.kilometraje >= 0 && d.vehiculo.kilometraje <= 2000000))
          && textoOk(d.fallaReportada, 1000)
          && textoOk(d.observaciones, 1000)
          && textoOk(d.estadoRecepcion, 500)
          && textoOk(d.pertenencias, 500)
          && listaOk(d.trabajos)
          && listaOk(d.piezas)
          && d.totalCentavos is int && d.totalCentavos >= 0 && d.totalCentavos <= 4000000000
          && d.expiraAt is timestamp
          && d.avisoVersion is string && d.avisoVersion.size() <= 40
          // Entregada: garantía de 0 a 365 días y fecha de entrega. Si no, ninguna de las dos.
          && (d.estado == 'entregado'
                ? (d.garantiaDias is int && d.garantiaDias >= 0 && d.garantiaDias <= 365 && d.fechaEntrega is timestamp)
                : (!('garantiaDias' in d) && !('fechaEntrega' in d)))
          && datosClienteOk();
      }
      function cerca(t, objetivo) {
        return t >= objetivo - duration.value(5, 'm') && t <= objetivo + duration.value(5, 'm');
      }
      // Fecha de borrado al crear
      function expiraAlCrear() {
        let d = request.resource.data;
        return d.estado == 'entregado'
          ? (d.fechaEntrega == request.time && cerca(d.expiraAt, request.time + duration.value(d.garantiaDias + 8, 'd')))
          : cerca(d.expiraAt, request.time + duration.value(88, 'd'));
      }
      // Fecha de borrado al editar
      function expiraAlEditar() {
        let d = request.resource.data;
        let r = resource.data;
        return d.estado != 'entregado'
          // Sin entregar (o regresa de entregada): 88 días desde este guardado
          ? cerca(d.expiraAt, request.time + duration.value(88, 'd'))
          : (r.estado != 'entregado'
              // Se entrega ahora
              ? (d.fechaEntrega == request.time && cerca(d.expiraAt, request.time + duration.value(d.garantiaDias + 8, 'd')))
              // Ya estaba entregada: misma fecha de entrega; el borrado solo cambia si cambió la garantía
              : (d.fechaEntrega == r.fechaEntrega
                  && (d.garantiaDias == r.garantiaDias
                        ? d.expiraAt == r.expiraAt
                        : cerca(d.expiraAt, r.fechaEntrega + duration.value(d.garantiaDias + 8, 'd')))));
      }

      // Seguimiento público (campos de la orden):
      //  - seguimientoToken y notaSeguimiento: solo en órdenes con aviso en avisosConSeguimiento(), y
      //    nunca al crear (el enlace se activa después, desde el detalle).
      //  - primeraEntregaAt (solo esas órdenes): la hora del servidor la PRIMERA vez que la orden pasa
      //    a Entregado; después nunca cambia, aunque la orden regrese a otro estado. De ahí cuentan los
      //    30 días del enlace (ver seguimientos).
      // Sincronía con seguimientos/{huella}, sin repetir aquí la revisión pesada (la hacen las reglas
      // de seguimientos contra esta orden con getAfter):
      //  - mismo token: si el enlace EXISTE después del guardado, se reescribió en el mismo lote
      //    (actualizadoAt == hora del servidor). Si el taller lo desactivó, la orden se guarda libre.
      //  - token nuevo (activar / reactivar): el enlace nuevo existe después del lote (sus reglas de
      //    crear exigen bandera, Premium, términos y aviso) y el anterior ya no existe.
      //  - quitar el token: solo si su enlace ya no existe.
      function conSeguimiento(version) {
        return version in avisosConSeguimiento();
      }
      function notaSeguimientoOk(d) {
        return !('notaSeguimiento' in d) || (d.notaSeguimiento is string && d.notaSeguimiento.size() <= 200);
      }
      function primeraEntregaAlCrear() {
        let d = request.resource.data;
        return conSeguimiento(d.avisoVersion) && d.estado == 'entregado'
          ? d.get('primeraEntregaAt', null) == request.time
          : !('primeraEntregaAt' in d);
      }
      function seguimientoAlEditar() {
        let d = request.resource.data;
        let r = resource.data;
        let antes = r.get('seguimientoToken', null);
        let despues = d.get('seguimientoToken', null);
        return (conSeguimiento(r.avisoVersion)
                || (!('seguimientoToken' in d) && !('notaSeguimiento' in d) && !('primeraEntregaAt' in d)))
          && notaSeguimientoOk(d)
          && ('primeraEntregaAt' in r
                ? d.get('primeraEntregaAt', null) == r.primeraEntregaAt
                : (conSeguimiento(r.avisoVersion) && d.estado == 'entregado'
                    ? d.get('primeraEntregaAt', null) == request.time
                    : !('primeraEntregaAt' in d)))
          && (antes == despues
                ? (despues == null
                    || !existsAfter(refSeguimiento(despues))
                    || getAfter(refSeguimiento(despues)).data.actualizadoAt == request.time)
                : ((antes == null || !existsAfter(refSeguimiento(antes)))
                    && (despues == null
                        || (despues is string && despues.matches('^[A-Za-z0-9_-]{43}$') && existsAfter(refSeguimiento(despues))))));
      }

      allow read: if esAdmin() || esDuenoDelTaller();

      allow create: if tallerActivoDeDueno()
                    && versionVigente()
                    && ordenesHabilitadas()
                    && premiumOrdenesOk()
                    && ordenId.matches('^O[0-9]{6}-[A-Z0-9]{4}$')
                    && ordenValida()
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.actualizadoAt == request.time
                    && expiraAlCrear()
                    && request.resource.data.avisoVersion == get(/databases/$(database)/documents/config/ordenes).data.avisoOrdenVersion
                    && !('seguimientoToken' in request.resource.data)
                    && !('notaSeguimiento' in request.resource.data)
                    && primeraEntregaAlCrear();

      allow update: if (
                        // A) "Quitar datos del cliente": dueño ACTIVO y con términos VIGENTES. SOLO vaciar
                        //    cliente y quitar placas. No lee config/ordenes: funciona aunque la función se
                        //    apague. No mueve la fecha de borrado.
                        (tallerActivoDeDueno()
                         && versionVigente()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente', 'vehiculo', 'actualizadoAt'])
                         && request.resource.data.cliente == {}
                         && request.resource.data.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'kilometraje'])
                         && request.resource.data.vehiculo.marca == resource.data.vehiculo.marca
                         && request.resource.data.vehiculo.modelo == resource.data.vehiculo.modelo
                         && request.resource.data.vehiculo.anio == resource.data.vehiculo.anio
                         && request.resource.data.vehiculo.get('kilometraje', null) == resource.data.vehiculo.get('kilometraje', null)
                         && request.resource.data.actualizadoAt == request.time)
                        // B) EDICIÓN NORMAL: taller activo, versión vigente, función encendida, orden no
                        //    vencida y, si config/ordenes.requierePremium, Premium vigente
                        || (tallerActivoDeDueno()
                            && versionVigente()
                            && ordenesHabilitadas()
                            && premiumOrdenesOk()
                            && ordenValida()
                            && resource.data.expiraAt > request.time
                            && request.resource.data.creadoAt == resource.data.creadoAt
                            && request.resource.data.avisoVersion == resource.data.avisoVersion
                            && request.resource.data.actualizadoAt == request.time
                            && expiraAlEditar()
                            && seguimientoAlEditar())
                      );

      // Borrar: admin, o el dueño con taller activo y términos vigentes. Si la orden tiene enlace de
      // seguimiento, el dueño lo borra en el mismo lote (no quedan enlaces huérfanos).
      allow delete: if esAdmin()
                    || (tallerActivoDeDueno() && versionVigente()
                        && (!('seguimientoToken' in resource.data)
                            || !existsAfter(refSeguimiento(resource.data.seguimientoToken))));
    }

    // ---------- Seguimiento público de órdenes (etapa 1) ----------
    // seguimientos/{huella}: SOLO los datos que ve el cliente en /seguimiento/{token}. El token vive
    // en la orden (que solo lee el dueño); aquí solo su huella SHA-256 como ID. La página pública lo
    // lee en el servidor con el usuario de servicio (solo get, nunca list) y NUNCA lee órdenes ni
    // talleres. Sin placas, sin datos del cliente, sin precios.
    // Todo lo que se escribe debe coincidir con la orden DESPUÉS del lote (getAfter) y con el taller.
    // Vence (expiraAt, política TTL) a más tardar cuando vence la orden y a más tardar 30 días
    // después de la primera entrega (primeraEntregaAt de la orden).
    //  - Crear (activar): dueño, taller activo, términos vigentes, config/ordenes.seguimientoHabilitado,
    //    Premium vigente SIEMPRE y aviso de la orden en avisosConSeguimiento().
    //  - Actualizar (mantener al día): solo el dueño y que coincida; NO pide Premium, bandera ni
    //    términos (la orden ya los pide para guardarse).
    //  - Borrar (desactivar): el dueño siempre (sin Premium, términos ni taller activo) o el admin.
    match /seguimientos/{huella} {
      function tallerDelSeguimiento(id) {
        return get(/databases/$(database)/documents/talleres/$(id)).data;
      }
      function esDuenoDelSeguimiento(id) {
        return request.auth != null && tallerDelSeguimiento(id).ownerUid == request.auth.uid;
      }
      function ordenDelSeguimiento(d) {
        return getAfter(/databases/$(database)/documents/talleres/$(d.tallerId)/ordenes/$(d.folio)).data;
      }
      function seguimientoValido() {
        let d = request.resource.data;
        let o = ordenDelSeguimiento(d);
        let t = tallerDelSeguimiento(d.tallerId);
        return d.keys().hasOnly(['tallerId', 'folio', 'tallerNombre', 'tallerWhatsapp', 'marca', 'modelo', 'anio', 'estado', 'nota', 'actualizadoAt', 'expiraAt'])
          && d.keys().hasAll(['tallerId', 'folio', 'tallerNombre', 'tallerWhatsapp', 'marca', 'modelo', 'anio', 'estado', 'nota', 'actualizadoAt', 'expiraAt'])
          && request.auth != null
          && t.ownerUid == request.auth.uid
          && o.tallerId == d.tallerId
          && huella == hashing.sha256(o.seguimientoToken).toHexString().lower()
          && d.tallerNombre == t.nombre
          && d.tallerWhatsapp == t.whatsapp
          && d.marca == o.vehiculo.marca
          && d.modelo == o.vehiculo.modelo
          && d.anio == o.vehiculo.anio
          && d.estado == o.estado
          && d.nota == o.get('notaSeguimiento', '')
          && d.actualizadoAt == request.time
          && d.expiraAt is timestamp
          && d.expiraAt <= o.expiraAt
          && (!('primeraEntregaAt' in o) || d.expiraAt <= o.primeraEntregaAt + duration.value(30, 'd'));
      }

      // Si el documento NO existe (enlace desactivado o vencido), cualquier usuario con sesión puede
      // saberlo: sin el token no se conoce la huella, así que no revela nada. Así el dueño revisa si
      // su enlace sigue activo y "desactivar" funciona aunque ya no exista.
      allow get: if esServicio() || esAdmin()
                 || (request.auth != null && (resource == null || esDuenoDelSeguimiento(resource.data.tallerId)));
      allow list: if esAdmin();

      allow create: if seguimientoValido()
                    && tallerDelSeguimiento(request.resource.data.tallerId).activo == true
                    && tallerDelSeguimiento(request.resource.data.tallerId).aceptacionVersion
                         == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
                    && get(/databases/$(database)/documents/config/ordenes).data.get('seguimientoHabilitado', false) == true
                    && premiumVigente(tallerDelSeguimiento(request.resource.data.tallerId))
                    && ordenDelSeguimiento(request.resource.data).avisoVersion in avisosConSeguimiento();

      allow update: if seguimientoValido()
                    && request.resource.data.tallerId == resource.data.tallerId
                    && request.resource.data.folio == resource.data.folio;

      allow delete: if esAdmin()
                    || (request.auth != null && (resource == null || esDuenoDelSeguimiento(resource.data.tallerId)));
    }

    // ---------- Historial de servicios del taller (etapa 2) ----------
    // Un documento por vehículo con sus servicios dentro (máximo 60). Se alimenta SOLO de órdenes
    // ENTREGADAS: cada guardado agrega el servicio de la orden ultimoFolio, que debe existir, estar
    // entregada y ser del mismo vehículo (marca y modelo sin importar mayúsculas, año y placas).
    // NUNCA nombre ni teléfono del cliente (campos permitidos cerrados). Placas obligatorias.
    // Escribir: dueño con taller activo, términos vigentes, config/historialTaller.habilitado ==
    // true (sin el documento, get() falla y se niega: falla cerrada) y Premium vigente.
    // Borrar: el dueño SIEMPRE (aunque tenga términos viejos o Premium vencido) o el admin.
    // Borrado automático: expiraAt = ahora + 548 días (±5 min) en cada guardado (política TTL).
    // Como en órdenes, no se revisa renglón por renglón (límite de 1,000 revisiones): solo el
    // servicio nuevo, y los anteriores no pueden cambiar.
    match /talleres/{tallerId}/historial/{vehiculoId} {
      function tallerH() {
        return get(/databases/$(database)/documents/talleres/$(tallerId)).data;
      }
      function esDuenoH() {
        return request.auth != null && tallerH().ownerUid == request.auth.uid;
      }
      function puedeEscribirH() {
        let t = tallerH();
        return request.auth != null
          && t.ownerUid == request.auth.uid
          && t.activo == true
          && t.aceptacionVersion == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
          && get(/databases/$(database)/documents/config/historialTaller).data.get('habilitado', false) == true
          && premiumVigente(t);
      }
      function rutaOrdenH() {
        return /databases/$(database)/documents/talleres/$(tallerId)/ordenes/$(request.resource.data.ultimoFolio);
      }
      function cercaH(t, objetivo) {
        return t >= objetivo - duration.value(5, 'm') && t <= objetivo + duration.value(5, 'm');
      }
      function formaH() {
        let d = request.resource.data;
        return d.keys().hasOnly(['placas', 'marca', 'modelo', 'anio', 'servicios', 'folios', 'ultimoFolio', 'ultimoKm', 'ultimoServicioAt', 'creadoAt', 'actualizadoAt', 'expiraAt', 'recordatorios', 'proximoAviso'])
          && d.keys().hasAll(['placas', 'marca', 'modelo', 'anio', 'servicios', 'folios', 'ultimoFolio', 'ultimoServicioAt', 'creadoAt', 'actualizadoAt', 'expiraAt'])
          && d.placas is string && d.placas.matches('^[A-Z0-9-]{1,12}$')
          && d.marca is string && d.marca.size() >= 1 && d.marca.size() <= 60
          && d.modelo is string && d.modelo.size() >= 1 && d.modelo.size() <= 60
          && d.anio is int && d.anio >= 1950 && d.anio <= 2100
          && d.servicios is list && d.servicios.size() >= 1 && d.servicios.size() <= 60
          && d.folios is list && d.folios.size() == d.servicios.size()
          && d.ultimoFolio is string && d.ultimoFolio.matches('^O[0-9]{6}-[A-Z0-9]{4}$')
          && d.folios[d.folios.size() - 1] == d.ultimoFolio
          && (!('ultimoKm' in d) || (d.ultimoKm is int && d.ultimoKm >= 0 && d.ultimoKm <= 2000000))
          && d.ultimoServicioAt is timestamp
          && d.actualizadoAt == request.time
          && cercaH(d.expiraAt, request.time + duration.value(548, 'd'));
      }
      // El servicio nuevo (el último de la lista) sale de la orden ultimoFolio: mismo folio, misma
      // fecha de entrega, mismo kilometraje; descripción y piezas con tope.
      function servicioNuevoH(o) {
        let d = request.resource.data;
        let s = d.servicios[d.servicios.size() - 1];
        return s is map
          && s.keys().hasOnly(['folio', 'fecha', 'kilometraje', 'descripcion', 'piezas'])
          && s.keys().hasAll(['folio', 'fecha', 'descripcion', 'piezas'])
          && s.folio == d.ultimoFolio
          && s.fecha == o.fechaEntrega
          && s.get('kilometraje', null) == o.vehiculo.get('kilometraje', null)
          && s.descripcion is string && s.descripcion.size() <= 1000
          && s.piezas is list && s.piezas.size() <= 20;
      }
      // La orden existe, está entregada y es del mismo vehículo (placas: si la orden las tiene,
      // las mismas; si no, las escribió el taller al agregar).
      function ordenCoincideH() {
        let d = request.resource.data;
        let o = get(rutaOrdenH()).data;
        return exists(rutaOrdenH())
          && o.estado == 'entregado'
          && o.vehiculo.marca.lower() == d.marca.lower()
          && o.vehiculo.modelo.lower() == d.modelo.lower()
          && o.vehiculo.anio == d.anio
          && (!('placas' in o.vehiculo) || o.vehiculo.placas.upper().replace(' ', '') == d.placas)
          && servicioNuevoH(o);
      }

      // ----- Recordatorios (etapa 3): recordatorios[] (hasta 10) y proximoAviso -----
      // Solo se cambian con la ruta C ("solo recordatorios"). Firestore no recorre listas y corta
      // cada revisión a 1,000 operaciones: la revisión va por posición y SE DETIENE donde termina la
      // lista. Un recordatorio igual al anterior en la misma posición (o en la siguiente, cuando se
      // quitó uno) no se vuelve a revisar a fondo; solo los nuevos o cambiados. Medido en el
      // emulador: 10 caben (12 ya no). Si alguien manipula su app y cambia demasiados a la vez,
      // Firestore rechaza el guardado (nunca lo deja pasar).
      function avisoDeH(x) {
        return x.fecha - duration.value(x.avisarDiasAntes, 'd');
      }
      // Campos cerrados (sin datos personales). Lo que no es texto hace fallar matches()/size() y se niega.
      function recItemOkH(x, folios) {
        return x.keys().hasOnly(['id', 'tipo', 'fecha', 'avisarDiasAntes', 'folio', 'estado', 'creadoAt'])
          && x.keys().size() == 7
          && x.id.matches('^[a-z0-9]{6,12}$')
          && x.tipo.size() >= 1 && x.tipo.size() <= 60
          && x.fecha is timestamp
          && x.avisarDiasAntes is int && x.avisarDiasAntes >= 0 && x.avisarDiasAntes <= 60
          && x.folio in folios
          && x.estado in ['pendiente', 'atendido']
          && x.creadoAt is timestamp;
      }
      function recEnH(l, viejo, i, folios) {
        return (viejo.size() > i && l[i] == viejo[i])
          || (viejo.size() > i + 1 && l[i] == viejo[i + 1])
          || recItemOkH(l[i], folios);
      }
      function listaRecH(l, viejo, folios) {
        return (l.size() <= 0 || (recEnH(l, viejo, 0, folios) && 
          (l.size() <= 1 || (recEnH(l, viejo, 1, folios) && 
          (l.size() <= 2 || (recEnH(l, viejo, 2, folios) && 
          (l.size() <= 3 || (recEnH(l, viejo, 3, folios) && 
          (l.size() <= 4 || (recEnH(l, viejo, 4, folios) && 
          (l.size() <= 5 || (recEnH(l, viejo, 5, folios) && 
          (l.size() <= 6 || (recEnH(l, viejo, 6, folios) && 
          (l.size() <= 7 || (recEnH(l, viejo, 7, folios) && 
          (l.size() <= 8 || (recEnH(l, viejo, 8, folios) && 
          (l.size() <= 9 || recEnH(l, viejo, 9, folios))))))))))))))))))));
      }
      function sinPendientesH(l) {
        return (l.size() <= 0 || (l[0].estado != 'pendiente' && 
          (l.size() <= 1 || (l[1].estado != 'pendiente' && 
          (l.size() <= 2 || (l[2].estado != 'pendiente' && 
          (l.size() <= 3 || (l[3].estado != 'pendiente' && 
          (l.size() <= 4 || (l[4].estado != 'pendiente' && 
          (l.size() <= 5 || (l[5].estado != 'pendiente' && 
          (l.size() <= 6 || (l[6].estado != 'pendiente' && 
          (l.size() <= 7 || (l[7].estado != 'pendiente' && 
          (l.size() <= 8 || (l[8].estado != 'pendiente' && 
          (l.size() <= 9 || l[9].estado != 'pendiente')))))))))))))))))));
      }
      function cotaH(l, p) {
        return (l.size() <= 0 || ((l[0].estado != 'pendiente' || p <= avisoDeH(l[0])) && 
          (l.size() <= 1 || ((l[1].estado != 'pendiente' || p <= avisoDeH(l[1])) && 
          (l.size() <= 2 || ((l[2].estado != 'pendiente' || p <= avisoDeH(l[2])) && 
          (l.size() <= 3 || ((l[3].estado != 'pendiente' || p <= avisoDeH(l[3])) && 
          (l.size() <= 4 || ((l[4].estado != 'pendiente' || p <= avisoDeH(l[4])) && 
          (l.size() <= 5 || ((l[5].estado != 'pendiente' || p <= avisoDeH(l[5])) && 
          (l.size() <= 6 || ((l[6].estado != 'pendiente' || p <= avisoDeH(l[6])) && 
          (l.size() <= 7 || ((l[7].estado != 'pendiente' || p <= avisoDeH(l[7])) && 
          (l.size() <= 8 || ((l[8].estado != 'pendiente' || p <= avisoDeH(l[8])) && 
          (l.size() <= 9 || l[9].estado != 'pendiente' || p <= avisoDeH(l[9]))))))))))))))))))));
      }
      function algunoIgualH(l, p) {
        return (l.size() > 0 && ((l[0].estado == 'pendiente' && avisoDeH(l[0]) == p) || 
          (l.size() > 1 && ((l[1].estado == 'pendiente' && avisoDeH(l[1]) == p) || 
          (l.size() > 2 && ((l[2].estado == 'pendiente' && avisoDeH(l[2]) == p) || 
          (l.size() > 3 && ((l[3].estado == 'pendiente' && avisoDeH(l[3]) == p) || 
          (l.size() > 4 && ((l[4].estado == 'pendiente' && avisoDeH(l[4]) == p) || 
          (l.size() > 5 && ((l[5].estado == 'pendiente' && avisoDeH(l[5]) == p) || 
          (l.size() > 6 && ((l[6].estado == 'pendiente' && avisoDeH(l[6]) == p) || 
          (l.size() > 7 && ((l[7].estado == 'pendiente' && avisoDeH(l[7]) == p) || 
          (l.size() > 8 && ((l[8].estado == 'pendiente' && avisoDeH(l[8]) == p) || 
          (l.size() > 9 && l[9].estado == 'pendiente' && avisoDeH(l[9]) == p)))))))))))))))))));
      }
      // proximoAviso = el menor (fecha - avisarDiasAntes) de los pendientes; null si no hay.
      function proximoOkH(l, p) {
        return p == null ? sinPendientesH(l) : (p is timestamp && cotaH(l, p) && algunoIgualH(l, p));
      }
      // Ruta C: la lista nueva (hasta 10) bien formada y proximoAviso consistente con ella.
      function recordatoriosOkH() {
        let d = request.resource.data;
        let l = d.recordatorios;
        return l is list && l.size() <= 10
          && listaRecH(l, resource.data.get('recordatorios', []), resource.data.folios)
          && proximoOkH(l, d.get('proximoAviso', null));
      }

      allow read: if esAdmin() || esDuenoH();

      allow create: if puedeEscribirH()
                    && formaH()
                    && request.resource.data.servicios.size() == 1
                    && request.resource.data.creadoAt == request.time
                    // Nace sin recordatorios (se agregan después con la ruta C)
                    && request.resource.data.get('recordatorios', []).size() == 0
                    && request.resource.data.get('proximoAviso', null) == null
                    && ordenCoincideH();

      // Dos tipos de cambio (mismos permisos: dueño activo, términos vigentes, bandera y Premium):
      // C) SOLO recordatorios (agregar, adelantar, días de aviso, atendido, quitar): no cambia nada
      //    más, ni servicios, folios, placas, vehículo ni la fecha de borrado (expiraAt).
      // B) Agregar un servicio (no toca recordatorios ni proximoAviso): el vehículo no cambia, la
      //    orden no estaba ya en el historial y los servicios y folios anteriores quedan idénticos
      //    (solo se agrega uno al final). Solo aquí se mueve expiraAt (+548 días).
      allow update: if (puedeEscribirH()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recordatorios', 'proximoAviso', 'actualizadoAt'])
                    && request.resource.data.actualizadoAt == request.time
                    && recordatoriosOkH())
                    || (puedeEscribirH()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['recordatorios', 'proximoAviso'])
                    && formaH()
                    && request.resource.data.creadoAt == resource.data.creadoAt
                    && request.resource.data.placas == resource.data.placas
                    && request.resource.data.marca == resource.data.marca
                    && request.resource.data.modelo == resource.data.modelo
                    && request.resource.data.anio == resource.data.anio
                    && !(request.resource.data.ultimoFolio in resource.data.folios)
                    && request.resource.data.servicios.size() == resource.data.servicios.size() + 1
                    && request.resource.data.servicios[0:resource.data.servicios.size()] == resource.data.servicios
                    && request.resource.data.folios[0:resource.data.folios.size()] == resource.data.folios
                    && ordenCoincideH());

      allow delete: if esAdmin() || esDuenoH();
    }

    // ---------- Libreta de contactos del taller ----------
    // Un documento por contacto (nombre, WhatsApp, nota corta y hasta 3 vehículos). Solo lo ve el
    // dueño del taller (y el admin). Escribir: dueño con taller activo, términos vigentes y
    // config/contactos.habilitado == true (sin el documento, get() falla y se niega: falla cerrada).
    // Tope del plan Básico (25) sin contar documentos: un contacto NUEVO solo puede usar uno de los
    // 25 lugares con ID fijo c01 ... c25; cualquier otro ID (automático, 20 letras y números) pide
    // Premium vigente. Si el lugar ya está ocupado, setDoc sería una edición y la edición exige el
    // mismo creadoAt: no se puede pisar un contacto. Editar, usar y borrar NO piden Premium (quien
    // baja de Premium con más de 25 conserva todo; solo no agrega nuevos con los 25 lugares llenos).
    // Borrar: el dueño SIEMPRE (aunque tenga términos viejos o el taller desactivado) o el admin.
    // Borrado automático: expiraAt = ahora + 548 días (±5 min) en cada guardado (política TTL).
    match /talleres/{tallerId}/contactosClientes/{contactoId} {
      function tallerC() {
        return get(/databases/$(database)/documents/talleres/$(tallerId)).data;
      }
      function esDuenoC() {
        return request.auth != null && tallerC().ownerUid == request.auth.uid;
      }
      function puedeEscribirC() {
        let t = tallerC();
        return request.auth != null
          && t.ownerUid == request.auth.uid
          && t.activo == true
          && t.aceptacionVersion == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
          && get(/databases/$(database)/documents/config/contactos).data.get('habilitado', false) == true;
      }
      function cercaC(t, objetivo) {
        return t >= objetivo - duration.value(5, 'm') && t <= objetivo + duration.value(5, 'm');
      }
      function vehiculoC(v) {
        return v is map
          && v.keys().hasOnly(['marca', 'modelo', 'anio', 'placas'])
          && v.keys().hasAll(['marca', 'modelo'])
          && v.marca is string && v.marca.size() >= 1 && v.marca.size() <= 60
          && v.modelo is string && v.modelo.size() >= 1 && v.modelo.size() <= 60
          && (!('anio' in v) || (v.anio is int && v.anio >= 1950 && v.anio <= 2100))
          && (!('placas' in v) || (v.placas is string && v.placas.matches('^[A-Z0-9-]{1,12}$')));
      }
      function placasC(p) {
        return p is string && p.matches('^[A-Z0-9-]{1,12}$');
      }
      function formaC() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'nombreBusqueda', 'telefono', 'nota', 'vehiculos', 'placasLista', 'creadoAt', 'actualizadoAt', 'expiraAt'])
          && d.keys().hasAll(['nombre', 'nombreBusqueda', 'telefono', 'nota', 'vehiculos', 'placasLista', 'creadoAt', 'actualizadoAt', 'expiraAt'])
          && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
          && d.nombreBusqueda is string && d.nombreBusqueda.size() <= 100
          && d.telefono is string && (d.telefono == '' || d.telefono.matches('^[0-9]{10}$'))
          && d.nota is string && d.nota.size() <= 200
          && d.vehiculos is list && d.vehiculos.size() <= 3
          && (d.vehiculos.size() < 1 || vehiculoC(d.vehiculos[0]))
          && (d.vehiculos.size() < 2 || vehiculoC(d.vehiculos[1]))
          && (d.vehiculos.size() < 3 || vehiculoC(d.vehiculos[2]))
          && d.placasLista is list && d.placasLista.size() <= 3
          && (d.placasLista.size() < 1 || placasC(d.placasLista[0]))
          && (d.placasLista.size() < 2 || placasC(d.placasLista[1]))
          && (d.placasLista.size() < 3 || placasC(d.placasLista[2]))
          && d.actualizadoAt == request.time
          && d.expiraAt is timestamp
          && cercaC(d.expiraAt, request.time + duration.value(548, 'd'));
      }

      allow read: if esAdmin() || esDuenoC();

      allow create: if puedeEscribirC()
                    && formaC()
                    && request.resource.data.creadoAt == request.time
                    && (contactoId.matches('^c(0[1-9]|1[0-9]|2[0-5])$')
                        || (premiumVigente(tallerC()) && contactoId.matches('^[A-Za-z0-9]{20}$')));

      allow update: if puedeEscribirC()
                    && formaC()
                    && request.resource.data.creadoAt == resource.data.creadoAt
                    && resource.data.expiraAt > request.time;

      allow delete: if esAdmin() || esDuenoC();
    }

    // ---------- Citas del taller ----------
    // talleres/{tallerId}/citas/{citaId}. Solo el dueño (y el admin) las ve. Bandera
    // config/citas.habilitado. Con config/citas.requierePremium == true, CREAR y EDITAR piden
    // Premium vigente; ver y borrar no. Borrado automático: expiraAt = fecha + 30 días (TTL).
    // La fecha puede ser de hasta 30 días atrás (para marcar "Atendida") y hasta 400 días adelante.
    match /talleres/{tallerId}/citas/{citaId} {
      function tallerCi() {
        return get(/databases/$(database)/documents/talleres/$(tallerId)).data;
      }
      function esDuenoCi() {
        return request.auth != null && tallerCi().ownerUid == request.auth.uid;
      }
      function puedeEscribirCi() {
        let t = tallerCi();
        let c = get(/databases/$(database)/documents/config/citas).data;
        return request.auth != null
          && t.ownerUid == request.auth.uid
          && t.activo == true
          && t.aceptacionVersion == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
          && c.get('habilitado', false) == true
          && (c.get('requierePremium', false) != true || premiumVigente(t));
      }
      function formaCi() {
        let d = request.resource.data;
        return d.keys().hasOnly(['fecha', 'nombre', 'telefono', 'vehiculo', 'placas', 'motivo', 'estado', 'creadoAt', 'actualizadoAt', 'expiraAt'])
          && d.keys().hasAll(['fecha', 'nombre', 'telefono', 'vehiculo', 'placas', 'motivo', 'estado', 'creadoAt', 'actualizadoAt', 'expiraAt'])
          && d.fecha is timestamp
          && d.fecha >= request.time - duration.value(30, 'd')
          && d.fecha <= request.time + duration.value(400, 'd')
          && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
          && d.telefono is string && (d.telefono == '' || d.telefono.matches('^[0-9]{10}$'))
          && d.vehiculo is string && d.vehiculo.size() <= 100
          && d.placas is string && (d.placas == '' || d.placas.matches('^[A-Z0-9-]{1,12}$'))
          && d.motivo is string && d.motivo.size() <= 200
          && d.estado in ['pendiente', 'confirmada', 'atendida', 'cancelada']
          && d.actualizadoAt == request.time
          && d.expiraAt is timestamp
          && d.expiraAt == d.fecha + duration.value(30, 'd');
      }

      allow read: if esAdmin() || esDuenoCi();

      allow create: if puedeEscribirCi()
                    && formaCi()
                    && request.resource.data.creadoAt == request.time
                    && citaId.matches('^[A-Za-z0-9]{20}$');

      allow update: if puedeEscribirCi()
                    && formaCi()
                    && request.resource.data.creadoAt == resource.data.creadoAt
                    && resource.data.expiraAt > request.time;

      allow delete: if esAdmin() || esDuenoCi();
    }

    // ---------- Pedido de piezas de talleres a yonkes ----------
    // El taller publica una solicitud (vehículo + pieza, SIN datos del cliente final); Mecanix
    // decide a qué yonkes avisar por estado (fuera de las reglas); cada yonke responde una sola
    // vez (subcolección respuestas/{yonkeId}, sin editar ni borrar); el taller elige a uno
    // (yonkeElegido) y la solicitud pasa a 'cerrada'. El WhatsApp del taller vive en una
    // subcolección privada que solo lee el taller dueño, el admin y el yonke elegido -- así
    // ningún otro yonke lo ve. Retención: expiraAt = creadoAt + 5 días (igual en los tres
    // documentos, para que la política TTL pueda borrar los tres por colección).
    // Falla cerrada: toda creación exige que exista config/solicitudesPiezas con habilitado == true.
    match /solicitudesPiezas/{solicitudId} {
      function esDuenoDeEseTaller(tallerId) {
        return request.auth != null
          && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid;
      }
      function tallerActivoDeEseTaller(tallerId) {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        return request.auth != null && t.ownerUid == request.auth.uid && t.activo == true;
      }
      function solicitudesHabilitadas() {
        return exists(/databases/$(database)/documents/config/solicitudesPiezas)
          && get(/databases/$(database)/documents/config/solicitudesPiezas).data.habilitado == true;
      }
      function solicitudValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tallerId', 'tallerNombre', 'vehiculo', 'pieza', 'nota', 'estado', 'estadoSolicitud', 'yonkeElegido', 'creadoAt', 'expiraAt'])
          && d.tallerId is string
          && d.tallerNombre is string && d.tallerNombre.size() >= 1 && d.tallerNombre.size() <= 100
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && d.pieza is string && d.pieza.size() >= 1 && d.pieza.size() <= 100
          && d.nota is string && d.nota.size() <= 200
          && d.estado is string
          && d.creadoAt is timestamp
          && d.expiraAt is timestamp;
      }

      allow read: if esAdmin()
                  || esDuenoDeEseTaller(resource.data.tallerId)
                  || (resource.data.yonkeElegido != null && esDuenoDelYonke(resource.data.yonkeElegido))
                  || (resource.data.estadoSolicitud == 'abierta' && yonkeActivoDeEseEstado(resource.data.estado));

      allow create: if solicitudesHabilitadas()
                    && tallerActivoDeEseTaller(request.resource.data.tallerId)
                    && request.resource.data.tallerNombre == get(/databases/$(database)/documents/talleres/$(request.resource.data.tallerId)).data.nombre
                    && request.resource.data.estadoSolicitud == 'abierta'
                    && request.resource.data.yonkeElegido == null
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.expiraAt - request.time >= duration.value(5, 'd') - duration.value(5, 'm')
                    && request.resource.data.expiraAt - request.time <= duration.value(5, 'd') + duration.value(5, 'm')
                    && solicitudValida();

      // Elegir: el taller dueño pasa de 'abierta'+sin elegir a 'cerrada' con un yonke que
      // respondió que SÍ la tiene. Cancelar: el taller dueño pasa de 'abierta' a 'cancelada'.
      // Ningún otro campo cambia en ninguno de los dos casos.
      allow update: if esDuenoDeEseTaller(resource.data.tallerId)
                    && (
                      (resource.data.estadoSolicitud == 'abierta'
                       && resource.data.yonkeElegido == null
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoSolicitud', 'yonkeElegido'])
                       && request.resource.data.estadoSolicitud == 'cerrada'
                       && request.resource.data.yonkeElegido is string
                       && get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)/respuestas/$(request.resource.data.yonkeElegido)).data.tieneLaPieza == true)
                      || (resource.data.estadoSolicitud == 'abierta'
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoSolicitud'])
                          && request.resource.data.estadoSolicitud == 'cancelada')
                    );

      allow delete: if esAdmin() || esDuenoDeEseTaller(resource.data.tallerId);

      // Una respuesta por yonke: no se edita ni se borra (allow update/delete: if false --
      // la ausencia de "update"/"delete" en la lista ya lo deniega por default, se deja explícito).
      match /respuestas/{yonkeId} {
        function solicitudPadre() {
          return get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data;
        }
        // OJO: expiraAt se valida en expiraOk(), NO aquí con "==" -- comparar con "==" un
        // timestamp de request.resource.data contra uno leído con get() de OTRO documento
        // revienta la evaluación de las reglas (error del emulador/motor, no un simple falso).
        // ">="/"<=" sí funcionan bien contra el mismo valor, por eso expiraOk() usa un rango
        // angosto (±5 min) en vez de una igualdad exacta.
        function respuestaValida() {
          let d = request.resource.data;
          return d.keys().hasOnly(['yonkeId', 'yonkeNombre', 'tieneLaPieza', 'precio', 'nota', 'whatsapp', 'creadoAt', 'expiraAt'])
            && d.yonkeId == yonkeId
            && d.yonkeNombre is string && d.yonkeNombre.size() >= 1 && d.yonkeNombre.size() <= 100
            && d.tieneLaPieza is bool
            && d.whatsapp is string
            && d.nota is string && d.nota.size() <= 200
            && d.creadoAt == request.time
            && (
              (d.tieneLaPieza == true && (d.precio is int || d.precio is float) && d.precio > 0 && d.precio <= 1000000)
              || (d.tieneLaPieza == false && !('precio' in d))
            );
        }
        function expiraOk() {
          let padre = get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data.expiraAt;
          return request.resource.data.expiraAt >= padre - duration.value(5, 'm')
            && request.resource.data.expiraAt <= padre + duration.value(5, 'm');
        }

        allow read: if esAdmin()
                    || esDuenoDeEseTaller(solicitudPadre().tallerId)
                    || esDuenoDelYonke(yonkeId);

        allow create: if solicitudesHabilitadas()
                      && esDuenoDelYonke(yonkeId)
                      && yonkeActivoDeEseEstado(solicitudPadre().estado)
                      && solicitudPadre().estadoSolicitud == 'abierta'
                      && request.resource.data.yonkeNombre == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.nombre
                      && request.resource.data.whatsapp == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.whatsapp
                      && respuestaValida()
                      && expiraOk();
        // "Sugerir yonke" (admin): el yonke le confirmó por fuera que TIENE la pieza y el admin
        // registra la respuesta en su nombre. Bandera config/solicitudesPiezas.sugerirYonkeAdmin
        // (solo true exacto). Mismo estado del pedido (los talleres no tienen otros estados).
        // Siempre lleva creadoPorAdmin y el uid del admin; el yonke no puede mandar esos campos
        // (respuestaValida no los acepta). Una por yonke, igual que siempre.
        function sugerirYonkeTallerHabilitado() {
          return solicitudesHabilitadas()
            && get(/databases/$(database)/documents/config/solicitudesPiezas).data.get('sugerirYonkeAdmin', false) == true;
        }
        function respuestaAdminValida() {
          let d = request.resource.data;
          return d.keys().hasOnly(['yonkeId', 'yonkeNombre', 'tieneLaPieza', 'precioATratar', 'nota', 'whatsapp', 'creadoAt', 'expiraAt', 'creadoPorAdmin', 'creadoPorAdminUid', 'evidenciaId'])
            && d.yonkeId == yonkeId
            && d.yonkeNombre is string && d.yonkeNombre.size() >= 1 && d.yonkeNombre.size() <= 100
            && d.whatsapp is string
            && d.nota is string && d.nota.size() <= 200
            && d.creadoAt == request.time
            && d.tieneLaPieza == true
            // Mecanix nunca publica un precio capturado por el admin: siempre "precio a tratar", sin
            // el campo precio (no está en el hasOnly de arriba, con ningún valor).
            && d.precioATratar == true
            && d.creadoPorAdmin == true
            && d.creadoPorAdminUid == request.auth.uid
            && (!('evidenciaId' in d) || evidenciaDeEstaRespuesta(d.evidenciaId, 'solicitudesPiezas', solicitudId, yonkeId));
        }
        allow create: if esAdmin()
                      && sugerirYonkeTallerHabilitado()
                      && solicitudPadre().estadoSolicitud == 'abierta'
                      && exists(/databases/$(database)/documents/yonkes/$(yonkeId))
                      && get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.activo == true
                      && get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.estado == solicitudPadre().estado
                      && request.resource.data.yonkeNombre == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.nombre
                      && request.resource.data.whatsapp == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.whatsapp
                      && respuestaAdminValida()
                      && expiraOk();
        allow update: if false;
        allow delete: if esAdmin();
      }

      // Subcolección privada: solo el WhatsApp del taller. Se crea en el mismo lote que la
      // solicitud (getAfter), por eso usa tallerActivoDeEseTaller sobre el tallerId de ESE lote.
      match /privado/{docId} {
        function solicitudPadreDespues() {
          return getAfter(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data;
        }
        function solicitudPadre() {
          return get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data;
        }
        allow read: if esAdmin()
                    || esDuenoDeEseTaller(solicitudPadre().tallerId)
                    || (solicitudPadre().yonkeElegido != null && esDuenoDelYonke(solicitudPadre().yonkeElegido));
        allow create: if docId == 'contacto'
                      && tallerActivoDeEseTaller(solicitudPadreDespues().tallerId)
                      && request.resource.data.keys().hasOnly(['tallerWhatsapp', 'expiraAt'])
                      && request.resource.data.tallerWhatsapp == get(/databases/$(database)/documents/talleres/$(solicitudPadreDespues().tallerId)).data.whatsapp
                      && request.resource.data.expiraAt == solicitudPadreDespues().expiraAt;
        allow update: if false;
        allow delete: if esAdmin() || esDuenoDeEseTaller(solicitudPadre().tallerId);
      }
    }

    // ---------- NUEVO: pedido de pieza de clientes sin cuenta ----------
    // El cliente NO escribe en Firestore: todo lo crea el servidor (/api/pedir-pieza) con un
    // usuario de servicio de Firebase Auth (usuarios/{uid}.rol == 'servicio', creado a mano por el
    // admin). El pedido solo trae vehículo, pieza y estado; el WhatsApp del cliente y el hash del
    // código del enlace viven en privado/contacto, que SOLO leen el admin y el servicio -- ningún
    // yonke. Los yonkes activos del estado ven el pedido y responden una sola vez (igual que en
    // solicitudesPiezas). Retención: expiraAt = creadoAt + 5 días en los tres documentos (TTL).
    // Falla cerrada: crear y responder exigen config/pedidosClientes con habilitado == true.
    function esServicio() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'servicio';
    }
    function pedidosClientesHabilitados() {
      return exists(/databases/$(database)/documents/config/pedidosClientes)
        && get(/databases/$(database)/documents/config/pedidosClientes).data.habilitado == true;
    }
    // ---------- Límite diario de respuestas a alertas (plan Básico) ----------
    // config/pedidosClientes.limiteRespuestasDiarias: solo un entero >= 1 lo activa. Sin el campo
    // no hay límite (como antes). Premium vigente nunca tiene límite. Con límite, la respuesta
    // trae `dia` (AAAAMMDD de Tijuana) y en el MISMO guardado sube 1 el contador
    // yonkes/{id}/respuestasDiarias/{dia}, que no puede pasar del límite. Tijuana es UTC-8 en
    // invierno y UTC-7 en verano: se acepta el día calculado con cualquiera de los dos (como mucho
    // una hora de holgura alrededor de la medianoche).
    function limiteRespuestasActivo() {
      return exists(/databases/$(database)/documents/config/pedidosClientes)
        && get(/databases/$(database)/documents/config/pedidosClientes).data.get('limiteRespuestasDiarias', null) is int
        && get(/databases/$(database)/documents/config/pedidosClientes).data.limiteRespuestasDiarias >= 1;
    }
    function diaDe(t) {
      return string(t.year() * 10000 + t.month() * 100 + t.day());
    }
    function diaTijuanaValido(dia) {
      return dia is string
        && (dia == diaDe(request.time - duration.value(8, 'h')) || dia == diaDe(request.time - duration.value(7, 'h')));
    }
    function contadorRespuestas(yonkeId, dia) {
      return /databases/$(database)/documents/yonkes/$(yonkeId)/respuestasDiarias/$(dia);
    }
    function respuestaDentroDelLimite(yonkeId) {
      return !limiteRespuestasActivo()
        || premiumVigente(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data)
        || ('dia' in request.resource.data
            && diaTijuanaValido(request.resource.data.dia)
            && getAfter(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count
                 <= get(/databases/$(database)/documents/config/pedidosClientes).data.limiteRespuestasDiarias
            && ((!exists(contadorRespuestas(yonkeId, request.resource.data.dia))
                 && getAfter(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count == 1)
                || (exists(contadorRespuestas(yonkeId, request.resource.data.dia))
                    && getAfter(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count
                         == get(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count + 1)));
    }
    // Inventario de vehículos completos de las alertas: tercera bandera
    // config/pedidosClientes.inventarioVehiculos (además de la primera).
    function inventarioVehiculosHabilitado() {
      return pedidosClientesHabilitados()
        && get(/databases/$(database)/documents/config/pedidosClientes).data.get('inventarioVehiculos', false) == true;
    }
    // Alertas de otros estados: segunda bandera config/pedidosClientes.otrosEstados (además de la
    // primera). Apagada, todo funciona exactamente como antes.
    function otrosEstadosHabilitados() {
      return pedidosClientesHabilitados()
        && get(/databases/$(database)/documents/config/pedidosClientes).data.get('otrosEstados', false) == true;
    }
    // Yonke que puede ver y responder alertas de OTROS estados (las que el cliente marcó con
    // aceptaOtrosEstados): activo, Verificado y con envíos nacionales (estos dos solo los pone el
    // admin) y con su interruptor verAlertasOtrosEstados encendido. Todo sale de usuarios/{uid} y
    // yonkes/{id} leídos por la regla, nunca de lo que mande el navegador.
    function yonkeConEnvio(y) {
      return y.get('activo', false) == true
        && y.get('verificado', false) == true
        && y.get('enviosNacionales', false) == true
        && y.get('verAlertasOtrosEstados', false) == true;
    }
    function yonkeConEnvioAOtrosEstados() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId != null &&
        exists(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)) &&
        yonkeConEnvio(get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data);
    }
    match /pedidosClientes/{pedidoId} {
      function pedidoClienteValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['vehiculo', 'pieza', 'estado', 'estadoPedido', 'creadoAt', 'expiraAt', 'aceptaOtrosEstados'])
          && d.keys().hasAll(['vehiculo', 'pieza', 'estado', 'estadoPedido', 'creadoAt', 'expiraAt'])
          // Opcional (las alertas de antes no lo traen = false). true solo con la segunda bandera.
          && (!('aceptaOtrosEstados' in d) || d.aceptaOtrosEstados is bool)
          && (d.get('aceptaOtrosEstados', false) == false || otrosEstadosHabilitados())
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && d.pieza is string && d.pieza.size() >= 1 && d.pieza.size() <= 100
          && d.estado is string && d.estado.size() >= 1 && d.estado.size() <= 60
          && d.estadoPedido == 'abierta'
          && d.creadoAt == request.time
          && d.expiraAt is timestamp
          && d.expiraAt - request.time >= duration.value(5, 'd') - duration.value(5, 'm')
          && d.expiraAt - request.time <= duration.value(5, 'd') + duration.value(5, 'm');
      }

      allow read: if esAdmin()
                  || esServicio()
                  || (resource.data.estadoPedido == 'abierta' && yonkeActivoDeEseEstado(resource.data.estado))
                  // Yonke de otro estado: solo alertas que lo aceptan (la consulta debe filtrar
                  // aceptaOtrosEstados == true y estadoPedido == 'abierta').
                  || (resource.data.estadoPedido == 'abierta'
                      && resource.data.aceptaOtrosEstados == true
                      && otrosEstadosHabilitados()
                      && yonkeConEnvioAOtrosEstados());
      // Yonke ligero: solo las abiertas de su propio estado.
      allow read: if resource.data.estadoPedido == 'abierta' && ligeroActivoDeEseEstado(resource.data.estado);
      allow create: if esServicio() && pedidosClientesHabilitados() && pedidoClienteValido();
      // El admin puede dar de baja un pedido (spam) o reabrirlo; nada más cambia.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoPedido'])
                    && request.resource.data.estadoPedido in ['abierta', 'cancelada'];
      // Admin (panel "Pedidos de piezas"): cerrar o cancelar (con la hora en cerradoAt, sin
      // tocar el vencimiento), o reabrir extendiendo el vencimiento 5 días desde hoy (±1 h por
      // el reloj de la computadora del admin). Ningún otro campo cambia.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoPedido', 'expiraAt', 'cerradoAt'])
                    && (
                      (request.resource.data.estadoPedido in ['cerrada', 'cancelada']
                       && request.resource.data.expiraAt == resource.data.expiraAt
                       && request.resource.data.cerradoAt == request.time)
                      || (request.resource.data.estadoPedido == 'abierta'
                          && !('cerradoAt' in request.resource.data)
                          && request.resource.data.expiraAt is timestamp
                          && request.resource.data.expiraAt - request.time >= duration.value(5, 'd') - duration.value(1, 'h')
                          && request.resource.data.expiraAt - request.time <= duration.value(5, 'd') + duration.value(1, 'h'))
                    );
      allow delete: if esAdmin();

      // Una respuesta por yonke: no se edita ni se borra. Solo la leen su yonke, el admin y el
      // servicio (que se la muestra al cliente) -- un yonke nunca ve las respuestas de otros.
      match /respuestas/{yonkeId} {
        function pedidoPadre() {
          return get(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data;
        }
        function respuestaPedidoValida() {
          let d = request.resource.data;
          // `dia`: solo cuando hay límite diario (ver respuestaDentroDelLimite).
          return d.keys().hasOnly(['yonkeId', 'yonkeNombre', 'tieneLaPieza', 'precio', 'nota', 'whatsapp', 'creadoAt', 'expiraAt', 'dia'])
            && (!('dia' in d) || diaTijuanaValido(d.dia))
            && d.yonkeId == yonkeId
            && d.yonkeNombre is string && d.yonkeNombre.size() >= 1 && d.yonkeNombre.size() <= 100
            && d.tieneLaPieza is bool
            && d.whatsapp is string
            && d.nota is string && d.nota.size() <= 200
            && d.creadoAt == request.time
            && (
              (d.tieneLaPieza == true && (d.precio is int || d.precio is float) && d.precio > 0 && d.precio <= 1000000)
              || (d.tieneLaPieza == false && !('precio' in d))
            );
        }
        // Rango de ±5 min contra el expiraAt del pedido (ver nota en solicitudesPiezas: "==" entre
        // timestamps de documentos distintos revienta la evaluación).
        function expiraIgualAlPedido() {
          let padre = pedidoPadre().expiraAt;
          return request.resource.data.expiraAt is timestamp
            && request.resource.data.expiraAt >= padre - duration.value(5, 'm')
            && request.resource.data.expiraAt <= padre + duration.value(5, 'm');
        }

        // Yonke ligero: tope propio (config/pedidosClientes.limiteRespuestasLigero). Sin ese campo no
        // responde: falla cerrada. Siempre con `dia` y su contador en el mismo guardado; Premium no aplica.
        function respuestaLigeraDentroDelLimite(yonkeId) {
          let limite = get(/databases/$(database)/documents/config/pedidosClientes).data.get('limiteRespuestasLigero', null);
          let dia = request.resource.data.get('dia', null);
          return limite is int && limite >= 1
            && diaTijuanaValido(dia)
            && getAfter(contadorRespuestas(yonkeId, dia)).data.count <= limite
            && ((!exists(contadorRespuestas(yonkeId, dia)) && getAfter(contadorRespuestas(yonkeId, dia)).data.count == 1)
                || (exists(contadorRespuestas(yonkeId, dia))
                    && getAfter(contadorRespuestas(yonkeId, dia)).data.count == get(contadorRespuestas(yonkeId, dia)).data.count + 1));
        }
        allow read: if esYonkeLigero(yonkeId);
        allow read: if esAdmin() || esServicio() || esDuenoDelYonke(yonkeId);
        allow create: if pedidosClientesHabilitados()
                      && esDuenoDelYonke(yonkeId)
                      && (yonkeActivoDeEseEstado(pedidoPadre().estado)
                          || (pedidoPadre().get('aceptaOtrosEstados', false) == true
                              && otrosEstadosHabilitados()
                              && yonkeConEnvioAOtrosEstados()))
                      && pedidoPadre().estadoPedido == 'abierta'
                      && pedidoPadre().expiraAt > request.time
                      && request.resource.data.yonkeNombre == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.nombre
                      && request.resource.data.whatsapp == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.whatsapp
                      && respuestaPedidoValida()
                      && expiraIgualAlPedido()
                      && respuestaDentroDelLimite(yonkeId);
        allow create: if pedidosClientesHabilitados()
                      && esYonkeLigero(yonkeId)
                      && ligeroActivoDeEseEstado(pedidoPadre().estado)
                      && pedidoPadre().estadoPedido == 'abierta'
                      && pedidoPadre().expiraAt > request.time
                      && request.resource.data.yonkeNombre == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.nombre
                      && request.resource.data.whatsapp == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.whatsapp
                      && respuestaPedidoValida()
                      && expiraIgualAlPedido()
                      && respuestaLigeraDentroDelLimite(yonkeId);
        // "Sugerir yonke" (admin): el yonke le confirmó por fuera que TIENE la pieza y el admin
        // registra la respuesta en su nombre. Bandera config/pedidosClientes.sugerirYonkeAdmin (solo
        // true exacto). Mismo estado del pedido, u otro estado solo si el cliente lo aceptó
        // (aceptaOtrosEstados). Sin `dia`: no pasa por el tope diario ni toca respuestasDiarias.
        // El yonke no puede mandar creadoPorAdmin (respuestaPedidoValida no lo acepta).
        function sugerirYonkeClienteHabilitado() {
          return pedidosClientesHabilitados()
            && get(/databases/$(database)/documents/config/pedidosClientes).data.get('sugerirYonkeAdmin', false) == true;
        }
        function respuestaPedidoAdminValida() {
          let d = request.resource.data;
          return d.keys().hasOnly(['yonkeId', 'yonkeNombre', 'tieneLaPieza', 'precioATratar', 'nota', 'whatsapp', 'creadoAt', 'expiraAt', 'creadoPorAdmin', 'creadoPorAdminUid', 'evidenciaId'])
            && d.yonkeId == yonkeId
            && d.yonkeNombre is string && d.yonkeNombre.size() >= 1 && d.yonkeNombre.size() <= 100
            && d.whatsapp is string
            && d.nota is string && d.nota.size() <= 200
            && d.creadoAt == request.time
            && d.tieneLaPieza == true
            // Mecanix nunca publica un precio capturado por el admin: siempre "precio a tratar", sin
            // el campo precio (no está en el hasOnly de arriba, con ningún valor).
            && d.precioATratar == true
            && d.creadoPorAdmin == true
            && d.creadoPorAdminUid == request.auth.uid
            && (!('evidenciaId' in d) || evidenciaDeEstaRespuesta(d.evidenciaId, 'pedidosClientes', pedidoId, yonkeId));
        }
        allow create: if esAdmin()
                      && sugerirYonkeClienteHabilitado()
                      && pedidoPadre().estadoPedido == 'abierta'
                      && pedidoPadre().expiraAt > request.time
                      && exists(/databases/$(database)/documents/yonkes/$(yonkeId))
                      && get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.activo == true
                      && (get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.estado == pedidoPadre().estado
                          || pedidoPadre().get('aceptaOtrosEstados', false) == true)
                      && request.resource.data.yonkeNombre == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.nombre
                      && request.resource.data.whatsapp == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.whatsapp
                      && respuestaPedidoAdminValida()
                      && expiraIgualAlPedido();
        allow update: if false;
        // Admin, al reabrir el pedido en el mismo lote: solo el vencimiento, igual al nuevo del pedido.
        allow update: if esAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiraAt'])
                      && request.resource.data.expiraAt is timestamp
                      && request.resource.data.expiraAt >= getAfter(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data.expiraAt - duration.value(5, 'm')
                      && request.resource.data.expiraAt <= getAfter(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data.expiraAt + duration.value(5, 'm');
        allow delete: if esAdmin();
      }

      // WhatsApp del cliente y hash del código del enlace. Ningún yonke lo lee, nunca.
      match /privado/{docId} {
        function pedidoDespues() {
          return getAfter(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data;
        }
        allow read: if esAdmin() || esServicio();
        allow create: if esServicio()
                      && docId == 'contacto'
                      && request.resource.data.keys().hasOnly(['clienteWhatsapp', 'codigoHash', 'expiraAt'])
                      && request.resource.data.clienteWhatsapp is string
                      && request.resource.data.clienteWhatsapp.matches('^[0-9]{10}$')
                      && request.resource.data.codigoHash is string
                      && request.resource.data.codigoHash.matches('^[0-9a-f]{64}$')
                      && request.resource.data.expiraAt is timestamp
                      && request.resource.data.expiraAt >= pedidoDespues().expiraAt - duration.value(5, 'm')
                      && request.resource.data.expiraAt <= pedidoDespues().expiraAt + duration.value(5, 'm');
        allow update: if false;
        // Admin, al reabrir el pedido en el mismo lote: solo el vencimiento, igual al nuevo del pedido.
        allow update: if esAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiraAt'])
                      && request.resource.data.expiraAt is timestamp
                      && request.resource.data.expiraAt >= pedidoDespues().expiraAt - duration.value(5, 'm')
                      && request.resource.data.expiraAt <= pedidoDespues().expiraAt + duration.value(5, 'm');
        allow delete: if esAdmin();
      }
    }
    // Contadores de límite del pedido de clientes (por IP, por WhatsApp y de avisos al admin).
    // Propios: no se reutiliza busqueda_rate_limit. Solo el servicio los lee y escribe.
    match /pedidosClientesLimite/{docId} {
      allow read: if esServicio();
      allow create, update: if esServicio()
                            && request.resource.data.keys().hasOnly(['count', 'actualizado', 'expiraEn'])
                            && request.resource.data.count is int
                            && request.resource.data.count >= 1
                            && request.resource.data.actualizado is timestamp
                            && request.resource.data.expiraEn is timestamp;
      allow delete: if esAdmin();
    }

    // ---------- Códigos temporales de acceso (cuentas con WhatsApp) ----------
    // Solo el hash del código, con vencimiento corto. Únicamente el servidor los toca: ni el admin ni
    // el dueño pueden leerlos. Se borran al usarse; los no usados, por la política TTL de expiraAt.
    match /codigosTemporales/{clave} {
      allow read: if esServicio();
      allow create, update: if esServicio()
                            && request.resource.data.keys().hasOnly(['uid', 'codigoHash', 'expiraAt', 'creadoAt'])
                            && request.resource.data.uid is string && request.resource.data.uid.size() >= 1
                            && request.resource.data.codigoHash is string && request.resource.data.codigoHash.matches('^[0-9a-f]{64}$')
                            && request.resource.data.expiraAt is timestamp
                            && request.resource.data.expiraAt <= request.time + duration.value(25, 'h')
                            && request.resource.data.creadoAt == request.time;
      allow delete: if esServicio() || esAdmin();
    }

    // ---------- Resumen público de alertas (publico/alertasRecientes) ----------
    // Las ~30 alertas abiertas más recientes con SOLO pieza, vehículo, estado y fechas (nunca el
    // WhatsApp del cliente). No se lee desde el navegador: lo escriben el usuario de servicio (al
    // crear una alerta) y el admin (al cerrar, cancelar, reabrir o borrar), y lo lee el servidor
    // para /api/alertas-recientes y /api/pedidos-abiertos, que filtran por estado.
    match /publico/{docId} {
      allow read: if esServicio() || esAdmin();
      allow create, update: if (esServicio() || esAdmin())
                            && docId == 'alertasRecientes'
                            && request.resource.data.keys().hasOnly(['alertas', 'actualizadoAt'])
                            && request.resource.data.alertas is list
                            && request.resource.data.alertas.size() <= 30
                            && request.resource.data.actualizadoAt == request.time;
      allow delete: if esAdmin();
    }

    // ---------- Avisos en el dispositivo (notificaciones push) ----------
    // dispositivosPush/{yonkeId}_{sha256 del token}: un documento por dispositivo del yonke (puede
    // tener varios). Solo el dueño del yonke lo crea, lo lee y lo borra; el usuario de servicio lo
    // lee (para enviar) y lo borra (cuando Firebase rechaza el token); el admin lo lee y lo borra
    // (borrado en cascada). Nadie más. No depende de los términos ni del plan: los avisos son
    // parte de la sección de pedidos del plan Básico.
    match /dispositivosPush/{docId} {
      function dispositivoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['yonkeId', 'token', 'creadoAt'])
          && d.yonkeId is string && d.yonkeId.size() > 0 && d.yonkeId.size() <= 128
          && d.token is string && d.token.size() > 0 && d.token.size() <= 4096
          && d.creadoAt == request.time
          && docId.matches(d.yonkeId + '_[0-9a-f]{64}');
      }
      allow read, delete: if esAdmin() || esServicio() || esDuenoDelYonke(resource.data.yonkeId);
      allow create: if esDuenoDelYonke(request.resource.data.yonkeId) && dispositivoValido();
      // Yonke ligero: sus avisos de búsquedas activas, igual que un dueño.
      allow read, delete: if esYonkeLigero(resource.data.yonkeId);
      allow create: if esYonkeLigero(request.resource.data.yonkeId) && dispositivoValido();
      allow update: if esYonkeLigero(resource.data.yonkeId)
                    && request.resource.data.yonkeId == resource.data.yonkeId
                    && dispositivoValido();
      // Volver a activar en el mismo dispositivo (Firebase puede renovar el token): mismo dueño.
      allow update: if esDuenoDelYonke(resource.data.yonkeId)
                    && request.resource.data.yonkeId == resource.data.yonkeId
                    && dispositivoValido();
    }

    // ---------- Yonkes e inventario ----------
    match /yonkes/{yonkeId} {
      // Aceptación de términos (registro o aviso ACEPTO): versión vigente, hora del servidor y su
      // entrada del historial (aceptaciones/{versión}) en el mismo guardado.
      function aceptacionVigenteEnEsteGuardado() {
        return exists(terminosYonkesRef())
          && request.resource.data.aceptacionLegal.keys().hasOnly(['version', 'fecha'])
          && request.resource.data.aceptacionLegal.version == get(terminosYonkesRef()).data.version
          && request.resource.data.aceptacionLegal.fecha == request.time
          && existsAfter(/databases/$(database)/documents/yonkes/$(yonkeId)/aceptaciones/$(request.resource.data.aceptacionLegal.version));
      }
      // Página propia (promociones, "sobre nosotros", color y fondo) y datos fiscales de reciclaje:
      // cambios del plan Premium. El logo (branding.logoUrl) es del plan Básico.
      function brandingDe(datos) {
        return datos.get('branding', null) is map ? datos.branding : {};
      }
      function cambiaAlgoPremium() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['promoImagenes', 'sitio', 'fiscalReciclaje'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['branding'])
              && brandingDe(request.resource.data).diff(brandingDe(resource.data)).affectedKeys()
                   .difference(['logoUrl'].toSet()).size() > 0);
      }
      // Alta propia: exactamente lo que escribe panel/registro (aceptacionLegal, opcional, lo revisa
      // la cláusula de términos). Nace activo, básico y sin nada que ponga el admin: verificado,
      // enviosNacionales, subdominio, premiumHasta y demás quedan fuera por la lista cerrada.
      function altaPropiaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'direccion', 'estado', 'ciudad', 'telefono', 'whatsapp', 'metodosPago', 'plan', 'activo', 'fechaRegistro', 'ownerUid', 'aceptacionLegal'])
          && d.keys().hasAll(['nombre', 'direccion', 'estado', 'ciudad', 'telefono', 'whatsapp', 'metodosPago', 'plan', 'activo', 'fechaRegistro', 'ownerUid'])
          && d.ownerUid == request.auth.uid
          && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
          && d.direccion is string && d.direccion.size() >= 1 && d.direccion.size() <= 300
          && d.estado is string && d.estado.size() >= 1 && d.estado.size() <= 60
          && d.ciudad is string && d.ciudad.size() >= 1 && d.ciudad.size() <= 100
          && d.telefono is string && d.telefono.size() >= 1 && d.telefono.size() <= 40
          && d.whatsapp is string && d.whatsapp.size() >= 1 && d.whatsapp.size() <= 40
          && d.metodosPago is list && d.metodosPago.size() == 0
          && d.plan == 'freemium'
          && d.activo == true
          && d.fechaRegistro is timestamp;
      }
      // Las dos constancias legales (Aviso de Privacidad y declaración) van en el mismo guardado del alta.
      function constanciasDelAlta() {
        let v = request.resource.data.aceptacionLegal.version;
        return existsAfter(/databases/$(database)/documents/yonkes/$(yonkeId)/constancias/$('privacidad_' + v))
          && existsAfter(/databases/$(database)/documents/yonkes/$(yonkeId)/constancias/$('autorizacion_' + v));
      }
      allow read: if true;
      // Alta: admin, o un usuario que se registra y queda como dueño (ownerUid = su uid).
      // Un usuario que ya tiene cuenta de rol (yonke o taller) no puede crear yonkes nuevos.
      allow create: if esAdmin()
                    || (request.auth != null
                        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                        && altaPropiaValida()
                        && constanciasDelAlta()
                        // con config/terminosYonkes, se registra aceptando la versión vigente
                        && (!exists(terminosYonkesRef()) || aceptacionVigenteEnEsteGuardado()));
      allow update: if esAdmin()
                    || (esDuenoDelYonke(yonkeId)
                        // activo (Activar / Desactivar) y verificado solo los cambia el admin; el
                        // yonke nace activo al registrarse (create) y no puede reactivarse solo.
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['activo', 'verificado', 'entregaInmediata', 'capturaADomicilio', 'ultimaVisitaCaptura', 'subdominio', 'subdominioActivo', 'enviosNacionales', 'ownerUid', 'plan', 'premiumHasta'])
                        // si cambia promoImagenes, debe ser válido
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['promoImagenes'])
                            || promosValidas(request.resource.data.get('promoImagenes', []), yonkeId))
                        // si cambia sitio, debe ser válido
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sitio'])
                            || sitioValido(request.resource.data.get('sitio', {}), yonkeId))
                        // interruptor "Ver también alertas de otros estados con envío": solo true/false
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verAlertasOtrosEstados'])
                            || request.resource.data.verAlertasOtrosEstados is bool)
                        // NUEVO: si cambia branding, el fondo debe ser válido
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['branding'])
                            || brandingValido(request.resource.data.get('branding', null), yonkeId))
                        // Términos: sin la versión vigente solo se permite la marca automática de
                        // actividad y aceptar los términos; aceptacionLegal solo cambia al aceptar.
                        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaActividadAt'])
                            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aceptacionLegal'])
                                && aceptacionVigenteEnEsteGuardado())
                            || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['aceptacionLegal'])
                                && terminosYonkesVigentes(resource.data)))
                        // Plan: con límites activos, lo de la página propia y lo fiscal pide Premium vigente
                        && (premiumSiHaceFalta(resource.data) || !cambiaAlgoPremium()));
      // Yonke ligero. Alta: solo el servidor, con la bandera config/yonkesLigeros.habilitado, sin
      // ciudad ni nada de lo que pone el admin, y siempre con su aceptación en el mismo guardado.
      function altaLigeraValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'whatsapp', 'estado', 'tipoRegistro', 'plan', 'activo', 'fechaRegistro', 'ownerUid', 'aceptacionLegal'])
          && d.keys().hasAll(['nombre', 'whatsapp', 'estado', 'tipoRegistro', 'plan', 'activo', 'fechaRegistro', 'ownerUid', 'aceptacionLegal'])
          && d.tipoRegistro == 'ligero'
          && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 100
          && d.whatsapp is string && d.whatsapp.matches('^[0-9]{10}$')
          && d.estado is string && d.estado.size() >= 1 && d.estado.size() <= 60
          && d.plan == 'freemium'
          && d.activo == true
          && d.fechaRegistro == request.time
          && d.ownerUid is string && d.ownerUid.size() >= 1
          && !exists(/databases/$(database)/documents/usuarios/$(d.ownerUid))
          && d.aceptacionLegal.keys().hasOnly(['version', 'fecha'])
          && d.aceptacionLegal.version is string
          && d.aceptacionLegal.fecha == request.time
          && existsAfter(/databases/$(database)/documents/yonkes/$(yonkeId)/aceptaciones/$(d.aceptacionLegal.version))
          && (!exists(terminosYonkesRef()) || aceptacionVigenteEnEsteGuardado());
      }
      allow create: if esServicio() && yonkesLigerosHabilitados() && altaLigeraValida() && constanciasDelAlta();
      // "Completar mi registro": solo el servidor, y solo agrega los datos del negocio. Conserva el
      // mismo id, así que sus respuestas y su contador del día siguen ahí. No depende de la bandera.
      function completarLigeroValido() {
        let d = request.resource.data;
        return resource.data.get('tipoRegistro', '') == 'ligero'
          && d.diff(resource.data).affectedKeys().hasOnly(['tipoRegistro', 'direccion', 'ciudad', 'telefono', 'metodosPago'])
          && d.tipoRegistro == 'completo'
          && d.direccion is string && d.direccion.size() >= 1 && d.direccion.size() <= 300
          && d.ciudad is string && d.ciudad.size() >= 1 && d.ciudad.size() <= 100
          && d.telefono is string && d.telefono.size() >= 1 && d.telefono.size() <= 40
          && d.metodosPago is list && d.metodosPago.size() == 0;
      }
      allow update: if esServicio() && completarLigeroValido();
      // Términos nuevos: lo único de su ficha que el yonke ligero puede cambiar.
      allow update: if esYonkeLigero(yonkeId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aceptacionLegal'])
                    && aceptacionVigenteEnEsteGuardado();
      // Dueño que se registró: puede borrar su yonke solo mientras su usuario no exista (rollback)
      allow delete: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)));
      // Quién generó cada código temporal y cuándo. Lo escribe el servidor; solo el admin lo lee o borra.
      match /restablecimientos/{registroId} {
        allow read: if esAdmin();
        allow create: if esServicio()
                      && request.resource.data.keys().hasOnly(['adminUid', 'fecha'])
                      && request.resource.data.adminUid is string && request.resource.data.adminUid.size() >= 1
                      && request.resource.data.fecha == request.time;
        allow delete: if esServicio() || esAdmin();
      }
      // Constancias del Aviso de Privacidad y de la declaración de autorización ({tipo}_{versión}),
      // escritas junto con aceptacionLegal (misma versión y misma hora del servidor). Lista cerrada.
      // Nadie las modifica; solo el admin las borra.
      match /constancias/{constanciaId} {
        function constanciaValida() {
          let d = request.resource.data;
          let aceptacion = getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.aceptacionLegal;
          return d.version == aceptacion.version
            && d.fecha == request.time
            && aceptacion.fecha == request.time
            && constanciaId == d.tipo + '_' + d.version
            && ((d.tipo == 'privacidad' && d.keys().hasOnly(['tipo', 'version', 'fecha']))
                || (d.tipo == 'autorizacion' && d.keys().hasOnly(['tipo', 'version', 'fecha', 'texto'])
                    && d.texto is string && d.texto.size() >= 1 && d.texto.size() <= 500));
        }
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        // esDuenoDelYonke: al reaceptar, los yonkes que dio de alta el admin pueden no traer ownerUid.
        allow create: if request.auth != null
                      && (esDuenoDelYonke(yonkeId)
                          || getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.ownerUid == request.auth.uid)
                      && constanciaValida();
        allow create: if esServicio()
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.tipoRegistro == 'ligero'
                      && constanciaValida();
        allow delete: if esAdmin();
      }
      // Historial de aceptaciones: una entrada por versión, escrita junto con aceptacionLegal (misma
      // versión y misma hora del servidor). Nadie la modifica; solo el admin la borra.
      match /aceptaciones/{version} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow create: if request.auth != null
                      && (esDuenoDelYonke(yonkeId)
                          || getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.ownerUid == request.auth.uid)
                      && request.resource.data.keys().hasOnly(['version', 'fecha'])
                      && request.resource.data.version == version
                      && request.resource.data.fecha == request.time
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.aceptacionLegal.version == version
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.aceptacionLegal.fecha == request.time
                      && (!exists(terminosYonkesRef()) || version == get(terminosYonkesRef()).data.version);
        // Alta del yonke ligero: el servidor guarda la entrada junto con la ficha.
        allow create: if esServicio()
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.tipoRegistro == 'ligero'
                      && request.resource.data.keys().hasOnly(['version', 'fecha'])
                      && request.resource.data.version == version
                      && request.resource.data.fecha == request.time
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.aceptacionLegal.version == version
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.aceptacionLegal.fecha == request.time;
        allow update: if false;
        allow delete: if esAdmin();
      }
      // Inventario, reciclaje y notas de garantía: el dueño escribe solo con términos vigentes.
      match /vehiculos/{vehiculoId} {
        allow read: if true;
        allow create, delete: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
        allow update: if esAdmin()
                      || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && (
                            // no se toca vendidoAt (incluye vehículos que nunca lo tuvieron)
                            request.resource.data.get('vendidoAt', null) == resource.data.get('vendidoAt', null)
                            // reactivar: el campo se elimina
                            || !('vendidoAt' in request.resource.data)
                            // sacar del inventario: debe ser la hora del servidor
                            || request.resource.data.vendidoAt == request.time
                         ));
        match /piezas/{piezaId} {
          allow read: if true;
          allow write: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
        }
      }
      match /motores/{motorId} {
        allow read: if true;
        allow write: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
      }
      match /piezasSueltas/{piezaId} {
        allow read: if true;
        allow write: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
      }
      match /materialesReciclaje/{materialId} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow write: if esAdmin()
                     || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && yonkeConPremiumSiHaceFalta(yonkeId));
      }
      match /comprasReciclaje/{compraId} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow write: if esAdmin()
                     || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && yonkeConPremiumSiHaceFalta(yonkeId));
      }
      match /notasGarantia/{notaId} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow write: if esAdmin()
                     || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && yonkeConPremiumSiHaceFalta(yonkeId));
      }
      // ---------- Vehículos completos de las alertas (yonkes/{id}/vehiculosAlerta) ----------
      // Lectura pública (el buscador no tiene sesión), igual que vehiculos; sin datos del cliente.
      // Solo el dueño del yonke escribe (sin exigir términos, igual que responder alertas). Dar de
      // alta y renovar piden la bandera inventarioVehiculos; marcar vendida y quitar no (para que
      // siempre pueda limpiar su inventario). El vencimiento es "hoy + 30 días" con ±1 día de
      // holgura por el reloj del celular. unidades (sin el campo = 1) y ventasPiezas (conteo de
      // ventas por pieza) son opcionales: los registros de antes no los traen.
      match /vehiculosAlerta/{vehiculoId} {
        function vehiculoAlertaValido(d) {
          return d.keys().hasOnly(['yonkeId', 'marca', 'modelo', 'ano', 'unidades', 'ventasPiezas', 'piezasAlerta', 'piezasVendidas', 'creadoAt', 'venceEn', 'estado', 'renovadoAt'])
            && d.keys().hasAll(['yonkeId', 'marca', 'modelo', 'ano', 'piezasAlerta', 'piezasVendidas', 'creadoAt', 'venceEn', 'estado'])
            && d.yonkeId == yonkeId
            && d.marca is string && d.marca.size() >= 1 && d.marca.size() <= 60
            && d.modelo is string && d.modelo.size() >= 1 && d.modelo.size() <= 60
            && d.ano is int && d.ano >= 1950 && d.ano <= 2100
            && d.piezasAlerta is list && d.piezasAlerta.size() <= 100
            && d.piezasVendidas is list && d.piezasVendidas.size() <= 100
            && (!('unidades' in d) || (d.unidades is int && d.unidades >= 1 && d.unidades <= 100))
            && (!('ventasPiezas' in d) || (d.ventasPiezas is map && d.ventasPiezas.size() <= 100))
            && d.creadoAt is timestamp
            && d.venceEn is timestamp
            && d.estado == 'activo';
        }
        function venceEn30Dias(d) {
          return d.venceEn - request.time >= duration.value(29, 'd')
            && d.venceEn - request.time <= duration.value(31, 'd');
        }
        function unidadesAntes() {
          return resource.data.get('unidades', 1);
        }
        function sinCambiosDeIdentidad() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['yonkeId', 'marca', 'modelo', 'ano', 'creadoAt']);
        }
        allow read: if true;
        allow create: if esDuenoDelYonke(yonkeId)
                      && inventarioVehiculosHabilitado()
                      && vehiculoAlertaValido(request.resource.data)
                      && !('renovadoAt' in request.resource.data)
                      && request.resource.data.creadoAt == request.time
                      && venceEn30Dias(request.resource.data)
                      && request.resource.data.piezasVendidas.size() == 0
                      && request.resource.data.piezasAlerta.size() <= 1
                      && request.resource.data.get('unidades', 1) == 1
                      && request.resource.data.get('ventasPiezas', {}).size() == 0;
        allow update: if esDuenoDelYonke(yonkeId)
                      && vehiculoAlertaValido(request.resource.data)
                      && sinCambiosDeIdentidad()
                      && (
                        // "Ya lo vendí", "Deshacer" o pieza descontada por una alerta: solo las piezas.
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['piezasVendidas', 'piezasAlerta', 'ventasPiezas'])
                        // Renovar uno vencido (dijo "Sí" a "¿Tienes el vehículo completo?"): 30 días
                        // desde hoy, 1 unidad y las piezas vendidas en cero.
                        || (inventarioVehiculosHabilitado()
                            && resource.data.venceEn <= request.time
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['venceEn', 'estado', 'unidades', 'ventasPiezas', 'piezasVendidas', 'piezasAlerta', 'renovadoAt'])
                            && venceEn30Dias(request.resource.data)
                            && request.resource.data.piezasVendidas.size() == 0
                            && request.resource.data.get('unidades', 1) == 1
                            && request.resource.data.get('ventasPiezas', {}).size() == 0
                            && request.resource.data.renovadoAt == request.time)
                        // "+1 / Tengo otro igual" (vigente): una unidad más y 30 días desde hoy. Puede
                        // contar en el mismo guardado la venta de la alerta.
                        || (inventarioVehiculosHabilitado()
                            && resource.data.venceEn > request.time
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unidades', 'venceEn', 'renovadoAt', 'ventasPiezas', 'piezasVendidas', 'piezasAlerta'])
                            && request.resource.data.get('unidades', 1) == unidadesAntes() + 1
                            && venceEn30Dias(request.resource.data)
                            && request.resource.data.renovadoAt == request.time)
                        // "−1": una unidad menos, nunca menos de 1 (que no baje de las ventas ya
                        // marcadas lo revisa la app: las reglas no pueden recorrer el conteo).
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unidades', 'ventasPiezas', 'piezasVendidas', 'piezasAlerta'])
                            && request.resource.data.get('unidades', 1) == unidadesAntes() - 1)
                        // "Sigo manteniendo mis vehículos" (Premium vigente): solo los vigentes, solo
                        // la fecha; no toca las piezas vendidas.
                        || (inventarioVehiculosHabilitado()
                            && resource.data.venceEn > request.time
                            && premiumVigente(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['venceEn', 'renovadoAt'])
                            && venceEn30Dias(request.resource.data)
                            && request.resource.data.renovadoAt == request.time)
                      );
        allow update, delete: if esAdmin();
        allow delete: if esDuenoDelYonke(yonkeId);
      }
      // Contador de respuestas a alertas por día de Tijuana (límite del plan Básico). Solo sube de
      // 1 en 1 y nadie lo baja ni lo borra (salvo el admin), así el yonke no puede reiniciarlo.
      match /respuestasDiarias/{dia} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow create: if esDuenoDelYonke(yonkeId)
                      && diaTijuanaValido(dia)
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == 1;
        allow update: if esDuenoDelYonke(yonkeId)
                      && diaTijuanaValido(dia)
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == resource.data.count + 1;
        // Yonke ligero: mismo contador; solo sube de 1 en 1.
        allow read: if esYonkeLigero(yonkeId);
        allow create: if esYonkeLigero(yonkeId)
                      && diaTijuanaValido(dia)
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == 1;
        allow update: if esYonkeLigero(yonkeId)
                      && diaTijuanaValido(dia)
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == resource.data.count + 1;
        allow delete: if esAdmin();
      }
      // Datos privados del yonke (hoy: privado/contacto con su correo, ver src/lib/contactoPrivado.js).
      // Solo el admin los lee y escribe. (Los privado/contacto de pedidosClientes y solicitudesPiezas
      // son otras rutas, con sus propias reglas.)
      match /privado/{docId} {
        allow read, write: if esAdmin();
        // Correo opcional al completar el registro de un yonke ligero: solo el servidor.
        allow create: if esServicio()
                      && docId == 'contacto'
                      && request.resource.data.keys().hasOnly(['email'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 254
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.tipoRegistro == 'completo';
      }
      // ---------- NUEVO: contador de toques al botón de WhatsApp ----------
      match /contactosVehiculo/{docId} {
        allow read: if false;
        allow create: if request.resource.data.keys().hasOnly(['clics'])
                     && request.resource.data.clics == 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clics'])
                     && request.resource.data.clics == resource.data.clics + 1;
        allow delete: if esAdmin();
      }
    }
    // ---------- Operación ----------
    // Reservaciones: traen nombre y teléfono del cliente, así que solo las leen el admin y el yonke
    // dueño (antes la lectura era pública). Crear sigue abierto: el cliente reserva sin cuenta
    // desde la página principal y desde los subdominios (HomeClient.js, TenantPageClient.js) y
    // nunca vuelve a leer la reservación. El panel del yonke consulta con where('yonkeId', '==', ...)
    // -- sin ese filtro la consulta se rechaza entera.
    match /reservaciones/{reservaId} {
      allow read: if esAdmin() || esDuenoDelYonke(resource.data.yonkeId);
      allow create: if true;
      allow update: if esAdmin() || esDuenoDelYonke(resource.data.yonkeId);
      allow delete: if esAdmin();
    }
    // Ventas: traen el nombre del cliente y el monto, así que solo las leen el admin y el yonke
    // dueño (igual que reservaciones). /calificar usa ventasPublicas/{folio}. El panel del yonke
    // consulta con where('yonkeId', '==', ...) -- sin ese filtro la consulta se rechaza entera.
    match /ventas/{ventaId} {
      // Venta que genera confirmar una reservación pendiente de este mismo yonke: se permite aun
      // sin términos vigentes (atender reservaciones nunca se bloquea). La venta manual no.
      function ventaDeReservacion() {
        return request.resource.data.get('reservaId', null) is string
          && !('origen' in request.resource.data)
          && get(/databases/$(database)/documents/reservaciones/$(request.resource.data.reservaId)).data.yonkeId == request.resource.data.yonkeId
          && get(/databases/$(database)/documents/reservaciones/$(request.resource.data.reservaId)).data.estado == 'pendiente';
      }
      allow read: if esAdmin() || esDuenoDelYonke(resource.data.yonkeId);
      // Venta manual (sin reservación): términos vigentes y, con límites activos, Premium vigente.
      // La venta que genera confirmar una reservación sigue permitida en el plan Básico.
      allow create: if esAdmin()
                    || (esDuenoDelYonke(request.resource.data.yonkeId)
                        && (ventaDeReservacion()
                            || (yonkeConTerminosVigentes(request.resource.data.yonkeId)
                                && yonkeConPremiumSiHaceFalta(request.resource.data.yonkeId))));
      // CAMBIO: el dueño solo puede cancelar (cancelada + canceladaAt), sin borrar.
      // Sin términos vigentes solo cancela ventas que vienen de una reservación.
      allow update: if esAdmin()
                    || (esDuenoDelYonke(resource.data.yonkeId)
                        && (resource.data.get('reservaId', null) is string || yonkeConTerminosVigentes(resource.data.yonkeId))
                        && resource.data.get('cancelada', false) != true
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['cancelada', 'canceladaAt'])
                        && request.resource.data.cancelada == true
                        && request.resource.data.canceladaAt == request.time);
      allow delete: if esAdmin();
    }
    // ventasPublicas/{folio}: copia MÍNIMA y sin datos personales de una venta, para que /calificar
    // (sin sesión) encuentre el pedido por su folio sin leer `ventas` (ver src/lib/ventasPublicas.ts).
    // Cualquiera lee UNA copia si conoce el folio (get); nadie lista la colección salvo el admin.
    // Crea la copia el yonke dueño, junto con su venta (misma venta, mismo yonke, mismo folio), o el
    // admin (botón "Copiar ventas a públicas"). Solo el admin la cambia o la borra.
    match /ventasPublicas/{folio} {
      function copiaSinDatosPersonales() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ventaId', 'yonkeId', 'piezaVendida', 'vehiculo'])
          && d.keys().hasAll(['ventaId', 'yonkeId'])
          && d.ventaId is string && d.ventaId.size() > 0
          && d.yonkeId is string && d.yonkeId.size() > 0
          && (d.get('piezaVendida', null) == null || (d.piezaVendida is string && d.piezaVendida.size() <= 300))
          && (d.get('vehiculo', null) == null
              || (d.vehiculo is map && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'ano'])));
      }
      // La venta original (ya guardada o en el mismo lote) es de ese yonke y su folio normalizado
      // (trim + mayúsculas + "/" por "-", igual que idVentaPublica) es el id de la copia.
      function coincideConSuVenta() {
        let v = getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data;
        return v.yonkeId == request.resource.data.yonkeId
          && folio == v.numeroPedido.trim().upper().replace('/', '-');
      }
      allow get: if true;
      allow list: if esAdmin();
      // El admin copia en lotes de hasta 400: sin leer cada venta (cada lectura cuenta para el
      // límite de lecturas de las reglas), solo con la forma de la copia.
      allow create: if (esAdmin() && copiaSinDatosPersonales())
                    || (esDuenoDelYonke(request.resource.data.yonkeId) && copiaSinDatosPersonales() && coincideConSuVenta());
      allow update: if esAdmin() && copiaSinDatosPersonales();
      allow delete: if esAdmin();
    }
    match /calificaciones/{calificacionId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if esAdmin();
    }
    match /resenasPlataforma/{resenaId} {
      // Públicas solo las aprobadas (la página principal consulta where('aprobada', '==', true));
      // el admin las lee todas para moderarlas.
      allow read: if resource.data.get('aprobada', false) == true || esAdmin();
      allow create: if true;
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    // ---------- Comparador de compatibilidad de piezas (config/comparador) ----------
    // Todo lo escribe y lo lee el usuario de servicio del servidor (api/comparador); el navegador no
    // entra. Ningún documento lleva IP, identificador del navegador, uid ni VIN completo.
    // Contador diario por IP, navegador o cuenta (el ID lleva un hash, nunca el dato). TTL en expiraEn.
    match /comparadorLimite/{docId} {
      allow get: if esServicio();
      allow create, update: if esServicio()
                            && docId.matches('^(ip|disp|cuenta)_[0-9a-f]{32}_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.keys().hasOnly(['count', 'actualizado', 'expiraEn'])
                            && request.resource.data.count is int
                            && request.resource.data.count >= 0
                            && request.resource.data.count <= 1000
                            && request.resource.data.actualizado is timestamp
                            && request.resource.data.expiraEn is timestamp
                            && request.resource.data.expiraEn <= request.time + duration.value(3, 'd');
      allow list, delete: if false;
    }
    // Conteos del día (AAAA-MM-DD): solo números. El admin los lee en la consola.
    match /comparadorUso/{dia} {
      allow read: if esAdmin() || esServicio();
      allow create, update: if esServicio()
                            && dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.keys().hasOnly(['consultas', 'vinNuevos', 'vinCache', 'vinFallos', 'limiteAlcanzado',
                                                                     'iaBusquedas', 'iaTokensEntrada', 'iaTokensSalida', 'iaBusquedasWeb', 'actualizadoAt'])
                            && (!('iaBusquedas' in request.resource.data) || request.resource.data.iaBusquedas is int)
                            && (!('iaTokensEntrada' in request.resource.data) || request.resource.data.iaTokensEntrada is int)
                            && (!('iaTokensSalida' in request.resource.data) || request.resource.data.iaTokensSalida is int)
                            && (!('iaBusquedasWeb' in request.resource.data) || request.resource.data.iaBusquedasWeb is int)
                            && (!('consultas' in request.resource.data) || request.resource.data.consultas is int)
                            && (!('vinNuevos' in request.resource.data) || request.resource.data.vinNuevos is int)
                            && (!('vinCache' in request.resource.data) || request.resource.data.vinCache is int)
                            && (!('vinFallos' in request.resource.data) || request.resource.data.vinFallos is int)
                            && (!('limiteAlcanzado' in request.resource.data) || request.resource.data.limiteAlcanzado is int)
                            && request.resource.data.actualizadoAt is timestamp;
      allow delete: if false;
    }
    // Caché de NHTSA vPIC. El ID es la clave del VIN SIN número de serie ("1HGCM826*3A").
    match /vinDecodificado/{clave} {
      function textoCorto(d, k) { return d[k] is string && d[k].size() <= 80; }
      function vinCacheValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['marca', 'modelo', 'anio', 'motor', 'cilindrada', 'cilindros', 'combustible', 'transmision', 'traccion', 'carroceria', 'pais', 'planta', 'sinDatos', 'guardadoAt'])
          && textoCorto(d, 'marca') && textoCorto(d, 'modelo') && textoCorto(d, 'anio') && textoCorto(d, 'motor')
          && textoCorto(d, 'cilindrada') && textoCorto(d, 'cilindros') && textoCorto(d, 'combustible') && textoCorto(d, 'transmision')
          && textoCorto(d, 'traccion') && textoCorto(d, 'carroceria') && textoCorto(d, 'pais') && textoCorto(d, 'planta')
          && d.sinDatos is bool
          && d.guardadoAt is timestamp;
      }
      allow get: if esServicio() || esAdmin();
      allow list: if esAdmin();
      allow create, update: if esServicio()
                            && clave.matches('^[A-HJ-NPR-Z0-9]{8}[*][A-HJ-NPR-Z0-9]{2}$')
                            && vinCacheValido();
      allow delete: if esAdmin();
    }
    // Tabla propia de equivalencias. Por ahora la llena el admin (a mano en la consola); la lee el
    // servidor. clase 'equivalencia': partes = [números de parte equivalentes]; clase 'aplicacion':
    // parte -> vehículo (claveVin, o marca + modelo + anioDesde/anioHasta).
    match /equivalenciasPiezas/{id} {
      allow read: if esServicio() || esAdmin();
      allow create, update: if esAdmin()
                            && request.resource.data.keys().hasOnly(['clase', 'tipoPieza', 'partes', 'parte', 'claveVin', 'marca', 'modelo', 'anioDesde', 'anioHasta', 'nota', 'creadoAt'])
                            && request.resource.data.clase in ['equivalencia', 'aplicacion'];
      allow delete: if esAdmin();
    }
    // Sugerencias automáticas de equivalencia (búsqueda con IA, apagada por defecto). Las crea y
    // completa SOLO el servidor; el admin las lee y las marca aprobada o descartada. El cliente
    // nunca las lee. ID: tipo_PARTEA_PARTEB (pareja en orden).
    match /sugerenciasEquivalencia/{id} {
      allow get: if esServicio() || esAdmin();
      allow list: if esAdmin();
      allow create: if esServicio()
                    && id.matches('^[a-z]{2,20}_[A-Z0-9]{3,40}_[A-Z0-9]{3,40}$')
                    && request.resource.data.keys().hasOnly(['tipoPieza', 'partes', 'estado', 'creadoAt', 'actualizadoAt'])
                    && request.resource.data.tipoPieza is string
                    && request.resource.data.tipoPieza.size() <= 20
                    && request.resource.data.partes is list
                    && request.resource.data.partes.size() == 2
                    && request.resource.data.estado == 'buscando'
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.actualizadoAt == request.time;
      allow update: if (esServicio()
                        && resource.data.estado == 'buscando'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'equivalentes', 'confianza', 'resumen', 'partesRelacionadas', 'fuentes', 'tokensEntrada', 'tokensSalida', 'busquedas', 'actualizadoAt'])
                        && request.resource.data.estado in ['pendiente', 'sin_resultado', 'error']
                        && (request.resource.data.equivalentes == null || request.resource.data.equivalentes is bool)
                        && request.resource.data.confianza in ['alta', 'media', 'baja']
                        && request.resource.data.resumen is string
                        && request.resource.data.resumen.size() <= 600
                        && request.resource.data.partesRelacionadas is list
                        && request.resource.data.partesRelacionadas.size() <= 10
                        && request.resource.data.fuentes is list
                        && request.resource.data.fuentes.size() <= 5
                        && request.resource.data.tokensEntrada is int
                        && request.resource.data.tokensSalida is int
                        && request.resource.data.busquedas is int
                        && request.resource.data.actualizadoAt == request.time)
                    || (esAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revisadoAt'])
                        && request.resource.data.estado in ['aprobada', 'descartada']
                        && request.resource.data.revisadoAt == request.time);
      allow delete: if esAdmin();
    }
  }
}
