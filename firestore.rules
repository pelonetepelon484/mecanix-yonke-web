rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    function esDuenoDelYonke(yonkeId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId == yonkeId;
    }
    // ---------- Términos vigentes de yonkes (config/terminosYonkes) ----------
    // Si config/terminosYonkes NO existe, no se exige nada (así se apaga la exigencia). Si existe,
    // la versión aceptada del yonke (aceptacionLegal.version) debe ser su campo version. Un yonke
    // sin aceptacionLegal cuenta como "no aceptado".
    function terminosYonkesRef() {
      return /databases/$(database)/documents/config/terminosYonkes;
    }
    function terminosYonkesVigentes(datosYonke) {
      return !exists(terminosYonkesRef())
        || datosYonke.get('aceptacionLegal', {}).get('version', null) == get(terminosYonkesRef()).data.version;
    }
    function yonkeConTerminosVigentes(yonkeId) {
      return terminosYonkesVigentes(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data);
    }
    // ---------- Límites del plan Básico / Premium (config/planes) ----------
    // Interruptor: solo si config/planes.limitesActivos es exactamente true. Si el documento no
    // existe o vale otra cosa, todo sigue como antes (no se exige Premium en nada).
    // "Premium vigente" = plan 'premium' y (premiumHasta vacío o futuro): misma definición que
    // esPremiumVigente() en src/lib/planes.js (tests/rules/planes.rules.mjs compara ambas).
    function planesRef() {
      return /databases/$(database)/documents/config/planes;
    }
    function limitesPlanesActivos() {
      return exists(planesRef()) && get(planesRef()).data.get('limitesActivos', false) == true;
    }
    function premiumVigente(datosYonke) {
      return datosYonke.get('plan', null) == 'premium'
        && (datosYonke.get('premiumHasta', null) == null
            || datosYonke.premiumHasta == ''
            || datosYonke.premiumHasta > request.time);
    }
    function premiumSiHaceFalta(datosYonke) {
      return !limitesPlanesActivos() || premiumVigente(datosYonke);
    }
    function yonkeConPremiumSiHaceFalta(yonkeId) {
      return !limitesPlanesActivos() || premiumVigente(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data);
    }
    // ---------- NUEVO: pedido de piezas de talleres a yonkes ----------
    // Un yonke "activo de ese estado" para ver/responder solicitudes: mismo campo yonkes/{id}.estado
    // que usa estadoDeYonke() en el cliente (src/lib/estados.js) -- NO el mapeo de 3 letras que usa
    // esYonkeDeEseEstado()/busquedasResumen, que es para otra cosa.
    function yonkeActivoDeEseEstado(estado) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId != null &&
        exists(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)) &&
        get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data.activo == true &&
        get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data.estado == estado;
    }
    // ---------- NUEVO: demanda por estado para el panel del yonke ----------
    // Traduce el slug en español de yonkes/{id}.estado al código de 3 letras que usa
    // busquedasResumen.estadoGeografico -- debe mantenerse sincronizado a mano con
    // src/lib/estadoGeoMapping.ts si se agregan o cambian estados.
    function estadoGeoDe(estado) {
      return {
        'aguascalientes': 'agu', 'baja-california': 'bcn', 'baja-california-sur': 'bcs',
        'campeche': 'cam', 'cdmx': 'cmx', 'chiapas': 'chp', 'chihuahua': 'chh',
        'coahuila': 'coa', 'colima': 'col', 'durango': 'dur', 'estado-de-mexico': 'mex',
        'guanajuato': 'gua', 'guerrero': 'gro', 'hidalgo': 'hid', 'jalisco': 'jal',
        'michoacan': 'mic', 'morelos': 'mor', 'nayarit': 'nay', 'nuevo-leon': 'nle',
        'oaxaca': 'oax', 'puebla': 'pue', 'queretaro': 'que', 'quintana-roo': 'roo',
        'san-luis-potosi': 'slp', 'sinaloa': 'sin', 'sonora': 'son', 'tabasco': 'tab',
        'tamaulipas': 'tam', 'tlaxcala': 'tla', 'veracruz': 'ver', 'yucatan': 'yuc',
        'zacatecas': 'zac',
      }.get(estado, null);
    }
    // Un yonke solo puede leer busquedasResumen de SU propio estado -- nunca de otro, ni aunque
    // arme la query a mano: yonkeId sale de usuarios/{uid} (nunca del cliente) y estado sale de
    // yonkes/{id}, ambos leídos server-side por la propia regla, no por lo que mande el request.
    function esYonkeDeEseEstado(estadoGeografico) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId != null &&
        exists(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)) &&
        estadoGeoDe(get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data.estado) == estadoGeografico;
    }
    // ---------- NUEVO: validación de promociones ----------
    function promoOk(x, yonkeId) {
      return x is map
        && x.keys().hasOnly(['url', 'titulo'])
        && x.url is string
        && x.url.matches('https://firebasestorage\\.googleapis\\.com/.*')
        && x.url.matches('.*branding%2F' + yonkeId + '%2Fpromos%2F.*')
        && x.titulo is string
        && x.titulo.size() <= 60
        && x.titulo.matches('.*\\S.*');
    }
    function promosValidas(p, yonkeId) {
      return p is list
        && p.size() <= 3
        && (p.size() < 1 || promoOk(p[0], yonkeId))
        && (p.size() < 2 || promoOk(p[1], yonkeId))
        && (p.size() < 3 || promoOk(p[2], yonkeId));
    }
    // ---------- NUEVO: validación de "Sobre nosotros" ----------
    function sobreNosotrosValido(s, yonkeId) {
      return s is map
        && s.keys().hasOnly(['texto', 'aniosExperiencia', 'direccion', 'horario', 'fotoUrl'])
        && s.texto is string && s.texto.size() <= 800
        && (!('aniosExperiencia' in s) || s.aniosExperiencia == null || s.aniosExperiencia is int)
        && (!('direccion' in s) || s.direccion is string)
        && (!('horario' in s) || s.horario is string)
        && (!('fotoUrl' in s) || s.fotoUrl == null ||
            (s.fotoUrl is string
             && s.fotoUrl.matches('https://firebasestorage\\.googleapis\\.com/.*')
             && s.fotoUrl.matches('.*branding%2F' + yonkeId + '%2Fsobre-nosotros%2F.*')));
    }
    function sitioValido(x, yonkeId) {
      return x is map
        && x.keys().hasOnly(['sobreNosotros'])
        && sobreNosotrosValido(x.sobreNosotros, yonkeId);
    }
    // ---------- NUEVO: validación de branding (fondo de la página) ----------
    function brandingValido(b, yonkeId) {
      return b == null
        || (b is map
            && (!('fondoUrl' in b) || b.fondoUrl == null
                || (b.fondoUrl is string
                    && b.fondoUrl.matches('https://firebasestorage\\.googleapis\\.com/.*')
                    && b.fondoUrl.matches('.*branding%2F' + yonkeId + '%2Ffondo%2F.*'))));
    }
    // ---------- Logs de búsqueda ----------
    match /busquedas/{docId} {
      allow create: if request.resource.data.keys().hasAll([
                         'textoOriginal', 'estado', 'numResultados', 'origen', 'fecha'
                       ])
                    && request.resource.data.textoOriginal is string
                    && request.resource.data.textoOriginal.size() > 0
                    && request.resource.data.textoOriginal.size() < 300
                    && request.resource.data.estado in [
                         'ok', 'sin_inventario', 'fuera_de_catalogo',
                         'parseo_parcial', 'no_interpretada', 'fuera_de_giro',
                         'numero_de_parte', 'marca_muy_general',
                         'pieza_sin_vehiculo'
                       ]
                    && request.resource.data.numResultados is int
                    && request.resource.data.numResultados >= 0
                    && request.resource.data.origen in ['web', 'whatsapp'];
      allow read, update, delete: if esAdmin();
    }
    // ---------- NUEVO: copia reducida de busquedas para el panel "Demanda" del yonke ----------
    // Solo campos sin datos de clientes ni de competencia (sin textoOriginal, sin yonkeIds) --
    // ver registrarBusqueda.js. El yonke lee esta colección directo desde el navegador; busquedas
    // (la completa) sigue siendo solo-admin arriba.
    match /busquedasResumen/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
                         'estadoGeografico', 'pieza', 'marca', 'modelo', 'anio',
                         'estado', 'conResultado', 'sinVehiculo', 'fecha'
                       ])
                    && request.resource.data.estadoGeografico is string
                    && request.resource.data.conResultado is bool
                    && request.resource.data.sinVehiculo is bool;
      allow read: if esAdmin()
                  || (esYonkeDeEseEstado(resource.data.estadoGeografico)
                      // Demanda es del plan Premium cuando config/planes.limitesActivos es true
                      && yonkeConPremiumSiHaceFalta(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId));
      allow update, delete: if esAdmin();
    }
    // Colecciones viejas: escritura pública (código legado), lectura solo admin
    match /busquedas_no_interpretadas/{docId} {
      allow read: if esAdmin();
      allow write: if true;
    }
    match /modelos_no_reconocidos/{docId} {
      allow read: if esAdmin();
      allow write: if true;
    }
    // Contactos que deja un cliente en una búsqueda sin resultado útil. Los crea /api/buscar
    // (persistirContactoSiExiste), que usa el SDK de cliente SIN sesión: por eso crear queda
    // abierto, pero solo con la forma exacta que manda esa ruta. Nadie más que el admin lee,
    // marca como atendido o borra (antes "allow write: if true" dejaba editar y borrar a cualquiera).
    match /busquedas_pendientes/{docId} {
      function pendienteValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['pieza', 'marca', 'modelo', 'anio', 'textoOriginal', 'estado', 'fecha', 'contacto', 'atendido'])
          && d.keys().hasAll(['textoOriginal', 'estado', 'fecha', 'contacto', 'atendido'])
          && d.textoOriginal is string && d.textoOriginal.size() <= 2000
          && d.estado in [
               'sin_inventario', 'fuera_de_catalogo', 'parseo_parcial', 'no_interpretada', 'fuera_de_giro',
               'numero_de_parte', 'marca_muy_general', 'pieza_sin_vehiculo'
             ]
          && d.fecha is timestamp
          && d.fecha > request.time - duration.value(1, 'h')
          && d.fecha < request.time + duration.value(1, 'h')
          && d.contacto is string && d.contacto.size() >= 1 && d.contacto.size() <= 200
          && d.atendido == false
          && (d.get('pieza', null) == null || (d.pieza is string && d.pieza.size() <= 200))
          && (d.get('marca', null) == null || (d.marca is string && d.marca.size() <= 100))
          && (d.get('modelo', null) == null || (d.modelo is string && d.modelo.size() <= 100))
          && (d.get('anio', null) == null || d.anio is int);
      }
      allow read, update, delete: if esAdmin();
      allow create: if pendienteValido();
    }
    // Contadores del límite de búsquedas por IP (src/app/lib/busqueda/rateLimit.js, también sin
    // sesión). Solo se puede crear un contador nuevo en 1 o sumarle exactamente 1: ya no se puede
    // reiniciar, inflar, borrar ni escribir otros campos. La lectura sigue cerrada como estaba.
    // OJO: con la lectura cerrada, la transacción de rateLimit.js falla (permission-denied) y
    // /api/buscar deja pasar la búsqueda, o sea que el límite NO se aplica. Abrir "get" aquí lo
    // encendería; es una decisión aparte (ver nota en la rama fix/reglas-privacidad).
    match /busqueda_rate_limit/{docId} {
      function contadorValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['count', 'actualizado', 'expiraEn'])
          && d.count is int
          && d.actualizado is timestamp
          && (!('expiraEn' in d) || d.expiraEn is timestamp);
      }
      allow read: if false;
      allow create: if docId.matches('^[0-9a-f]{32}_[0-9]+$')
                    && contadorValido()
                    && request.resource.data.count == 1;
      allow update: if contadorValido()
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
    // ---------- Config ----------
    match /config/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // ---------- Estados (expansión por estado) ----------
    match /estados/{estadoId} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // ---------- Usuarios ----------
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || esAdmin());
      // Alta propia de yonke: solo rol 'yonke', con los 4 campos del registro, y solo si el
      // yonke al que apunta tiene como dueño a este mismo uid (ownerUid lo pone el registro).
      allow create: if esAdmin()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && request.resource.data.rol == 'yonke'
                        && request.resource.data.keys().hasOnly(['rol', 'yonkeId', 'email', 'fechaRegistro'])
                        && get(/databases/$(database)/documents/yonkes/$(request.resource.data.yonkeId)).data.ownerUid == request.auth.uid)
                    // Alta propia de taller: solo rol 'taller', con 4 campos, apuntando a un taller cuyo dueño es este uid
                    || (request.auth != null
                        && request.auth.uid == userId
                        && request.resource.data.rol == 'taller'
                        && request.resource.data.keys().hasOnly(['rol', 'tallerId', 'email', 'fechaRegistro'])
                        && request.resource.data.tallerId is string
                        && get(/databases/$(database)/documents/talleres/$(request.resource.data.tallerId)).data.ownerUid == request.auth.uid);
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }
    // ---------- Talleres (cuenta de taller, separada de yonkes) ----------
    // Un taller nace SIN aceptar (aceptacionVersion vacía). Su primera aceptación se registra
    // justo después, en un lote con su entrada del historial.
    match /talleres/{tallerId} {
      function tallerValido() {
        return request.resource.data.keys().hasOnly(['nombre', 'whatsapp', 'ciudad', 'logoUrl', 'ownerUid', 'activo', 'creadoAt', 'aceptacionVersion', 'avisoPrivacidad'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 100
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.matches('^[0-9]{10}$')
          && request.resource.data.ciudad is string
          && request.resource.data.ciudad.size() >= 2 && request.resource.data.ciudad.size() <= 100
          && request.resource.data.logoUrl is string
          && request.resource.data.aceptacionVersion is string
          && request.resource.data.aceptacionVersion.size() <= 40
          && request.resource.data.avisoPrivacidad is map
          && request.resource.data.avisoPrivacidad.keys().hasOnly(['modo', 'versionPlantilla', 'fecha'])
          && request.resource.data.avisoPrivacidad.modo == 'generado'
          && request.resource.data.avisoPrivacidad.versionPlantilla is string
          && request.resource.data.avisoPrivacidad.versionPlantilla.size() <= 40
          && request.resource.data.avisoPrivacidad.fecha is timestamp;
      }
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || esAdmin());
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.activo == true
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.aceptacionVersion == ''
                    && request.resource.data.avisoPrivacidad.versionPlantilla == get(/databases/$(database)/documents/config/cotizaciones).data.avisoTallerVersion
                    && request.resource.data.avisoPrivacidad.fecha == request.time
                    && tallerValido();
      allow update: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.activo == resource.data.activo
                        && request.resource.data.creadoAt == resource.data.creadoAt
                        // El dueño NO puede cambiar su aviso de privacidad
                        && request.resource.data.avisoPrivacidad == resource.data.avisoPrivacidad
                        && tallerValido()
                        && (
                          // Sin cambio de versión aceptada
                          request.resource.data.aceptacionVersion == resource.data.aceptacionVersion
                          // O aceptar la versión vigente, con su entrada en el historial en el mismo lote
                          || (request.resource.data.aceptacionVersion == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
                              && existsAfter(/databases/$(database)/documents/talleres/$(tallerId)/aceptaciones/$(request.resource.data.aceptacionVersion)))
                        ));
      // Dueño: solo borra mientras su usuario no exista (rollback). Admin siempre.
      allow delete: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)));

      // Historial de aceptaciones: una entrada por versión. Nadie la modifica ni la borra desde las reglas.
      match /aceptaciones/{version} {
        allow read: if request.auth != null
                    && (esAdmin() || get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid);
        allow create: if request.auth != null
                      && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['version', 'fecha'])
                      && request.resource.data.version == version
                      && version == get(/databases/$(database)/documents/config/cotizaciones).data.terminosVersion
                      && request.resource.data.fecha == request.time;
        allow update: if false;
        allow delete: if esAdmin();
      }
    }

    // ---------- Cotizaciones del taller (subcolección de cada taller) ----------
    // Cotización = datos y total en centavos. Renglones = subcolección 0..19.
    // Retención: expiraAt = creadoAt + 88 días (fijado por el sistema, no cambia).
    // Config: config/cotizaciones (versión de términos y bandera de datos del cliente).
    // Si ese documento no existe, get() falla y la regla DENIEGA crear y editar.
    match /talleres/{tallerId}/cotizaciones/{cotizacionId} {
      function esDuenoDelTaller() {
        return request.auth != null
          && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid;
      }
      function tallerActivoDeDueno() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        return request.auth != null && t.ownerUid == request.auth.uid && t.activo == true;
      }
      function versionVigente() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        let c = get(/databases/$(database)/documents/config/cotizaciones).data;
        return t.aceptacionVersion == c.terminosVersion;
      }
      // Datos del cliente solo si la bandera está encendida; si no, cliente vacío y sin placas
      function datosClienteOk() {
        let c = get(/databases/$(database)/documents/config/cotizaciones).data;
        let d = request.resource.data;
        return c.datosClienteHabilitados == true
          || (d.cliente == {} && !('placas' in d.vehiculo));
      }
      function cotizacionValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tallerId', 'estado', 'archivada', 'cliente', 'vehiculo', 'observaciones', 'vigenciaDias', 'totalCentavos', 'numRenglones', 'creadoAt', 'actualizadoAt', 'expiraAt', 'avisoVersion'])
          && d.tallerId == tallerId
          && d.estado in ['borrador', 'enviada', 'cerrada']
          && d.archivada is bool
          && d.cliente is map
          && d.cliente.keys().hasOnly(['nombre', 'telefono'])
          && (!('nombre' in d.cliente) || (d.cliente.nombre is string && d.cliente.nombre.size() <= 100))
          && (!('telefono' in d.cliente) || (d.cliente.telefono is string && d.cliente.telefono.matches('^[0-9 +()-]{0,20}$')))
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'placas', 'kilometraje'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && (!('placas' in d.vehiculo) || (d.vehiculo.placas is string && d.vehiculo.placas.size() <= 12))
          && (!('kilometraje' in d.vehiculo) || (d.vehiculo.kilometraje is int && d.vehiculo.kilometraje >= 0 && d.vehiculo.kilometraje <= 2000000))
          && d.numRenglones is int && d.numRenglones >= 1 && d.numRenglones <= 20
          && d.totalCentavos is int && d.totalCentavos >= 0 && d.totalCentavos <= 2000000000
          && d.observaciones is string && d.observaciones.size() <= 1000
          && d.vigenciaDias is int && d.vigenciaDias >= 1 && d.vigenciaDias <= 60
          && d.expiraAt is timestamp
          && d.avisoVersion is string && d.avisoVersion.size() <= 40
          && datosClienteOk();
      }

      allow read: if esAdmin() || esDuenoDelTaller();

      allow create: if tallerActivoDeDueno()
                    && versionVigente()
                    && cotizacionId.matches('^[A-Z0-9-]{8,20}$')
                    && cotizacionValida()
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.actualizadoAt == request.time
                    && request.resource.data.expiraAt - request.time >= duration.value(88, 'd') - duration.value(5, 'm')
                    && request.resource.data.expiraAt - request.time <= duration.value(88, 'd') + duration.value(5, 'm')
                    && request.resource.data.avisoVersion == get(/databases/$(database)/documents/talleres/$(tallerId)).data.avisoPrivacidad.versionPlantilla;

      allow update: if (
                        // A) "Quitar datos del cliente": dueño ACTIVO y con términos VIGENTES (decisión del
                        //    abogado: sin términos vigentes solo se ve, reimprime y descarga). SOLO vaciar
                        //    cliente y quitar placas; aunque la cotización esté vencida.
                        (tallerActivoDeDueno()
                         && versionVigente()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente', 'vehiculo', 'actualizadoAt'])
                         && request.resource.data.cliente == {}
                         && request.resource.data.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'kilometraje'])
                         && request.resource.data.vehiculo.marca == resource.data.vehiculo.marca
                         && request.resource.data.vehiculo.modelo == resource.data.vehiculo.modelo
                         && request.resource.data.vehiculo.anio == resource.data.vehiculo.anio
                         && request.resource.data.vehiculo.get('kilometraje', null) == resource.data.vehiculo.get('kilometraje', null)
                         && request.resource.data.tallerId == resource.data.tallerId
                         && request.resource.data.estado == resource.data.estado
                         && request.resource.data.archivada == resource.data.archivada
                         && request.resource.data.totalCentavos == resource.data.totalCentavos
                         && request.resource.data.numRenglones == resource.data.numRenglones
                         && request.resource.data.creadoAt == resource.data.creadoAt
                         && request.resource.data.expiraAt == resource.data.expiraAt
                         && request.resource.data.avisoVersion == resource.data.avisoVersion
                         && request.resource.data.actualizadoAt == request.time)
                        // B) EDICIÓN NORMAL: taller activo, versión vigente, cotización no vencida
                        || (tallerActivoDeDueno()
                            && versionVigente()
                            && cotizacionValida()
                            && resource.data.expiraAt > request.time
                            && request.resource.data.creadoAt == resource.data.creadoAt
                            && request.resource.data.expiraAt == resource.data.expiraAt
                            && request.resource.data.avisoVersion == resource.data.avisoVersion
                            && request.resource.data.actualizadoAt == request.time)
                      );

      // Borrar la cotización completa (primero sus renglones): admin, o el dueño con taller activo y
      // términos vigentes (sin términos vigentes solo se ve, reimprime y descarga).
      allow delete: if esAdmin()
                    || (tallerActivoDeDueno() && versionVigente());

      match /renglones/{numero} {
        // Cotización padre tal como quedará después del lote (getAfter)
        function padre() {
          return getAfter(/databases/$(database)/documents/talleres/$(tallerId)/cotizaciones/$(cotizacionId)).data;
        }
        function renglonValido() {
          let r = request.resource.data;
          return r.keys().hasOnly(['tipo', 'descripcion', 'cantidad', 'precioUnitario', 'expiraAt'])
            && r.tipo in ['pieza', 'manoObra']
            && r.descripcion is string && r.descripcion.size() >= 1 && r.descripcion.size() <= 200
            && r.cantidad is int && r.cantidad >= 1 && r.cantidad <= 999
            && (r.precioUnitario is int || r.precioUnitario is float)
            && r.precioUnitario >= 0 && r.precioUnitario <= 1000000
            && r.expiraAt is timestamp;
        }

        allow read: if esAdmin() || esDuenoDelTaller();

        allow create: if tallerActivoDeDueno()
                      && versionVigente()
                      && numero.matches('^([0-9]|1[0-9])$')
                      && renglonValido()
                      && padre().expiraAt > request.time
                      && request.resource.data.expiraAt == padre().expiraAt;

        allow update: if tallerActivoDeDueno()
                      && versionVigente()
                      && numero.matches('^([0-9]|1[0-9])$')
                      && renglonValido()
                      && resource.data.expiraAt > request.time
                      && request.resource.data.expiraAt == resource.data.expiraAt
                      && request.resource.data.expiraAt == padre().expiraAt;

        // Quitar renglones (al editar o al eliminar la cotización) exige taller activo y términos
        // vigentes; el admin siempre puede
        allow delete: if esAdmin()
                      || (tallerActivoDeDueno() && versionVigente());
      }
    }

    // ---------- Órdenes de servicio del taller (etapa 1) ----------
    // talleres/{tallerId}/ordenes/{folio}: trabajos y piezas DENTRO de la orden (máximo 20 de cada uno).
    // Bandera: config/ordenes { habilitado, datosClienteHabilitados, avisoOrdenVersion }. Sin ese
    // documento, get() falla y la regla DENIEGA crear y editar (falla cerrada).
    // Términos vigentes: la misma versión de siempre (config/cotizaciones.terminosVersion).
    // Borrado (TTL sobre expiraAt), con margen de 5 min por el reloj del celular:
    //  - sin entregar: expiraAt = hora del guardado + 88 días (se recalcula en cada guardado);
    //  - al entregar: fechaEntrega = hora del servidor y expiraAt = fechaEntrega + garantiaDias + 8 días;
    //  - ya entregada: fechaEntrega no cambia; expiraAt tampoco, salvo que cambie garantiaDias.
    match /talleres/{tallerId}/ordenes/{ordenId} {
      function esDuenoDelTaller() {
        return request.auth != null
          && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid;
      }
      function tallerActivoDeDueno() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        return request.auth != null && t.ownerUid == request.auth.uid && t.activo == true;
      }
      function versionVigente() {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        let c = get(/databases/$(database)/documents/config/cotizaciones).data;
        return t.aceptacionVersion == c.terminosVersion;
      }
      function ordenesHabilitadas() {
        return get(/databases/$(database)/documents/config/ordenes).data.habilitado == true;
      }
      // Datos del cliente solo si la bandera está encendida Y la orden tiene la versión de aviso
      // vigente (config/ordenes.avisoOrdenVersion). Las órdenes viejas (p. ej. aviso-orden-0, sin
      // aviso entregado) nunca pueden llevar nombre, teléfono ni placas. Si no, cliente vacío y sin placas.
      function datosClienteOk() {
        let c = get(/databases/$(database)/documents/config/ordenes).data;
        let d = request.resource.data;
        return (c.datosClienteHabilitados == true && d.avisoVersion == c.avisoOrdenVersion)
          || (d.cliente == {} && !('placas' in d.vehiculo));
      }
      function textoOk(v, max) {
        return v is string && v.size() <= max;
      }
      // IMPORTANTE: trabajos y piezas se revisan aquí SOLO como listas de máximo 20, NO renglón por
      // renglón. Firestore corta cada evaluación de reglas a 1,000 revisiones ("maximum of 1000
      // expressions"): revisar los campos de 40 renglones (20 + 20) lo rebasa y Firestore RECHAZA la
      // orden, incluso una entregada con pocos renglones queda al borde (confirmado en el emulador).
      // La revisión de cada renglón (descripción 1-200, cantidad 1-999, precio 0-1,000,000) la hace
      // la app antes de guardar (src/lib/ordenes.ts, validarOrden), y la pantalla y el PDF los tratan
      // como texto plano y toleran renglones mal formados. Lo peor que puede pasar es que un taller
      // que manipule su propia app guarde un renglón raro en SU orden, que solo ve él (y Firestore
      // limita cada documento a 1 MB). NO agregar aquí revisión por renglón sin medir el límite.
      function listaOk(l) {
        return l is list && l.size() <= 20;
      }
      function ordenValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tallerId', 'estado', 'cliente', 'vehiculo', 'fallaReportada', 'observaciones', 'estadoRecepcion', 'pertenencias', 'trabajos', 'piezas', 'totalCentavos', 'creadoAt', 'actualizadoAt', 'expiraAt', 'avisoVersion', 'garantiaDias', 'fechaEntrega'])
          && d.keys().hasAll(['tallerId', 'estado', 'cliente', 'vehiculo', 'fallaReportada', 'observaciones', 'estadoRecepcion', 'pertenencias', 'trabajos', 'piezas', 'totalCentavos', 'creadoAt', 'actualizadoAt', 'expiraAt', 'avisoVersion'])
          && d.tallerId == tallerId
          && d.estado in ['recibido', 'diagnostico', 'esperandoPiezas', 'reparacion', 'listo', 'entregado']
          && d.cliente is map
          && d.cliente.keys().hasOnly(['nombre', 'telefono'])
          && (!('nombre' in d.cliente) || (d.cliente.nombre is string && d.cliente.nombre.size() <= 100))
          && (!('telefono' in d.cliente) || (d.cliente.telefono is string && d.cliente.telefono.matches('^[0-9 +()-]{0,20}$')))
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'placas', 'kilometraje'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && (!('placas' in d.vehiculo) || (d.vehiculo.placas is string && d.vehiculo.placas.size() <= 12))
          && (!('kilometraje' in d.vehiculo) || (d.vehiculo.kilometraje is int && d.vehiculo.kilometraje >= 0 && d.vehiculo.kilometraje <= 2000000))
          && textoOk(d.fallaReportada, 1000)
          && textoOk(d.observaciones, 1000)
          && textoOk(d.estadoRecepcion, 500)
          && textoOk(d.pertenencias, 500)
          && listaOk(d.trabajos)
          && listaOk(d.piezas)
          && d.totalCentavos is int && d.totalCentavos >= 0 && d.totalCentavos <= 4000000000
          && d.expiraAt is timestamp
          && d.avisoVersion is string && d.avisoVersion.size() <= 40
          // Entregada: garantía de 0 a 365 días y fecha de entrega. Si no, ninguna de las dos.
          && (d.estado == 'entregado'
                ? (d.garantiaDias is int && d.garantiaDias >= 0 && d.garantiaDias <= 365 && d.fechaEntrega is timestamp)
                : (!('garantiaDias' in d) && !('fechaEntrega' in d)))
          && datosClienteOk();
      }
      function cerca(t, objetivo) {
        return t >= objetivo - duration.value(5, 'm') && t <= objetivo + duration.value(5, 'm');
      }
      // Fecha de borrado al crear
      function expiraAlCrear() {
        let d = request.resource.data;
        return d.estado == 'entregado'
          ? (d.fechaEntrega == request.time && cerca(d.expiraAt, request.time + duration.value(d.garantiaDias + 8, 'd')))
          : cerca(d.expiraAt, request.time + duration.value(88, 'd'));
      }
      // Fecha de borrado al editar
      function expiraAlEditar() {
        let d = request.resource.data;
        let r = resource.data;
        return d.estado != 'entregado'
          // Sin entregar (o regresa de entregada): 88 días desde este guardado
          ? cerca(d.expiraAt, request.time + duration.value(88, 'd'))
          : (r.estado != 'entregado'
              // Se entrega ahora
              ? (d.fechaEntrega == request.time && cerca(d.expiraAt, request.time + duration.value(d.garantiaDias + 8, 'd')))
              // Ya estaba entregada: misma fecha de entrega; el borrado solo cambia si cambió la garantía
              : (d.fechaEntrega == r.fechaEntrega
                  && (d.garantiaDias == r.garantiaDias
                        ? d.expiraAt == r.expiraAt
                        : cerca(d.expiraAt, r.fechaEntrega + duration.value(d.garantiaDias + 8, 'd')))));
      }

      allow read: if esAdmin() || esDuenoDelTaller();

      allow create: if tallerActivoDeDueno()
                    && versionVigente()
                    && ordenesHabilitadas()
                    && ordenId.matches('^O[0-9]{6}-[A-Z0-9]{4}$')
                    && ordenValida()
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.actualizadoAt == request.time
                    && expiraAlCrear()
                    && request.resource.data.avisoVersion == get(/databases/$(database)/documents/config/ordenes).data.avisoOrdenVersion;

      allow update: if (
                        // A) "Quitar datos del cliente": dueño ACTIVO y con términos VIGENTES. SOLO vaciar
                        //    cliente y quitar placas. No lee config/ordenes: funciona aunque la función se
                        //    apague. No mueve la fecha de borrado.
                        (tallerActivoDeDueno()
                         && versionVigente()
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente', 'vehiculo', 'actualizadoAt'])
                         && request.resource.data.cliente == {}
                         && request.resource.data.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio', 'kilometraje'])
                         && request.resource.data.vehiculo.marca == resource.data.vehiculo.marca
                         && request.resource.data.vehiculo.modelo == resource.data.vehiculo.modelo
                         && request.resource.data.vehiculo.anio == resource.data.vehiculo.anio
                         && request.resource.data.vehiculo.get('kilometraje', null) == resource.data.vehiculo.get('kilometraje', null)
                         && request.resource.data.actualizadoAt == request.time)
                        // B) EDICIÓN NORMAL: taller activo, versión vigente, función encendida, orden no vencida
                        || (tallerActivoDeDueno()
                            && versionVigente()
                            && ordenesHabilitadas()
                            && ordenValida()
                            && resource.data.expiraAt > request.time
                            && request.resource.data.creadoAt == resource.data.creadoAt
                            && request.resource.data.avisoVersion == resource.data.avisoVersion
                            && request.resource.data.actualizadoAt == request.time
                            && expiraAlEditar())
                      );

      // Borrar: admin, o el dueño con taller activo y términos vigentes.
      allow delete: if esAdmin()
                    || (tallerActivoDeDueno() && versionVigente());
    }

    // ---------- Pedido de piezas de talleres a yonkes ----------
    // El taller publica una solicitud (vehículo + pieza, SIN datos del cliente final); Mecanix
    // decide a qué yonkes avisar por estado (fuera de las reglas); cada yonke responde una sola
    // vez (subcolección respuestas/{yonkeId}, sin editar ni borrar); el taller elige a uno
    // (yonkeElegido) y la solicitud pasa a 'cerrada'. El WhatsApp del taller vive en una
    // subcolección privada que solo lee el taller dueño, el admin y el yonke elegido -- así
    // ningún otro yonke lo ve. Retención: expiraAt = creadoAt + 5 días (igual en los tres
    // documentos, para que la política TTL pueda borrar los tres por colección).
    // Falla cerrada: toda creación exige que exista config/solicitudesPiezas con habilitado == true.
    match /solicitudesPiezas/{solicitudId} {
      function esDuenoDeEseTaller(tallerId) {
        return request.auth != null
          && get(/databases/$(database)/documents/talleres/$(tallerId)).data.ownerUid == request.auth.uid;
      }
      function tallerActivoDeEseTaller(tallerId) {
        let t = get(/databases/$(database)/documents/talleres/$(tallerId)).data;
        return request.auth != null && t.ownerUid == request.auth.uid && t.activo == true;
      }
      function solicitudesHabilitadas() {
        return exists(/databases/$(database)/documents/config/solicitudesPiezas)
          && get(/databases/$(database)/documents/config/solicitudesPiezas).data.habilitado == true;
      }
      function solicitudValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tallerId', 'tallerNombre', 'vehiculo', 'pieza', 'nota', 'estado', 'estadoSolicitud', 'yonkeElegido', 'creadoAt', 'expiraAt'])
          && d.tallerId is string
          && d.tallerNombre is string && d.tallerNombre.size() >= 1 && d.tallerNombre.size() <= 100
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && d.pieza is string && d.pieza.size() >= 1 && d.pieza.size() <= 100
          && d.nota is string && d.nota.size() <= 200
          && d.estado is string
          && d.creadoAt is timestamp
          && d.expiraAt is timestamp;
      }

      allow read: if esAdmin()
                  || esDuenoDeEseTaller(resource.data.tallerId)
                  || (resource.data.yonkeElegido != null && esDuenoDelYonke(resource.data.yonkeElegido))
                  || (resource.data.estadoSolicitud == 'abierta' && yonkeActivoDeEseEstado(resource.data.estado));

      allow create: if solicitudesHabilitadas()
                    && tallerActivoDeEseTaller(request.resource.data.tallerId)
                    && request.resource.data.tallerNombre == get(/databases/$(database)/documents/talleres/$(request.resource.data.tallerId)).data.nombre
                    && request.resource.data.estadoSolicitud == 'abierta'
                    && request.resource.data.yonkeElegido == null
                    && request.resource.data.creadoAt == request.time
                    && request.resource.data.expiraAt - request.time >= duration.value(5, 'd') - duration.value(5, 'm')
                    && request.resource.data.expiraAt - request.time <= duration.value(5, 'd') + duration.value(5, 'm')
                    && solicitudValida();

      // Elegir: el taller dueño pasa de 'abierta'+sin elegir a 'cerrada' con un yonke que
      // respondió que SÍ la tiene. Cancelar: el taller dueño pasa de 'abierta' a 'cancelada'.
      // Ningún otro campo cambia en ninguno de los dos casos.
      allow update: if esDuenoDeEseTaller(resource.data.tallerId)
                    && (
                      (resource.data.estadoSolicitud == 'abierta'
                       && resource.data.yonkeElegido == null
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoSolicitud', 'yonkeElegido'])
                       && request.resource.data.estadoSolicitud == 'cerrada'
                       && request.resource.data.yonkeElegido is string
                       && get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)/respuestas/$(request.resource.data.yonkeElegido)).data.tieneLaPieza == true)
                      || (resource.data.estadoSolicitud == 'abierta'
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoSolicitud'])
                          && request.resource.data.estadoSolicitud == 'cancelada')
                    );

      allow delete: if esAdmin() || esDuenoDeEseTaller(resource.data.tallerId);

      // Una respuesta por yonke: no se edita ni se borra (allow update/delete: if false --
      // la ausencia de "update"/"delete" en la lista ya lo deniega por default, se deja explícito).
      match /respuestas/{yonkeId} {
        function solicitudPadre() {
          return get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data;
        }
        // OJO: expiraAt se valida en expiraOk(), NO aquí con "==" -- comparar con "==" un
        // timestamp de request.resource.data contra uno leído con get() de OTRO documento
        // revienta la evaluación de las reglas (error del emulador/motor, no un simple falso).
        // ">="/"<=" sí funcionan bien contra el mismo valor, por eso expiraOk() usa un rango
        // angosto (±5 min) en vez de una igualdad exacta.
        function respuestaValida() {
          let d = request.resource.data;
          return d.keys().hasOnly(['yonkeId', 'yonkeNombre', 'tieneLaPieza', 'precio', 'nota', 'whatsapp', 'creadoAt', 'expiraAt'])
            && d.yonkeId == yonkeId
            && d.yonkeNombre is string && d.yonkeNombre.size() >= 1 && d.yonkeNombre.size() <= 100
            && d.tieneLaPieza is bool
            && d.whatsapp is string
            && d.nota is string && d.nota.size() <= 200
            && d.creadoAt == request.time
            && (
              (d.tieneLaPieza == true && (d.precio is int || d.precio is float) && d.precio > 0 && d.precio <= 1000000)
              || (d.tieneLaPieza == false && !('precio' in d))
            );
        }
        function expiraOk() {
          let padre = get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data.expiraAt;
          return request.resource.data.expiraAt >= padre - duration.value(5, 'm')
            && request.resource.data.expiraAt <= padre + duration.value(5, 'm');
        }

        allow read: if esAdmin()
                    || esDuenoDeEseTaller(solicitudPadre().tallerId)
                    || esDuenoDelYonke(yonkeId);

        allow create: if solicitudesHabilitadas()
                      && esDuenoDelYonke(yonkeId)
                      && yonkeActivoDeEseEstado(solicitudPadre().estado)
                      && solicitudPadre().estadoSolicitud == 'abierta'
                      && request.resource.data.yonkeNombre == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.nombre
                      && request.resource.data.whatsapp == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.whatsapp
                      && respuestaValida()
                      && expiraOk();
        allow update: if false;
        allow delete: if esAdmin();
      }

      // Subcolección privada: solo el WhatsApp del taller. Se crea en el mismo lote que la
      // solicitud (getAfter), por eso usa tallerActivoDeEseTaller sobre el tallerId de ESE lote.
      match /privado/{docId} {
        function solicitudPadreDespues() {
          return getAfter(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data;
        }
        function solicitudPadre() {
          return get(/databases/$(database)/documents/solicitudesPiezas/$(solicitudId)).data;
        }
        allow read: if esAdmin()
                    || esDuenoDeEseTaller(solicitudPadre().tallerId)
                    || (solicitudPadre().yonkeElegido != null && esDuenoDelYonke(solicitudPadre().yonkeElegido));
        allow create: if docId == 'contacto'
                      && tallerActivoDeEseTaller(solicitudPadreDespues().tallerId)
                      && request.resource.data.keys().hasOnly(['tallerWhatsapp', 'expiraAt'])
                      && request.resource.data.tallerWhatsapp == get(/databases/$(database)/documents/talleres/$(solicitudPadreDespues().tallerId)).data.whatsapp
                      && request.resource.data.expiraAt == solicitudPadreDespues().expiraAt;
        allow update: if false;
        allow delete: if esAdmin() || esDuenoDeEseTaller(solicitudPadre().tallerId);
      }
    }

    // ---------- NUEVO: pedido de pieza de clientes sin cuenta ----------
    // El cliente NO escribe en Firestore: todo lo crea el servidor (/api/pedir-pieza) con un
    // usuario de servicio de Firebase Auth (usuarios/{uid}.rol == 'servicio', creado a mano por el
    // admin). El pedido solo trae vehículo, pieza y estado; el WhatsApp del cliente y el hash del
    // código del enlace viven en privado/contacto, que SOLO leen el admin y el servicio -- ningún
    // yonke. Los yonkes activos del estado ven el pedido y responden una sola vez (igual que en
    // solicitudesPiezas). Retención: expiraAt = creadoAt + 5 días en los tres documentos (TTL).
    // Falla cerrada: crear y responder exigen config/pedidosClientes con habilitado == true.
    function esServicio() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'servicio';
    }
    function pedidosClientesHabilitados() {
      return exists(/databases/$(database)/documents/config/pedidosClientes)
        && get(/databases/$(database)/documents/config/pedidosClientes).data.habilitado == true;
    }
    // ---------- Límite diario de respuestas a alertas (plan Básico) ----------
    // config/pedidosClientes.limiteRespuestasDiarias: solo un entero >= 1 lo activa. Sin el campo
    // no hay límite (como antes). Premium vigente nunca tiene límite. Con límite, la respuesta
    // trae `dia` (AAAAMMDD de Tijuana) y en el MISMO guardado sube 1 el contador
    // yonkes/{id}/respuestasDiarias/{dia}, que no puede pasar del límite. Tijuana es UTC-8 en
    // invierno y UTC-7 en verano: se acepta el día calculado con cualquiera de los dos (como mucho
    // una hora de holgura alrededor de la medianoche).
    function limiteRespuestasActivo() {
      return exists(/databases/$(database)/documents/config/pedidosClientes)
        && get(/databases/$(database)/documents/config/pedidosClientes).data.get('limiteRespuestasDiarias', null) is int
        && get(/databases/$(database)/documents/config/pedidosClientes).data.limiteRespuestasDiarias >= 1;
    }
    function diaDe(t) {
      return string(t.year() * 10000 + t.month() * 100 + t.day());
    }
    function diaTijuanaValido(dia) {
      return dia is string
        && (dia == diaDe(request.time - duration.value(8, 'h')) || dia == diaDe(request.time - duration.value(7, 'h')));
    }
    function contadorRespuestas(yonkeId, dia) {
      return /databases/$(database)/documents/yonkes/$(yonkeId)/respuestasDiarias/$(dia);
    }
    function respuestaDentroDelLimite(yonkeId) {
      return !limiteRespuestasActivo()
        || premiumVigente(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data)
        || ('dia' in request.resource.data
            && diaTijuanaValido(request.resource.data.dia)
            && getAfter(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count
                 <= get(/databases/$(database)/documents/config/pedidosClientes).data.limiteRespuestasDiarias
            && ((!exists(contadorRespuestas(yonkeId, request.resource.data.dia))
                 && getAfter(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count == 1)
                || (exists(contadorRespuestas(yonkeId, request.resource.data.dia))
                    && getAfter(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count
                         == get(contadorRespuestas(yonkeId, request.resource.data.dia)).data.count + 1)));
    }
    // Inventario de vehículos completos de las alertas: tercera bandera
    // config/pedidosClientes.inventarioVehiculos (además de la primera).
    function inventarioVehiculosHabilitado() {
      return pedidosClientesHabilitados()
        && get(/databases/$(database)/documents/config/pedidosClientes).data.get('inventarioVehiculos', false) == true;
    }
    // Alertas de otros estados: segunda bandera config/pedidosClientes.otrosEstados (además de la
    // primera). Apagada, todo funciona exactamente como antes.
    function otrosEstadosHabilitados() {
      return pedidosClientesHabilitados()
        && get(/databases/$(database)/documents/config/pedidosClientes).data.get('otrosEstados', false) == true;
    }
    // Yonke que puede ver y responder alertas de OTROS estados (las que el cliente marcó con
    // aceptaOtrosEstados): activo, Verificado y con envíos nacionales (estos dos solo los pone el
    // admin) y con su interruptor verAlertasOtrosEstados encendido. Todo sale de usuarios/{uid} y
    // yonkes/{id} leídos por la regla, nunca de lo que mande el navegador.
    function yonkeConEnvio(y) {
      return y.get('activo', false) == true
        && y.get('verificado', false) == true
        && y.get('enviosNacionales', false) == true
        && y.get('verAlertasOtrosEstados', false) == true;
    }
    function yonkeConEnvioAOtrosEstados() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'yonke' &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId != null &&
        exists(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)) &&
        yonkeConEnvio(get(/databases/$(database)/documents/yonkes/$(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.yonkeId)).data);
    }
    match /pedidosClientes/{pedidoId} {
      function pedidoClienteValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['vehiculo', 'pieza', 'estado', 'estadoPedido', 'creadoAt', 'expiraAt', 'aceptaOtrosEstados'])
          && d.keys().hasAll(['vehiculo', 'pieza', 'estado', 'estadoPedido', 'creadoAt', 'expiraAt'])
          // Opcional (las alertas de antes no lo traen = false). true solo con la segunda bandera.
          && (!('aceptaOtrosEstados' in d) || d.aceptaOtrosEstados is bool)
          && (d.get('aceptaOtrosEstados', false) == false || otrosEstadosHabilitados())
          && d.vehiculo is map
          && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'anio'])
          && d.vehiculo.marca is string && d.vehiculo.marca.size() >= 1 && d.vehiculo.marca.size() <= 60
          && d.vehiculo.modelo is string && d.vehiculo.modelo.size() >= 1 && d.vehiculo.modelo.size() <= 60
          && d.vehiculo.anio is int && d.vehiculo.anio >= 1950 && d.vehiculo.anio <= 2100
          && d.pieza is string && d.pieza.size() >= 1 && d.pieza.size() <= 100
          && d.estado is string && d.estado.size() >= 1 && d.estado.size() <= 60
          && d.estadoPedido == 'abierta'
          && d.creadoAt == request.time
          && d.expiraAt is timestamp
          && d.expiraAt - request.time >= duration.value(5, 'd') - duration.value(5, 'm')
          && d.expiraAt - request.time <= duration.value(5, 'd') + duration.value(5, 'm');
      }

      allow read: if esAdmin()
                  || esServicio()
                  || (resource.data.estadoPedido == 'abierta' && yonkeActivoDeEseEstado(resource.data.estado))
                  // Yonke de otro estado: solo alertas que lo aceptan (la consulta debe filtrar
                  // aceptaOtrosEstados == true y estadoPedido == 'abierta').
                  || (resource.data.estadoPedido == 'abierta'
                      && resource.data.aceptaOtrosEstados == true
                      && otrosEstadosHabilitados()
                      && yonkeConEnvioAOtrosEstados());
      allow create: if esServicio() && pedidosClientesHabilitados() && pedidoClienteValido();
      // El admin puede dar de baja un pedido (spam) o reabrirlo; nada más cambia.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoPedido'])
                    && request.resource.data.estadoPedido in ['abierta', 'cancelada'];
      // Admin (panel "Pedidos de piezas"): cerrar o cancelar (con la hora en cerradoAt, sin
      // tocar el vencimiento), o reabrir extendiendo el vencimiento 5 días desde hoy (±1 h por
      // el reloj de la computadora del admin). Ningún otro campo cambia.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoPedido', 'expiraAt', 'cerradoAt'])
                    && (
                      (request.resource.data.estadoPedido in ['cerrada', 'cancelada']
                       && request.resource.data.expiraAt == resource.data.expiraAt
                       && request.resource.data.cerradoAt == request.time)
                      || (request.resource.data.estadoPedido == 'abierta'
                          && !('cerradoAt' in request.resource.data)
                          && request.resource.data.expiraAt is timestamp
                          && request.resource.data.expiraAt - request.time >= duration.value(5, 'd') - duration.value(1, 'h')
                          && request.resource.data.expiraAt - request.time <= duration.value(5, 'd') + duration.value(1, 'h'))
                    );
      allow delete: if esAdmin();

      // Una respuesta por yonke: no se edita ni se borra. Solo la leen su yonke, el admin y el
      // servicio (que se la muestra al cliente) -- un yonke nunca ve las respuestas de otros.
      match /respuestas/{yonkeId} {
        function pedidoPadre() {
          return get(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data;
        }
        function respuestaPedidoValida() {
          let d = request.resource.data;
          // `dia`: solo cuando hay límite diario (ver respuestaDentroDelLimite).
          return d.keys().hasOnly(['yonkeId', 'yonkeNombre', 'tieneLaPieza', 'precio', 'nota', 'whatsapp', 'creadoAt', 'expiraAt', 'dia'])
            && (!('dia' in d) || diaTijuanaValido(d.dia))
            && d.yonkeId == yonkeId
            && d.yonkeNombre is string && d.yonkeNombre.size() >= 1 && d.yonkeNombre.size() <= 100
            && d.tieneLaPieza is bool
            && d.whatsapp is string
            && d.nota is string && d.nota.size() <= 200
            && d.creadoAt == request.time
            && (
              (d.tieneLaPieza == true && (d.precio is int || d.precio is float) && d.precio > 0 && d.precio <= 1000000)
              || (d.tieneLaPieza == false && !('precio' in d))
            );
        }
        // Rango de ±5 min contra el expiraAt del pedido (ver nota en solicitudesPiezas: "==" entre
        // timestamps de documentos distintos revienta la evaluación).
        function expiraIgualAlPedido() {
          let padre = pedidoPadre().expiraAt;
          return request.resource.data.expiraAt is timestamp
            && request.resource.data.expiraAt >= padre - duration.value(5, 'm')
            && request.resource.data.expiraAt <= padre + duration.value(5, 'm');
        }

        allow read: if esAdmin() || esServicio() || esDuenoDelYonke(yonkeId);
        allow create: if pedidosClientesHabilitados()
                      && esDuenoDelYonke(yonkeId)
                      && (yonkeActivoDeEseEstado(pedidoPadre().estado)
                          || (pedidoPadre().get('aceptaOtrosEstados', false) == true
                              && otrosEstadosHabilitados()
                              && yonkeConEnvioAOtrosEstados()))
                      && pedidoPadre().estadoPedido == 'abierta'
                      && pedidoPadre().expiraAt > request.time
                      && request.resource.data.yonkeNombre == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.nombre
                      && request.resource.data.whatsapp == get(/databases/$(database)/documents/yonkes/$(yonkeId)).data.whatsapp
                      && respuestaPedidoValida()
                      && expiraIgualAlPedido()
                      && respuestaDentroDelLimite(yonkeId);
        allow update: if false;
        // Admin, al reabrir el pedido en el mismo lote: solo el vencimiento, igual al nuevo del pedido.
        allow update: if esAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiraAt'])
                      && request.resource.data.expiraAt is timestamp
                      && request.resource.data.expiraAt >= getAfter(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data.expiraAt - duration.value(5, 'm')
                      && request.resource.data.expiraAt <= getAfter(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data.expiraAt + duration.value(5, 'm');
        allow delete: if esAdmin();
      }

      // WhatsApp del cliente y hash del código del enlace. Ningún yonke lo lee, nunca.
      match /privado/{docId} {
        function pedidoDespues() {
          return getAfter(/databases/$(database)/documents/pedidosClientes/$(pedidoId)).data;
        }
        allow read: if esAdmin() || esServicio();
        allow create: if esServicio()
                      && docId == 'contacto'
                      && request.resource.data.keys().hasOnly(['clienteWhatsapp', 'codigoHash', 'expiraAt'])
                      && request.resource.data.clienteWhatsapp is string
                      && request.resource.data.clienteWhatsapp.matches('^[0-9]{10}$')
                      && request.resource.data.codigoHash is string
                      && request.resource.data.codigoHash.matches('^[0-9a-f]{64}$')
                      && request.resource.data.expiraAt is timestamp
                      && request.resource.data.expiraAt >= pedidoDespues().expiraAt - duration.value(5, 'm')
                      && request.resource.data.expiraAt <= pedidoDespues().expiraAt + duration.value(5, 'm');
        allow update: if false;
        // Admin, al reabrir el pedido en el mismo lote: solo el vencimiento, igual al nuevo del pedido.
        allow update: if esAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiraAt'])
                      && request.resource.data.expiraAt is timestamp
                      && request.resource.data.expiraAt >= pedidoDespues().expiraAt - duration.value(5, 'm')
                      && request.resource.data.expiraAt <= pedidoDespues().expiraAt + duration.value(5, 'm');
        allow delete: if esAdmin();
      }
    }
    // Contadores de límite del pedido de clientes (por IP, por WhatsApp y de avisos al admin).
    // Propios: no se reutiliza busqueda_rate_limit. Solo el servicio los lee y escribe.
    match /pedidosClientesLimite/{docId} {
      allow read: if esServicio();
      allow create, update: if esServicio()
                            && request.resource.data.keys().hasOnly(['count', 'actualizado', 'expiraEn'])
                            && request.resource.data.count is int
                            && request.resource.data.count >= 1
                            && request.resource.data.actualizado is timestamp
                            && request.resource.data.expiraEn is timestamp;
      allow delete: if esAdmin();
    }

    // ---------- Resumen público de alertas (publico/alertasRecientes) ----------
    // Las ~30 alertas abiertas más recientes con SOLO pieza, vehículo, estado y fechas (nunca el
    // WhatsApp del cliente). No se lee desde el navegador: lo escriben el usuario de servicio (al
    // crear una alerta) y el admin (al cerrar, cancelar, reabrir o borrar), y lo lee el servidor
    // para /api/alertas-recientes y /api/pedidos-abiertos, que filtran por estado.
    match /publico/{docId} {
      allow read: if esServicio() || esAdmin();
      allow create, update: if (esServicio() || esAdmin())
                            && docId == 'alertasRecientes'
                            && request.resource.data.keys().hasOnly(['alertas', 'actualizadoAt'])
                            && request.resource.data.alertas is list
                            && request.resource.data.alertas.size() <= 30
                            && request.resource.data.actualizadoAt == request.time;
      allow delete: if esAdmin();
    }

    // ---------- Avisos en el dispositivo (notificaciones push) ----------
    // dispositivosPush/{yonkeId}_{sha256 del token}: un documento por dispositivo del yonke (puede
    // tener varios). Solo el dueño del yonke lo crea, lo lee y lo borra; el usuario de servicio lo
    // lee (para enviar) y lo borra (cuando Firebase rechaza el token); el admin lo lee y lo borra
    // (borrado en cascada). Nadie más. No depende de los términos ni del plan: los avisos son
    // parte de la sección de pedidos del plan Básico.
    match /dispositivosPush/{docId} {
      function dispositivoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['yonkeId', 'token', 'creadoAt'])
          && d.yonkeId is string && d.yonkeId.size() > 0 && d.yonkeId.size() <= 128
          && d.token is string && d.token.size() > 0 && d.token.size() <= 4096
          && d.creadoAt == request.time
          && docId.matches(d.yonkeId + '_[0-9a-f]{64}');
      }
      allow read, delete: if esAdmin() || esServicio() || esDuenoDelYonke(resource.data.yonkeId);
      allow create: if esDuenoDelYonke(request.resource.data.yonkeId) && dispositivoValido();
      // Volver a activar en el mismo dispositivo (Firebase puede renovar el token): mismo dueño.
      allow update: if esDuenoDelYonke(resource.data.yonkeId)
                    && request.resource.data.yonkeId == resource.data.yonkeId
                    && dispositivoValido();
    }

    // ---------- Yonkes e inventario ----------
    match /yonkes/{yonkeId} {
      // Aceptación de términos (registro o aviso ACEPTO): versión vigente, hora del servidor y su
      // entrada del historial (aceptaciones/{versión}) en el mismo guardado.
      function aceptacionVigenteEnEsteGuardado() {
        return exists(terminosYonkesRef())
          && request.resource.data.aceptacionLegal.keys().hasOnly(['version', 'fecha'])
          && request.resource.data.aceptacionLegal.version == get(terminosYonkesRef()).data.version
          && request.resource.data.aceptacionLegal.fecha == request.time
          && existsAfter(/databases/$(database)/documents/yonkes/$(yonkeId)/aceptaciones/$(request.resource.data.aceptacionLegal.version));
      }
      // Página propia (promociones, "sobre nosotros", color y fondo) y datos fiscales de reciclaje:
      // cambios del plan Premium. El logo (branding.logoUrl) es del plan Básico.
      function brandingDe(datos) {
        return datos.get('branding', null) is map ? datos.branding : {};
      }
      function cambiaAlgoPremium() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['promoImagenes', 'sitio', 'fiscalReciclaje'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['branding'])
              && brandingDe(request.resource.data).diff(brandingDe(resource.data)).affectedKeys()
                   .difference(['logoUrl'].toSet()).size() > 0);
      }
      allow read: if true;
      // Alta: admin, o un usuario que se registra y queda como dueño (ownerUid = su uid).
      // Un usuario que ya tiene cuenta de rol (yonke o taller) no puede crear yonkes nuevos.
      allow create: if esAdmin()
                    || (request.auth != null
                        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                        && request.resource.data.ownerUid == request.auth.uid
                        // se registra solo como básico y sin fecha de Premium (eso lo pone el admin)
                        && request.resource.data.get('plan', 'freemium') == 'freemium'
                        && !('premiumHasta' in request.resource.data)
                        // con config/terminosYonkes, se registra aceptando la versión vigente
                        && (!exists(terminosYonkesRef()) || aceptacionVigenteEnEsteGuardado()));
      allow update: if esAdmin()
                    || (esDuenoDelYonke(yonkeId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['verificado', 'entregaInmediata', 'capturaADomicilio', 'ultimaVisitaCaptura', 'subdominio', 'subdominioActivo', 'enviosNacionales', 'ownerUid', 'plan', 'premiumHasta'])
                        // si cambia promoImagenes, debe ser válido
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['promoImagenes'])
                            || promosValidas(request.resource.data.get('promoImagenes', []), yonkeId))
                        // si cambia sitio, debe ser válido
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sitio'])
                            || sitioValido(request.resource.data.get('sitio', {}), yonkeId))
                        // interruptor "Ver también alertas de otros estados con envío": solo true/false
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verAlertasOtrosEstados'])
                            || request.resource.data.verAlertasOtrosEstados is bool)
                        // NUEVO: si cambia branding, el fondo debe ser válido
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['branding'])
                            || brandingValido(request.resource.data.get('branding', null), yonkeId))
                        // Términos: sin la versión vigente solo se permite la marca automática de
                        // actividad y aceptar los términos; aceptacionLegal solo cambia al aceptar.
                        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaActividadAt'])
                            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aceptacionLegal'])
                                && aceptacionVigenteEnEsteGuardado())
                            || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['aceptacionLegal'])
                                && terminosYonkesVigentes(resource.data)))
                        // Plan: con límites activos, lo de la página propia y lo fiscal pide Premium vigente
                        && (premiumSiHaceFalta(resource.data) || !cambiaAlgoPremium()));
      // Dueño que se registró: puede borrar su yonke solo mientras su usuario no exista (rollback)
      allow delete: if esAdmin()
                    || (request.auth != null
                        && resource.data.ownerUid == request.auth.uid
                        && !exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)));
      // Historial de aceptaciones: una entrada por versión, escrita junto con aceptacionLegal (misma
      // versión y misma hora del servidor). Nadie la modifica; solo el admin la borra.
      match /aceptaciones/{version} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow create: if request.auth != null
                      && (esDuenoDelYonke(yonkeId)
                          || getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.ownerUid == request.auth.uid)
                      && request.resource.data.keys().hasOnly(['version', 'fecha'])
                      && request.resource.data.version == version
                      && request.resource.data.fecha == request.time
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.aceptacionLegal.version == version
                      && getAfter(/databases/$(database)/documents/yonkes/$(yonkeId)).data.aceptacionLegal.fecha == request.time
                      && (!exists(terminosYonkesRef()) || version == get(terminosYonkesRef()).data.version);
        allow update: if false;
        allow delete: if esAdmin();
      }
      // Inventario, reciclaje y notas de garantía: el dueño escribe solo con términos vigentes.
      match /vehiculos/{vehiculoId} {
        allow read: if true;
        allow create, delete: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
        allow update: if esAdmin()
                      || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && (
                            // no se toca vendidoAt (incluye vehículos que nunca lo tuvieron)
                            request.resource.data.get('vendidoAt', null) == resource.data.get('vendidoAt', null)
                            // reactivar: el campo se elimina
                            || !('vendidoAt' in request.resource.data)
                            // sacar del inventario: debe ser la hora del servidor
                            || request.resource.data.vendidoAt == request.time
                         ));
        match /piezas/{piezaId} {
          allow read: if true;
          allow write: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
        }
      }
      match /motores/{motorId} {
        allow read: if true;
        allow write: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
      }
      match /piezasSueltas/{piezaId} {
        allow read: if true;
        allow write: if esAdmin() || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId));
      }
      match /materialesReciclaje/{materialId} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow write: if esAdmin()
                     || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && yonkeConPremiumSiHaceFalta(yonkeId));
      }
      match /comprasReciclaje/{compraId} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow write: if esAdmin()
                     || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && yonkeConPremiumSiHaceFalta(yonkeId));
      }
      match /notasGarantia/{notaId} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow write: if esAdmin()
                     || (esDuenoDelYonke(yonkeId) && yonkeConTerminosVigentes(yonkeId) && yonkeConPremiumSiHaceFalta(yonkeId));
      }
      // ---------- Vehículos completos de las alertas (yonkes/{id}/vehiculosAlerta) ----------
      // Lectura pública (el buscador no tiene sesión), igual que vehiculos; sin datos del cliente.
      // Solo el dueño del yonke escribe (sin exigir términos, igual que responder alertas). Dar de
      // alta y renovar piden la bandera inventarioVehiculos; marcar vendida y quitar no (para que
      // siempre pueda limpiar su inventario). El vencimiento es "hoy + 30 días" con ±1 día de
      // holgura por el reloj del celular. unidades (sin el campo = 1) y ventasPiezas (conteo de
      // ventas por pieza) son opcionales: los registros de antes no los traen.
      match /vehiculosAlerta/{vehiculoId} {
        function vehiculoAlertaValido(d) {
          return d.keys().hasOnly(['yonkeId', 'marca', 'modelo', 'ano', 'unidades', 'ventasPiezas', 'piezasAlerta', 'piezasVendidas', 'creadoAt', 'venceEn', 'estado', 'renovadoAt'])
            && d.keys().hasAll(['yonkeId', 'marca', 'modelo', 'ano', 'piezasAlerta', 'piezasVendidas', 'creadoAt', 'venceEn', 'estado'])
            && d.yonkeId == yonkeId
            && d.marca is string && d.marca.size() >= 1 && d.marca.size() <= 60
            && d.modelo is string && d.modelo.size() >= 1 && d.modelo.size() <= 60
            && d.ano is int && d.ano >= 1950 && d.ano <= 2100
            && d.piezasAlerta is list && d.piezasAlerta.size() <= 100
            && d.piezasVendidas is list && d.piezasVendidas.size() <= 100
            && (!('unidades' in d) || (d.unidades is int && d.unidades >= 1 && d.unidades <= 100))
            && (!('ventasPiezas' in d) || (d.ventasPiezas is map && d.ventasPiezas.size() <= 100))
            && d.creadoAt is timestamp
            && d.venceEn is timestamp
            && d.estado == 'activo';
        }
        function venceEn30Dias(d) {
          return d.venceEn - request.time >= duration.value(29, 'd')
            && d.venceEn - request.time <= duration.value(31, 'd');
        }
        function unidadesAntes() {
          return resource.data.get('unidades', 1);
        }
        function sinCambiosDeIdentidad() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['yonkeId', 'marca', 'modelo', 'ano', 'creadoAt']);
        }
        allow read: if true;
        allow create: if esDuenoDelYonke(yonkeId)
                      && inventarioVehiculosHabilitado()
                      && vehiculoAlertaValido(request.resource.data)
                      && !('renovadoAt' in request.resource.data)
                      && request.resource.data.creadoAt == request.time
                      && venceEn30Dias(request.resource.data)
                      && request.resource.data.piezasVendidas.size() == 0
                      && request.resource.data.piezasAlerta.size() <= 1
                      && request.resource.data.get('unidades', 1) == 1
                      && request.resource.data.get('ventasPiezas', {}).size() == 0;
        allow update: if esDuenoDelYonke(yonkeId)
                      && vehiculoAlertaValido(request.resource.data)
                      && sinCambiosDeIdentidad()
                      && (
                        // "Ya lo vendí", "Deshacer" o pieza descontada por una alerta: solo las piezas.
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['piezasVendidas', 'piezasAlerta', 'ventasPiezas'])
                        // Renovar uno vencido (dijo "Sí" a "¿Tienes el vehículo completo?"): 30 días
                        // desde hoy, 1 unidad y las piezas vendidas en cero.
                        || (inventarioVehiculosHabilitado()
                            && resource.data.venceEn <= request.time
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['venceEn', 'estado', 'unidades', 'ventasPiezas', 'piezasVendidas', 'piezasAlerta', 'renovadoAt'])
                            && venceEn30Dias(request.resource.data)
                            && request.resource.data.piezasVendidas.size() == 0
                            && request.resource.data.get('unidades', 1) == 1
                            && request.resource.data.get('ventasPiezas', {}).size() == 0
                            && request.resource.data.renovadoAt == request.time)
                        // "+1 / Tengo otro igual" (vigente): una unidad más y 30 días desde hoy. Puede
                        // contar en el mismo guardado la venta de la alerta.
                        || (inventarioVehiculosHabilitado()
                            && resource.data.venceEn > request.time
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unidades', 'venceEn', 'renovadoAt', 'ventasPiezas', 'piezasVendidas', 'piezasAlerta'])
                            && request.resource.data.get('unidades', 1) == unidadesAntes() + 1
                            && venceEn30Dias(request.resource.data)
                            && request.resource.data.renovadoAt == request.time)
                        // "−1": una unidad menos, nunca menos de 1 (que no baje de las ventas ya
                        // marcadas lo revisa la app: las reglas no pueden recorrer el conteo).
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unidades', 'ventasPiezas', 'piezasVendidas', 'piezasAlerta'])
                            && request.resource.data.get('unidades', 1) == unidadesAntes() - 1)
                        // "Sigo manteniendo mis vehículos" (Premium vigente): solo los vigentes, solo
                        // la fecha; no toca las piezas vendidas.
                        || (inventarioVehiculosHabilitado()
                            && resource.data.venceEn > request.time
                            && premiumVigente(get(/databases/$(database)/documents/yonkes/$(yonkeId)).data)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['venceEn', 'renovadoAt'])
                            && venceEn30Dias(request.resource.data)
                            && request.resource.data.renovadoAt == request.time)
                      );
        allow update, delete: if esAdmin();
        allow delete: if esDuenoDelYonke(yonkeId);
      }
      // Contador de respuestas a alertas por día de Tijuana (límite del plan Básico). Solo sube de
      // 1 en 1 y nadie lo baja ni lo borra (salvo el admin), así el yonke no puede reiniciarlo.
      match /respuestasDiarias/{dia} {
        allow read: if esAdmin() || esDuenoDelYonke(yonkeId);
        allow create: if esDuenoDelYonke(yonkeId)
                      && diaTijuanaValido(dia)
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == 1;
        allow update: if esDuenoDelYonke(yonkeId)
                      && diaTijuanaValido(dia)
                      && request.resource.data.keys().hasOnly(['count'])
                      && request.resource.data.count == resource.data.count + 1;
        allow delete: if esAdmin();
      }
      // Datos privados del yonke (hoy: privado/contacto con su correo, ver src/lib/contactoPrivado.js).
      // Solo el admin los lee y escribe. (Los privado/contacto de pedidosClientes y solicitudesPiezas
      // son otras rutas, con sus propias reglas.)
      match /privado/{docId} {
        allow read, write: if esAdmin();
      }
      // ---------- NUEVO: contador de toques al botón de WhatsApp ----------
      match /contactosVehiculo/{docId} {
        allow read: if false;
        allow create: if request.resource.data.keys().hasOnly(['clics'])
                     && request.resource.data.clics == 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clics'])
                     && request.resource.data.clics == resource.data.clics + 1;
        allow delete: if esAdmin();
      }
    }
    // ---------- Operación ----------
    // Reservaciones: traen nombre y teléfono del cliente, así que solo las leen el admin y el yonke
    // dueño (antes la lectura era pública). Crear sigue abierto: el cliente reserva sin cuenta
    // desde la página principal y desde los subdominios (HomeClient.js, TenantPageClient.js) y
    // nunca vuelve a leer la reservación. El panel del yonke consulta con where('yonkeId', '==', ...)
    // -- sin ese filtro la consulta se rechaza entera.
    match /reservaciones/{reservaId} {
      allow read: if esAdmin() || esDuenoDelYonke(resource.data.yonkeId);
      allow create: if true;
      allow update: if esAdmin() || esDuenoDelYonke(resource.data.yonkeId);
      allow delete: if esAdmin();
    }
    // Ventas: traen el nombre del cliente y el monto, así que solo las leen el admin y el yonke
    // dueño (igual que reservaciones). /calificar usa ventasPublicas/{folio}. El panel del yonke
    // consulta con where('yonkeId', '==', ...) -- sin ese filtro la consulta se rechaza entera.
    match /ventas/{ventaId} {
      // Venta que genera confirmar una reservación pendiente de este mismo yonke: se permite aun
      // sin términos vigentes (atender reservaciones nunca se bloquea). La venta manual no.
      function ventaDeReservacion() {
        return request.resource.data.get('reservaId', null) is string
          && !('origen' in request.resource.data)
          && get(/databases/$(database)/documents/reservaciones/$(request.resource.data.reservaId)).data.yonkeId == request.resource.data.yonkeId
          && get(/databases/$(database)/documents/reservaciones/$(request.resource.data.reservaId)).data.estado == 'pendiente';
      }
      allow read: if esAdmin() || esDuenoDelYonke(resource.data.yonkeId);
      // Venta manual (sin reservación): términos vigentes y, con límites activos, Premium vigente.
      // La venta que genera confirmar una reservación sigue permitida en el plan Básico.
      allow create: if esAdmin()
                    || (esDuenoDelYonke(request.resource.data.yonkeId)
                        && (ventaDeReservacion()
                            || (yonkeConTerminosVigentes(request.resource.data.yonkeId)
                                && yonkeConPremiumSiHaceFalta(request.resource.data.yonkeId))));
      // CAMBIO: el dueño solo puede cancelar (cancelada + canceladaAt), sin borrar.
      // Sin términos vigentes solo cancela ventas que vienen de una reservación.
      allow update: if esAdmin()
                    || (esDuenoDelYonke(resource.data.yonkeId)
                        && (resource.data.get('reservaId', null) is string || yonkeConTerminosVigentes(resource.data.yonkeId))
                        && resource.data.get('cancelada', false) != true
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['cancelada', 'canceladaAt'])
                        && request.resource.data.cancelada == true
                        && request.resource.data.canceladaAt == request.time);
      allow delete: if esAdmin();
    }
    // ventasPublicas/{folio}: copia MÍNIMA y sin datos personales de una venta, para que /calificar
    // (sin sesión) encuentre el pedido por su folio sin leer `ventas` (ver src/lib/ventasPublicas.ts).
    // Cualquiera lee UNA copia si conoce el folio (get); nadie lista la colección salvo el admin.
    // Crea la copia el yonke dueño, junto con su venta (misma venta, mismo yonke, mismo folio), o el
    // admin (botón "Copiar ventas a públicas"). Solo el admin la cambia o la borra.
    match /ventasPublicas/{folio} {
      function copiaSinDatosPersonales() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ventaId', 'yonkeId', 'piezaVendida', 'vehiculo'])
          && d.keys().hasAll(['ventaId', 'yonkeId'])
          && d.ventaId is string && d.ventaId.size() > 0
          && d.yonkeId is string && d.yonkeId.size() > 0
          && (d.get('piezaVendida', null) == null || (d.piezaVendida is string && d.piezaVendida.size() <= 300))
          && (d.get('vehiculo', null) == null
              || (d.vehiculo is map && d.vehiculo.keys().hasOnly(['marca', 'modelo', 'ano'])));
      }
      // La venta original (ya guardada o en el mismo lote) es de ese yonke y su folio normalizado
      // (trim + mayúsculas + "/" por "-", igual que idVentaPublica) es el id de la copia.
      function coincideConSuVenta() {
        let v = getAfter(/databases/$(database)/documents/ventas/$(request.resource.data.ventaId)).data;
        return v.yonkeId == request.resource.data.yonkeId
          && folio == v.numeroPedido.trim().upper().replace('/', '-');
      }
      allow get: if true;
      allow list: if esAdmin();
      // El admin copia en lotes de hasta 400: sin leer cada venta (cada lectura cuenta para el
      // límite de lecturas de las reglas), solo con la forma de la copia.
      allow create: if (esAdmin() && copiaSinDatosPersonales())
                    || (esDuenoDelYonke(request.resource.data.yonkeId) && copiaSinDatosPersonales() && coincideConSuVenta());
      allow update: if esAdmin() && copiaSinDatosPersonales();
      allow delete: if esAdmin();
    }
    match /calificaciones/{calificacionId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if esAdmin();
    }
    match /resenasPlataforma/{resenaId} {
      // Públicas solo las aprobadas (la página principal consulta where('aprobada', '==', true));
      // el admin las lee todas para moderarlas.
      allow read: if resource.data.get('aprobada', false) == true || esAdmin();
      allow create: if true;
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }
  }
}
