# Copia este archivo a .env.local y llena los valores reales (nunca commitees .env.local —
# .gitignore ya lo excluye). Ver README para instrucciones completas de cómo levantar el
# entorno de desarrollo.

# --- Firebase ---
# Config del proyecto de Firebase de DESARROLLO (no el de producción). La sacas de:
# Firebase Console > tu proyecto de dev > ⚙️ Configuración del proyecto > tus apps > SDK setup.
# Estos valores NO son secretos (Firebase los expone en el bundle del navegador por diseño),
# pero igual deben apuntar siempre a tu proyecto de DESARROLLO aquí, nunca al de producción.
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key-de-dev-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# --- CallMeBot (aviso de WhatsApp al admin) ---
# Déjalas vacías/sin definir en desarrollo si no quieres recibir avisos de WhatsApp de pruebas
# — notificarAdmin.js no truena si faltan, solo no manda el mensaje.
CALLMEBOT_ADMIN_PHONE=
CALLMEBOT_APIKEY=
